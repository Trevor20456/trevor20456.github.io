scope":"row","children":"The learning goal and directions are clear, brief, and broken into manageable steps."}],["$","td",null,{"children":"Ready"}],["$","td",null,{"children":"No additional note."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Text is easy to read: useful font size, spacing, and strong color contrast."}],["$","td",null,{"children":"Ready"}],["$","td",null,{"children":"No additional note."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Headings and layout are consistent, uncluttered, and easy to scan."}],["$","td",null,{"children":"Ready"}],["$","td",null,{"children":"No additional note."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Important information appears as selectable text, not only inside an image."}],["$","td",null,{"children":"Revise"}],["$","td",null,{"children":"Directions were not selectable."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Meaningful images have a short description or alt text when needed."}],["$","td",null,{"children":"Revise"}],["$","td",null,{"children":"One image needed alt text."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Video or audio includes accurate captions or a usable transcript."}],["$","td",null,{"children":"Not applicable"}],["$","td",null,{"children":"No audio or video."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Links have descriptive names, work correctly, and open the intended resource."}],["$","td",null,{"children":"Ready"}],["$","td",null,{"children":"No additional note."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Meaning is not communicated by color, sound, or position alone."}],["$","td",null,{"children":"Ready"}],["$","td",null,{"children":"No additional note."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Students can use helpful access tools such as zoom, keyboard navigation, read-aloud, or voice typing."}],["$","td",null,{"children":"Revise"}],["$","td",null,{"children":"Image-only text blocked read-aloud."}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"The material protects privacy and does not display unnecessary student or personal information."}],["$","td",null,{"children":"Ready"}],["$","td",null,{"children":"No additional note."}]]}]]}]]}]}],["$","p",null,{"children":[["$","strong",null,{"children":"Agreed change:"}]," Replace image-only directions with selectable text, numbered steps, and a brief example."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Why it matters:"}]," Students can enlarge, select, or use text-to-speech with the directions and follow the steps more easily."]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"implementation-record","children":[["$","h2",null,{"id":"implementation-record","children":"Implementation and Evidence Record"}],["$","p",null,{"children":[["$","strong",null,{"children":"Implementation:"}]," During Week 2, I met with a secondary English teacher for about 15 minutes and used the checklist to review a Google Slides lesson."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Change made:"}]," The educator replaced image-only directions with selectable text, numbered steps, and a short example."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Effect on the educator:"}]," The educator recognized that image-based text can block text selection and read-aloud tools and planned to reuse the check."]}],["$","p",null,{"children":[["$","strong",null,{"children":"Evidence recorded:"}]," Completed checklist, revised slide, before-and-after description, and colleague feedback."]}],["$","h3",null,{"children":"Educator Feedback"}],["$","dl",null,{"children":[["$","dt",null,{"children":"What part of the checklist was most useful or made you notice something new?"}],["$","dd",null,{"children":"The selectable-text check revealed that directions inside an image could not be read aloud."}],["$","dt",null,{"children":"What change will you make, or what did you change, because of this review?"}],["$","dd",null,{"children":"Replaced image-only directions with selectable text, numbered steps, and an example."}],["$","dt",null,{"children":"Would this tool be useful again? Why or why not?"}],["$","dd",null,{"children":"Yes. The short format fit normal lesson planning."}]]}],["$","h3",null,{"children":"How It Supports Standard 4.1"}],["$","p",null,{"children":[["$","strong",null,{"children":"4.1.b:"}]," The review helps a colleague notice and reduce barriers in digital content and learning tools."]}],["$","p",null,{"children":[["$","strong",null,{"children":"4.1.c:"}]," The short, non-evaluative conversation supports collaborative learning and improvement."]}],["$","p",null,{"children":"I did not collect student-performance data, so this record does not claim improved student achievement."}],["$","div",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"text-link","href":"/standards/4-1/","children":"Return to Standard 4.1: Change Agent","aria-current":"$undefined"}],["$","a",null,{"className":"text-link","href":"/artifacts/accessible-design-story-series/","children":"View the Accessible Design Story Series"}]]}]]}]]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":"ISTE Coach Standards"}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":"CSUF Educational Technology"}]]}]]}]]}]
