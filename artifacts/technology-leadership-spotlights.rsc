["$","p",null,{"className":"eyebrow","children":"Standard 4.1.d Artifact"}],["$","h1",null,{"children":"Trona High School Technology Recognition Plan"}],["$","div",null,{"className":"page-lede","children":["$","p",null,{"children":"A voluntary process for recognizing technology use that strengthens teaching and learning."}]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"recognition-process","children":[["$","h2",null,{"id":"recognition-process","children":"The Recognition Process"}],["$","figure",null,{"className":"portfolio-evidence","children":[["$","a",null,{"href":"/artifacts/standard41-recognition-plan.png","children":["$","img",null,{"src":"/artifacts/standard41-recognition-plan.png","alt":"Four-step Technology Recognition Plan. All steps are provided as selectable text below.","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Trona High School Technology Recognition Plan."}]]}],["$","div",null,{"className":"spotlight-grid plan-grid","children":[["$","article",null,{"children":[["$","span",null,{"className":"spotlight-number","children":"01"}],["$","h3",null,{"children":"Observe and Listen"}],["$","p",null,{"children":"Learn what is already working through school routines, conversations, and examples educators choose to share."}]]}],["$","article",null,{"children":[["$","span",null,{"className":"spotlight-number","children":"02"}],["$","h3",null,{"children":"Invite and Confirm"}],["$","p",null,{"children":"Invite voluntary examples or nominations. Ask the educator to verify the description and learning purpose. Obtain permission before publication."}]]}],["$","article",null,{"children":[["$","span",null,{"className":"spotlight-number","children":"03"}],["$","h3",null,{"children":"Celebrate and Share"}],["$","p",null,{"children":"Explain the practice, why it matters for learning, and one idea another educator could adapt."}]]}],["$","article",null,{"children":[["$","span",null,{"className":"spotlight-number","children":"04"}],["$","h3",null,{"children":"Look for High-Impact Practice"}],["$","p",null,{"children":"Focus on learning, equitable access, inquiry, feedback, collaboration, student agency, and colleague leadership."}]]}]]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"recognition-record","children":[["$","h2",null,{"id":"recognition-record","children":"Completed Recognition Cycle"}],["$","p",null,{"children":"During the first week of September 2026, I completed one recognition cycle with a willing Trona colleague."}],["$","p",null,{"children":"I used the plan to recognize how a colleague organized directions, examples, feedback, and makeup work in Google Classroom. I asked how the routine supported students and wrote a short spotlight about access and independence."}],["$","p",null,{"children":"The educator checked and approved the spotlight before I shared it with two other Trona teachers. I removed names and student information from the portfolio evidence."}],["$","h3",null,{"children":"Impact and Follow-Up"}],["$","p",null,{"children":"The spotlight gave teachers a quick way to learn from one another. One teacher asked how the materials were organized and used the same approach in an upcoming assignment with consistent headings, posted examples, and clearer directions."}],["$","p",null,{"children":"This shows emerging competence with 4.1.d because I found an effective practice, confirmed it with the educator, and shared it in a way that influenced another teacher."}],["$","p",null,{"children":[["$","strong",null,{"children":"Impact evidence (names removed):"}]," The educator reviewed and approved the spotlight. I shared it with two Trona teachers, and follow-up notes show that one teacher used consistent headings, posted examples, and clearer directions."]}],["$","a",null,{"className":"text-link","href":"/standards/4-1/","children":"Return to Standard 4.1: Change Agent","aria-current":"$undefined"}]]}]]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":"ISTE Coach Standards"}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":"CSUF Educational Technology"}]]}]]}]]}]
