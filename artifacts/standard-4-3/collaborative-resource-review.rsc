/4-3/","children":["← Back to Standard 4.3: Collaborator"]}]]}],["$","header",null,{"className":"page-intro","children":[["$","p",null,{"className":"eyebrow","children":["Standard 4.3 · Artifact Two"]}],["$","h1",null,{"children":["Collaborative Digital Resource Review and Coaching Guide"]}],["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["Trevor Arcadipane · September 2026"]}]]}]]}],["$","div",null,{"className":"review-note","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["Collaborative Resource Review and Coaching Guide · ISTE Coach Standard 4.3"]}],"\n  ",["$","p",null,{"children":["Use this reusable guide with an educator to select, try, and review one instructional change. Move from the educator’s priorities to a shared decision, personalized support, and a review of learning evidence."]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"guide-listen","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"guide-listen","children":["1. Listen and agree on a goal"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Begin with the educator’s priorities. Ask what already works, what feels difficult, and what support would be useful. Agree that experimentation and honest feedback are welcome."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Course, grade, and lesson:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Educator’s goal, in their words:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Current approach and obstacle:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Student learning goal and observable success:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Time, confidence, and preferred support:"]}]," ______________________________"]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"guide-review","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"guide-review","children":["2. Review two candidates together"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Examine a sample task in each resource and compare it with the existing approach. Mark each criterion ",["$","strong",null,{"children":["meets / needs adaptation / does not meet / unknown"]}],"; record specific evidence."]}],"\n    ",["$","ul",null,{"children":["\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["Learning:"]}]," Alignment to the goal, quality of thinking, accurate content, and useful feedback."]}],"\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["Culture and relevance:"]}]," Credible sources, varied perspectives, respectful representation, and connections to students’ interests, communities, and aspirations. Ask whose perspective is missing."]}],"\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["Development and access:"]}]," Reading demand, age suitability, navigation, captions, keyboard access, and appropriate language or reading supports."]}],"\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["Feasibility:"]}]," Preparation time, Chromebook access, account requirements, cost, licensing, and school approval requirements. Check data practices before any trial."]}],"\n    "]}],"\n    ",["$","div",null,{"className":"portfolio-table-wrap","children":["\n      ",["$","table",null,{"children":["\n        ",["$","caption",null,{"children":["Joint comparison notes"]}],"\n        ",["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["Approach"]}],["$","th",null,{"scope":"col","children":["Evidence of fit"]}],["$","th",null,{"scope":"col","children":["Gaps or questions"]}]]}]]}],"\n        ",["$","tbody",null,{"children":["\n          ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Existing: __________"]}],["$","td",null,{"children":["________________"]}],["$","td",null,{"children":["________________"]}]]}],"\n          ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Candidate A: __________"]}],["$","td",null,{"children":["________________"]}],["$","td",null,{"children":["________________"]}]]}],"\n          ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Candidate B: __________"]}],["$","td",null,{"children":["________________"]}],["$","td",null,{"children":["________________"]}]]}],"\n        "]}],"\n      "]}],"\n    "]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Student interests or aspirations informing our choice:"]}]," ______________________________"]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"guide-decide","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"guide-decide","children":["3. Agree on a trial and decision rule"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Joint decision:"]}]," Keep existing approach / Adapt / Trial A / Trial B / Gather more information"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Reason and unresolved questions:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Small trial, duration, and evidence to collect:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Continue, revise, or stop if:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Adoption or purchase recommendation, estimated cost, and required approval:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":["A trial informs a recommendation; it does not authorize a purchase or establish effectiveness by itself."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"guide-support","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"guide-support","children":["4. Personalize the support"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Educator chooses:"]}]," Model one part / Co-plan / Guided rehearsal / Independent rehearsal with feedback"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Specific strategy to plan or model and why it fits:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Coach’s role / educator’s role:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Adaptations, preparation, and access backup:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Practice date and educator’s feedback on support:"]}]," ______________________________"]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"guide-follow-up","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"guide-follow-up","children":["5. Follow up and revise together"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Follow-up date:"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Educator change:"]}]," What changed in planning, instruction, or confidence? Compare the original and revised task. ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Student evidence:"]}]," What do anonymized work samples or aggregate results show about the agreed learning goal? ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Limitations and next decision:"]}]," Continue / Adapt / Stop / Review further. Why? ______________________________"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["How should the coach adjust their support?"]}]," ______________________________"]}],"\n    ",["$","p",null,{"children":["Keep identifying student information out of this guide and any public portfolio. Obtain the educator’s agreement before sharing their feedback or work."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"guide-example","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"guide-example","children":["Illustrative example: Comparing historical perspectives"]}],["$","p",null,{"children":["This hypothetical example demonstrates how to use the guide; it is not a report of a completed coaching session or measured outcomes."]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Goal and context:"]}]," An educator wants to determine whether students can explain how an author’s position shapes a historical account. The existing task asks students to summarize two brief accounts of industrialization, one from a factory owner and one from a worker. The coach and educator agree that success means making a comparison supported by one detail from each source."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Compare and adapt:"]}]," Candidate A is a short digital quiz that asks students to select evidence and explain their choice. Candidate B is a shared annotation task followed by an individual comparison. Together, they examine source credibility, whose experiences are represented, reading demands, and whether each format makes individual understanding visible. They add brief vocabulary support and source context while preserving the comparison goal. A paper version provides an access backup."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Support and decision:"]}]," The educator chooses guided rehearsal with sample responses. For a one-lesson trial, they would collect anonymized individual comparisons, note access barriers, and record preparation time. They would continue if responses make students’ reasoning clear, adapt if directions obscure the task, or reconsider if the format mostly produces copied summaries. The follow-up question is: What does this evidence help us decide to teach next?"]}],"\n  "]}],"\n"]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Portfolio navigation","children":[["$","a",null,{"href":"/standards/4-3/","children":["← Back to Standard 4.3: Collaborator"]}]]}]]}]]}],"$Lc"]}]
