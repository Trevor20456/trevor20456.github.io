","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}],["$","main",null,{"id":"main-content","className":"standard43","children":[["$","div",null,{"className":"page-wrap","children":[["$","nav",null,{"className":"page-pagination","aria-label":"Portfolio navigation","children":[["$","a",null,{"href":"/standards/4-3/","children":["← Back to Standard 4.3: Collaborator"]}]]}],["$","header",null,{"className":"page-intro","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["Standard 3 · Collaborator · Supporting resource"]}],"\n  ",["$","h1",null,{"children":["Classroom Technology Walkthrough and Teacher Practice Guide"]}],"\n  ",["$","p",null,{"className":"page-lede","children":["A practical sequence for helping a fellow educator learn one classroom technology task through conversation, modeling, and supported practice."]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"purpose-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"purpose-heading","children":["Purpose and example"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Use this guide for a focused coaching conversation about one classroom technology routine. The scenario below illustrates the process; it does not report a completed session or measured results."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Example goal:"]}]," A teacher wants students to find an assignment, understand the directions, and submit a short response in Google Classroom. By the end of a 25–30 minute practice session, the teacher should be able to prepare the task and explain the student workflow in their own words. Another familiar learning platform can serve the same purpose."]}],"\n    ",["$","p",null,{"children":["Prepare a practice space or unpublished example, the sample directions below, and a demonstration account or permitted student-view method if one is available. Use fictional responses during practice."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"conversation-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"conversation-heading","children":["1. Agree on one useful task · 4 minutes"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Begin with, “What would you like students to be able to do, and which part would you like us to practice?” Let the teacher describe their current routine before offering a solution. Confirm the goal: “You already have the reading and question ready. Today we will practice making the assignment clear and checking how students turn it in.”"]}],"\n    ",["$","p",null,{"children":["Ask whether the teacher prefers to watch first, work alongside you, or try independently. Agree on a signal to pause. Keep the teacher in control of their device and decisions; ask before taking over. Treat questions and mistakes as useful information about what to explain next."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"model-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"model-heading","children":["2. Model the workflow · 6 minutes"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Demonstrate preparing one example assignment in the practice space. Think aloud about instructional choices: “I am naming the task clearly so students can recognize it. I am stating the response length so they know what completion looks like.” Add the reading or its location, response directions, and the expected submission method."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Google Classroom example:"]}]," Open the class, choose ",["$","strong",null,{"children":["Classwork → Create → Assignment"]}],", and add a title and instructions. Attach the reading for students to view. If students will write in a Google Doc template, attach it and choose ",["$","strong",null,{"children":["Make a copy for each student"]}],". Save a draft while rehearsing. See ",["$","a",null,{"href":"https://support.google.com/edu/classroom/answer/6020265?co=GENIE.Platform%3DDesktop&hl=en","children":["Google Classroom: Create an assignment"]}],"."]}],"\n    ",["$","p",null,{"children":["Walk through the student experience using an available preview or demonstration. Show where students find the instructions, how they prepare their response, and how they submit it. Then demonstrate how the teacher checks for a submission. If the student view is unavailable, rehearse those steps verbally and identify what must be checked before classroom use."]}],"\n    ",["$","p",null,{"children":["Pause after each stage. Invite the teacher to explain the purpose of the step, rather than memorize your sequence of clicks."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"directions-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"directions-heading","children":["Sample assignment directions"]}],"\n  ",["$","div",null,{"className":"artifact-preview","children":["\n    ",["$","h3",null,{"children":["History quick response: Cause and consequence"]}],"\n    ",["$","ol",null,{"children":["\n      ",["$","li",null,{"children":["Read the short history passage provided with this assignment."]}],"\n      ",["$","li",null,{"children":["Write 3–4 sentences identifying one cause of the event and explaining one consequence."]}],"\n      ",["$","li",null,{"children":["Include one specific detail from the passage to support your explanation."]}],"\n      ",["$","li",null,{"children":["Review your response, then submit it using the method your teacher demonstrated."]}],"\n    "]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Success check:"]}]," Your response identifies a cause, explains a consequence, and uses a relevant passage detail."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"practice-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"practice-heading","children":["3. Let the teacher practice · 10 minutes"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Have the teacher build a similar task using their own subject and learning objective. Ask them to explain their choices while you observe. When they hesitate, first ask, “What are you trying to do next?” Offer a short cue, then a demonstration only if needed. Return control immediately afterward."]}],"\n    ",["$","p",null,{"children":["If the pace feels too fast, repeat just the difficult stage. If the teacher is comfortable, reduce prompts and let them complete the whole workflow. Adjust the support to their preference and performance rather than adding more tools."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"rehearsal-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"rehearsal-heading","children":["4. Rehearse and reflect · 5–10 minutes"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Ask the teacher to lead a final walkthrough. Check together that:"]}],"\n    ",["$","ul",null,{"children":["\n      ",["$","li",null,{"children":["The task title and directions communicate what students will do."]}],"\n      ",["$","li",null,{"children":["The required reading and response location are available."]}],"\n      ",["$","li",null,{"children":["The teacher can explain and demonstrate submission."]}],"\n      ",["$","li",null,{"children":["The teacher knows how to check whether work was received."]}],"\n    "]}],"\n    ",["$","p",null,{"children":["Close with three prompts: “Which step can you now complete independently?” “Where would another example help?” “What will you look for when students try this?” Let the teacher select one next step and whether they want another conversation."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Standard alignment:"]}]," The listening, permission, and shared decisions support respectful coaching relationships in 4.3a. Modeling, teacher practice, and adjustable support provide a planned approach to personalized educator learning in 4.3d."]}],"\n  "]}],"\n"]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Portfolio navigation","children":[["$","a",null,{"href":"/standards/4-3/","children":["← Back to Standard 4.3: Collaborator"]}]]}]]}]]}],"$Lc"]}]
