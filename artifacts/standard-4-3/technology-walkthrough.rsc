1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to main content"}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","$L6",null,{"className":"brand","href":"/","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":"TA"}],["$","span",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","small",null,{"children":"Secondary Social Science · Educational Technology"}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":"Menu"}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}],["$","main",null,{"id":"main-content","className":"standard43","children":[["$","div",null,{"className":"page-wrap","children":[["$","nav",null,{"className":"page-pagination","aria-label":"Portfolio navigation","children":[["$","a",null,{"href":"/standards/4-3/","children":["← Back to Standard 4.3: Collaborator"]}]]}],["$","header",null,{"className":"page-intro","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["Standard 3 · Collaborator · Educator resource"]}],"\n  ",["$","h1",null,{"children":["Collaborative Technology Coaching Cycle"]}],"\n  ",["$","p",null,{"className":"page-lede","children":["A 40-minute planning and practice session, followed by a 15-minute evidence conversation, for helping an educator teach historical reasoning through digital feedback and revision."]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"case-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"case-heading","children":["Illustrative coaching case"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["A history teacher wants students to distinguish evidence from assumptions, explain a source’s perspective, and revise a historical claim after feedback. The lesson pairs Lewis Hine’s photograph of Addie Card with Section 1 of the Keating-Owen Child Labor Act. Students will write individually in Google Docs, respond to focused teacher feedback, and revise. This resource presents a complete proposed coaching process and simulated practice work; it does not report a completed coaching session or classroom results."]}],"\n    ",["$","p",null,{"children":["The instructional challenge is moving students from summarizing sources to examining their purposes and the limits of their evidence. The technology makes an initial response, targeted feedback, and a revision available for joint review. The educator decides whether that contribution justifies using the digital approach."]}],"\n    ",["$","p",null,{"children":["Before the session, review the authentic photograph and legislation in the ",["$","a",null,{"href":"/artifacts/standard-4-3/collaborative-resource-review/","children":["Shared Digital Resource Decision and Lesson Revision Record"]}],". Bring the image, its catalog information, Section 1 and historical context, a response template, and the practice work below. Keep the first response above the revision so both remain visible."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"partnership-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"partnership-heading","children":["1. Establish the partnership · 0–5 minutes"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Ask the educator what students already do successfully and which part of interpreting source evidence needs attention. Invite an example before suggesting a solution. Confirm the teacher’s goal in their language and ask what they want from the session."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Working agreement:"]}]," The educator owns the lesson, operates their device, and can change or decline a suggestion. The coach explains recommendations and asks before demonstrating on the educator’s screen. Both can pause, question, or disagree. The conversation supports learning rather than evaluation. Agree what notes remain private and obtain permission before sharing any educator work or feedback."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Opening prompt:"]}]," “Would it help more to see a feedback example, build the task together, or try it while I observe?” Record the answer as the starting point, then adjust when practice reveals a different need."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"planning-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"planning-heading","children":["2. Co-plan the learning and evidence · 5–13 minutes"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Agree on one learning goal: students will distinguish source evidence from assumptions, explain perspective and purpose, and revise a historical claim after feedback. The photograph and law offer different kinds of evidence, not opposing views. Together, decide which background knowledge and vocabulary require instruction before comparison."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Student task:"]}]," “How do these sources frame child labor as a public concern? Make a claim using a precise detail from the photograph and a provision from the law. Explain their different purposes, separate observation from inference, and identify one missing perspective.”"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Shared success criteria:"]}]," The response makes a defensible claim, uses specific evidence from both sources, explains their different purposes, and identifies something the pair cannot establish. Students distinguish visible image details from catalog information and a law’s intentions from its effects. The educator may adjust response length or scaffolds while preserving that reasoning goal."]}],"\n    ",["$","p",null,{"children":["Agree that teacher feedback will address one reasoning priority first. Students will write a revision and a brief explanation of what they changed. Compare the two versions against the same criteria; completion and longer responses alone will not establish stronger historical reasoning."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"model-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"model-heading","children":["3. Model a feedback decision · 13–21 minutes"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Model reading for the agreed goal before correcting every error. Think aloud: “This response notices child labor and a legal response, but claims more than the sources establish. I will ask the student to examine that inference instead of replacing the paragraph.” Invite the educator to suggest a different priority and explain it."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Practice setup:"]}]," In Google Classroom, create an assignment and attach the response document with an individual copy for each student. Keep the assignment unpublished while rehearsing. See ",["$","a",null,{"href":"https://support.google.com/edu/classroom/answer/6020265?co=GENIE.Platform%3DDesktop&hl=en","children":["Google’s assignment instructions"]}],"."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Feedback routine:"]}]," In Google Docs, select the relevant text and add a comment. Students can reply to explain a revision; the teacher can review the change before resolving the comment. A resolved comment alone does not establish that the reasoning improved. See ",["$","a",null,{"href":"https://support.google.com/docs/answer/65129?co=GENIE.Platform%3DDesktop&hl=en","children":["Google’s commenting instructions"]}],"."]}],"\n  "]}],"\n  ",["$","div",null,{"className":"artifact-preview","children":["\n    ",["$","h3",null,{"children":["Worked feedback example"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Simulation note:"]}]," The sources are authentic; the student work and feedback below are authored examples for rehearsal. The initial response intentionally includes unsupported conclusions. Read the sources and context through the companion record before using the model."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Initial response:"]}]," “Hine’s photograph proves every factory used child workers. The Keating-Owen Act ended child labor, so these sources show that the problem was solved.”"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Actionable teacher comment:"]}]," “You connect child labor with a legal response. What can one photograph establish, and what can a law establish about its intended effects? Use a precise detail from each source to narrow your claim. What further evidence would show whether conditions changed?”"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Stronger revision:"]}]," “These sources frame child labor as a concern for reform and public policy. The photograph shows a child standing in front of rows of spinning machinery. Its catalog identifies Addie Card at the North Pownal Cotton Mill in 1910. Hine’s documentation for the National Child Labor Committee places it in a reform context. Section 1 of the 1916 act restricted interstate shipment of factory goods connected to the employment of children under fourteen. The photograph documents a particular setting; the law states a policy response. Neither establishes conditions in every factory or proves that the policy ended child labor. Addie’s own account and evidence of enforcement would help test a fuller claim.”"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Student revision note:"]}]," “I replaced my claims about every factory and a solved problem with claims the sources can support. I explained their different purposes and named evidence I would still need.”"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Coach and educator review:"]}]," The revision narrows its claim and distinguishes documentary and legislative purposes. It distinguishes a visible detail from the catalog context and uses a specific provision from the act. The act’s 1918 invalidation, explained in the source context, also challenges any claim of a permanent solution."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"practice-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"practice-heading","children":["4. Practice together, then independently · 21–35 minutes"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Guided practice · 7 minutes:"]}]," The educator uses the initial response above to identify one strength and one next step, then writes their own comment. The coach asks whether a student could act on it and whether it leaves the thinking to the learner. Revise vague feedback such as “explain more” into a question about what the source does and does not establish."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Independent practice · 7 minutes:"]}]," Use a second simulated response: “The photograph and law are both about children working.” The educator identifies what is missing, writes feedback without a coach prompt, and describes a successful revision. A useful next step is citing a detail from each source and explaining how documenting a setting differs from prescribing a policy."]}],"\n    ",["$","p",null,{"children":["The coach observes without taking over. Offer a cue only after asking what the educator is trying to accomplish. Finish by discussing the reasoning behind the comment, not whether it matches the coach’s wording."]}],"\n    ",["$","h3",null,{"children":["Two ways to personalize support"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Teacher learning the platform:"]}]," Rehearse one comment-and-reply exchange in a practice document. Separate the technical step from the feedback decision, allow repetition, and leave a short reminder. Reduce help when the teacher can perform the routine and explain its purpose."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Teacher comfortable with the platform:"]}]," Minimize technical demonstration. Compare two possible comments, discuss which better prompts reasoning, and calibrate judgments using the success criteria. Offer joint planning or another example if that would be more useful."]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"action-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"action-heading","children":["5. Agree on the classroom trial · 35–40 minutes"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["The educator chooses whether to proceed, adapt the task, or rehearse again. Before a trial, verify source suitability and student access. Retain a paper response-and-feedback option if the digital workflow interferes with the learning goal."]}],"\n    ",["$","div",null,{"className":"portfolio-table-wrap","children":["\n      ",["$","table",null,{"children":["\n        ",["$","caption",null,{"children":["Illustrative action record"]}],"\n        ",["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["Responsibility"]}],["$","th",null,{"scope":"col","children":["Agreed action"]}]]}]]}],"\n        ",["$","tbody",null,{"children":["\n          ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Educator"]}],["$","td",null,{"children":["Select the lesson, finalize the sources and prompt, teach the task, and retain initial responses, feedback, and revisions."]}]]}],"\n          ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Coach"]}],["$","td",null,{"children":["Provide the practiced model, be available for the agreed support, and prepare the evidence-review questions."]}]]}],"\n          ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Together"]}],["$","td",null,{"children":["Arrange a 15-minute conversation after the lesson and select a small anonymized set showing stronger, partial, and limited revisions."]}]]}],"\n        "]}],"\n      "]}],"\n    "]}],"\n  "]}],"\n"]}],"\n\n",["$","section",null,{"className":"content-section","aria-labelledby":"followup-heading","children":["\n  ",["$","h2",null,{"className":"section-heading","id":"followup-heading","children":["6. Review evidence and revise together · 15 minutes"]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Minutes 0–3:"]}]," Let the educator describe what surprised them, where students struggled, and whether the support fit. Ask what they would keep before offering your interpretation."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Minutes 3–10:"]}]," Compare initial and revised work against the shared criteria. If students add details without explaining purpose, plan a source-comparison model. If they confuse a law’s intention with its effects, model the additional evidence needed. If they misread a provision, revisit its language and context. If they cannot find or respond to feedback, address the workflow separately. These possibilities guide diagnosis; they are not reported findings."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Minutes 10–15:"]}]," Agree on one instructional revision and one support adjustment. The educator chooses the next action; the coach confirms the assistance requested. Record the evidence considered, decision, responsibility, and next check-in. A small sample can guide teaching, but cannot establish that the technology caused improvement."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Standard alignment:"]}]," Shared decisions and follow-through support 4.3a. Responsive planning, modeling, practice, and review support 4.3d. The companion resource-selection guide develops the joint content and technology judgments in 4.3b and 4.3c."]}],"\n  "]}],"\n"]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Portfolio navigation","children":[["$","a",null,{"href":"/standards/4-3/","children":["← Back to Standard 4.3: Collaborator"]}]]}]]}]]}],"$Lc"]}]
c:["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":"ISTE Coach Standards"}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":"CSUF Educational Technology"}]]}]]}]
