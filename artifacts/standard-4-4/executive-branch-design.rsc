,["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","aria-current":"page","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}],["$","main",null,{"id":"main-content","className":"standard44","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":[["$","p",null,{"className":"eyebrow","children":["Standard 4.4 · Artifact One"]}],["$","h1",null,{"children":["Executive Branch Digital Inquiry"]}],["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["A classroom project and educator design guide for building a civic argument with evidence."]}]]}]]}],"\n",["$","nav",null,{"className":"section-jump","aria-label":"On this page","children":[["$","a",null,{"href":"#student-task","children":["Student task"]}],["$","a",null,{"href":"#design-alignment","children":["Design decisions"]}],["$","a",null,{"href":"#access","children":["Access and participation"]}],["$","a",null,{"href":"#original-materials","children":["Original materials"]}]]}],"\n",["$","section",null,{"className":"content-section","children":[["$","div",null,{"className":"prose-card","children":[["$","h2",null,{"children":["Context and use"]}],["$","p",null,{"children":["The original materials were developed for Trevor Arcadipane’s senior government class at Trona High School in October 2026. This educator guide was added on October 20 to support a planning conversation with a colleague. It documents a completed design resource, with educator implementation and impact still to be documented."]}],["$","p",null,{"children":[["$","strong",null,{"children":["Original assignment:"]}]," a paired presentation using two scholarly sources, a choice of executive-branch issues, and a common rubric. ",["$","strong",null,{"children":["New educator companion:"]}]," the alignment analysis, support options, co-design questions, and suggested formative checkpoint below. These additions are recommendations for a future adaptation."]}]]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"student-task","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Accessible text version"]}],["$","h2",null,{"id":"student-task","children":["The student task"]}]]}],["$","div",null,{"className":"prose-card","children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":["Choose one question with your partner. Take a position and support it with evidence."]}]," Your audience is your classmates, who will ask questions about your reasoning."]}],"\n",["$","ul",null,{"children":[["$","li",null,{"children":["Should the Electoral College be replaced with a national popular vote?"]}],["$","li",null,{"children":["Should Congress place stricter limits on presidential executive orders?"]}],["$","li",null,{"children":["Should there be a maximum age for a president at the start of a term?"]}],["$","li",null,{"children":["Should Congress place tighter limits on presidential use of force without congressional authorization?"]}],["$","li",null,{"children":["Should the federal pardon power have additional limits?"]}],["$","li",null,{"children":["Should a national emergency expire after 30 days unless Congress approves its continuation? This is a proposed rule to debate."]}]]}],"\n",["$","p",null,{"children":["An alternative executive-branch question requires teacher approval. Explain whether you recommend a change or support the current approach. Make any proposed change specific."]}],"\n",["$","ol",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":["Research one source each."]}]," Use two different scholarly works found through Google Scholar. Read the relevant passages in context and save the author, year, publication information, page or section, and link. An official source or class notes may provide additional background."]}],["$","li",null,{"children":[["$","strong",null,{"children":["Build one shared deck."]}]," Include your position, the current rule and constitutional connection, two reasons supported by evidence, an opposing argument and response, and a recommendation with a benefit and tradeoff. Include references."]}],["$","li",null,{"children":[["$","strong",null,{"children":["Choose the presentation design."]}]," Use one of the provided themes or your own. The order and number of slides may change if the required content remains clear."]}],["$","li",null,{"children":[["$","strong",null,{"children":["Prepare to explain the argument."]}]," Use your own note cards. Present for five minutes and answer questions for two minutes. Both partners explain evidence and share the speaking time."]}]]}],"\n",["$","p",null,{"children":["The original materials specify journal articles, law-review articles, or academic book chapters. Google Scholar is a search tool, and inclusion there alone does not establish source quality or peer review. Record the actual work as the source."]}],"\n",["$","figure",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Original presentation structure"]}],["$","h3",null,{"children":["A visible place for the reasoning"]}],["$","dl",null,{"className":"design-example","children":[["$","dt",null,{"children":["Reason"]}],["$","dd",null,{"children":["What supports our position?"]}],["$","dt",null,{"children":["Evidence"]}],["$","dd",null,{"children":["What does the source contribute? Credit the author and location."]}],["$","dt",null,{"children":["Explanation"]}],["$","dd",null,{"children":["Why does this detail support our argument?"]}],["$","dt",null,{"children":["Challenge"]}],["$","dd",null,{"children":["What would a reasonable opponent say, and how do we respond?"]}]]}],["$","figcaption",null,{"children":["This text model summarizes the evidence and counterargument prompts in the original student template. It contains no student work."]}]]}],"\n"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"design-alignment","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Educator planning"]}],["$","h2",null,{"id":"design-alignment","children":["Align the goal, evidence, and activity"]}]]}],["$","div",null,{"className":"prose-card","children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":["Learning goal:"]}]," students explain an executive-branch issue, defend a position with relevant evidence, and respond to a counterargument. Their political position is not a scoring criterion."]}],"\n",["$","p",null,{"children":["The planning sequence follows ",["$","a",null,{"href":"https://ascd.org/ASCD/pdf/siteASCD/publications/UbD_WhitePaper0312.pdf","children":["McTighe and Wiggins’s ",["$","em",null,{"children":["Understanding by Design"]}]," framework (2012)"]}],": establish the goal, identify evidence of learning, then plan instruction."]}],"\n",["$","div",null,{"className":"portfolio-table-wrap","children":[["$","table",null,{"children":[["$","caption",null,{"children":["Backward design applied to the project"]}],["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["Intended learning"]}],["$","th",null,{"scope":"col","children":["Evidence of understanding"]}],["$","th",null,{"scope":"col","children":["Preparation and teacher decision"]}]]}]]}],["$","tbody",null,{"children":["\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Understand the civic issue"]}],["$","td",null,{"children":["An accurate explanation that separates current rules from the proposed change."]}],["$","td",null,{"children":["Examine background information before taking a position. Correct a factual misunderstanding before students build on it."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Use evidence to reason"]}],["$","td",null,{"children":["Two relevant source contributions with explanations of their connection to the claim."]}],["$","td",null,{"children":["Model a source note and an explanation. Add a checkpoint before the final presentation."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Evaluate a competing view"]}],["$","td",null,{"children":["A fair objection, a supported response, and a real tradeoff."]}],["$","td",null,{"children":["Rehearse a question that challenges the argument. Ask students to strengthen the response or qualify the claim."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Explain independently"]}],["$","td",null,{"children":["Each partner can explain a contribution and respond to a question."]}],["$","td",null,{"children":["Plan meaningful roles and check each student’s understanding during preparation."]}]]}],"\n"]}]]}]]}],"\n",["$","p",null,{"children":["The digital deck places the claim, evidence, explanation, and references together so the teacher can inspect the argument. Its value depends on the thinking students put into those sections. A completed slide with a copied passage still needs instructional attention."]}],"\n",["$","h3",null,{"children":["A design conversation with a colleague"]}],["$","ol",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":["Agree on the learning."]}]," Ask which content and reasoning students must demonstrate. Use the colleague’s course goals to adapt this example."]}],["$","li",null,{"children":[["$","strong",null,{"children":["Choose the evidence."]}]," Examine what would distinguish an explanation from a summary. Decide how each learner will demonstrate understanding."]}],["$","li",null,{"children":[["$","strong",null,{"children":["Plan the work."]}]," Identify source access, modeling, research time, feedback, revision, and presentation time. Set the actual schedule together."]}],["$","li",null,{"children":[["$","strong",null,{"children":["Walk through the task."]}]," Have the colleague follow the student directions, locate the response spaces, and identify a barrier before assigning it."]}]]}],"\n",["$","figure",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Coaching model"]}],["$","h3",null,{"children":["Make the expected thinking visible"]}],["$","dl",null,{"className":"design-example","children":[["$","dt",null,{"children":["Starting prompt"]}],["$","dd",null,{"children":["“Add evidence that supports your position.”"]}],["$","dt",null,{"children":["Revised prompt"]}],["$","dd",null,{"children":["“Identify a specific detail from your source, explain how it supports your proposed change, and name one limit to what it establishes.”"]}],["$","dt",null,{"children":["Design reasoning"]}],["$","dd",null,{"children":["Separating evidence from explanation makes the expected thinking visible. The added limit asks students to distinguish what a source supports from their own recommendation."]}],["$","dt",null,{"children":["Educator practice"]}],["$","dd",null,{"children":["Ask the colleague to revise a prompt from their own lesson, then explain what the new wording will help them assess."]}]]}],["$","figcaption",null,{"children":["This worked revision is a prepared coaching model, not a record of a meeting. It applies the original project’s emphasis on evidence, explanation, and tradeoffs."]}]]}],"\n"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"access","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"access","children":["Plan access and active participation"]}]]}],["$","div",null,{"className":"prose-card","children":[["$","p",null,{"children":["These are proposed adaptations for the educator to select with knowledge of the class. They extend the original assignment rather than describing supports already tested."]}],"\n",["$","div",null,{"className":"portfolio-table-wrap","children":[["$","table",null,{"children":[["$","caption",null,{"children":["Keep the reasoning goal while addressing the barrier"]}],["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["Possible barrier"]}],["$","th",null,{"scope":"col","children":["Design response"]}],["$","th",null,{"scope":"col","children":["What remains expected"]}]]}]]}],["$","tbody",null,{"children":["\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Dense scholarly reading"]}],["$","td",null,{"children":["Preview essential vocabulary and help locate a manageable passage within the full work. Offer selectable text and suitable reading support."]}],["$","td",null,{"children":["The student explains the source’s contribution and its relevance, with accurate attribution."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Losing track of the task"]}],["$","td",null,{"children":["Keep directions in one place, separate steps, and model one source note. Use a brief check before students build the full deck."]}],["$","td",null,{"children":["The same claim, evidence, reasoning, and rebuttal."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["One partner dominates"]}],["$","td",null,{"children":["Give each student responsibility for a source and an explanation. Include an individual checkpoint."]}],["$","td",null,{"children":["Each learner understands and contributes to the shared position."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Speaking or presentation access"]}],["$","td",null,{"children":["Plan rehearsal and appropriate supports. Consider an equivalent recorded or supported explanation when appropriate to the learning goal and individual plan."]}],["$","td",null,{"children":["Each student explains evidence and responds to a substantive question. Adapt the assessment method with the educator."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Connectivity or navigation"]}],["$","td",null,{"children":["Provide a usable text or print route to the same task. Check links, text selection, keyboard use, reading order, and contrast in the actual files."]}],["$","td",null,{"children":["Access to the question, sources, directions, feedback, and a way to submit the response."]}]]}],"\n"]}]]}]]}],"\n",["$","p",null,{"children":["CAST’s UDL framework informs these options for engagement, access to information, and expression. These recommendations do not certify the original Slides templates as accessible. Test the selected materials and supports with the people who will use them."]}]]}]]}],"\n",["$","section",null,{"className":"content-section","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"children":["Assessment and follow-through"]}]]}],["$","div",null,{"className":"prose-card","children":[["$","p",null,{"children":[["$","strong",null,{"children":["The original rubric totals 100 points: 80 shared points and 20 individual points."]}]," The table below presents all six criteria, their full-credit expectations, and their original scoring bands in a public text format. Each partner receives the shared presentation scores and their own preparation and speaking scores."]}],"\n",["$","div",null,{"className":"portfolio-table-wrap","children":[["$","table",null,{"children":[["$","caption",null,{"children":["Original Executive Branch Debate rubric"]}],["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["Criterion"]}],["$","th",null,{"scope":"col","children":["Full-credit expectations"]}],["$","th",null,{"scope":"col","children":["Scoring bands"]}]]}]]}],["$","tbody",null,{"children":["\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Claim and civics",["$","br",null,{}],"20 shared points"]}],["$","td",null,{"children":["State a clear position, accurately explain the current rule or power and its constitutional connection, and distinguish a proposed change from existing law."]}],["$","td",null,{"children":["20, 16, 12, or 8; missing: 0."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Evidence",["$","br",null,{}],"20 shared points"]}],["$","td",null,{"children":["Use two distinct scholarly sources found through Google Scholar. Select relevant evidence and credit each source where it is used."]}],["$","td",null,{"children":["20, 16, 12, or 8; missing: 0."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Reasoning and rebuttal",["$","br",null,{}],"20 shared points"]}],["$","td",null,{"children":["Develop two reasons with evidence and explanation. Address a fair opposing argument and make a final recommendation that identifies a benefit and a tradeoff."]}],["$","td",null,{"children":["20, 16, 12, or 8; missing: 0."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Slide organization",["$","br",null,{}],"20 shared points"]}],["$","td",null,{"children":["Organize ideas clearly with readable text and a complete Sources slide. Use a provided theme or an original design."]}],["$","td",null,{"children":["20, 16, 12, or 8; missing: 0."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Preparation",["$","br",null,{}],"10 individual points"]}],["$","td",null,{"children":["Research one source, build your part of the slides, and be ready to explain your contribution."]}],["$","td",null,{"children":["10, 8, 6, or 4; missing: 0."]}]]}],"\n",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Speaking and response",["$","br",null,{}],"10 individual points"]}],["$","td",null,{"children":["Share the speaking time, explain your ideas clearly, and help answer questions."]}],["$","td",null,{"children":["10, 8, 6, or 4; missing: 0."]}]]}],"\n"]}]]}]]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":["Scoring guide (shared / individual):"]}]," 20 / 10 = complete and accurate; 16 / 8 = minor gaps; 12 / 6 = partial, needs detail; 8 / 4 = major gaps or errors; missing work = 0."]}],"\n",["$","p",null,{"children":["The new ",["$","a",null,{"href":"/artifacts/standard-4-4/assessment-feedback/","children":["Digital Assessment and Feedback Toolkit"]}]," adds a formative check before grading. It leaves the existing 100-point rubric intact. The educator can use the check to identify one priority for revision before the presentation."]}],["$","p",null,{"children":["After using the design with a colleague, retain the agreed learning goal, the adapted task, and the educator’s explanation of a change. Ask: “Which design decision can you now apply to another lesson?” and “Where did the materials still make participation difficult?” Review these records for evidence that the colleague can apply the design principles independently."]}]]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"original-materials","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"original-materials","children":["Original materials and sources"]}]]}],["$","div",null,{"className":"prose-card","children":[["$","p",null,{"children":["The public text version above makes the core task available without a sign-in. The original Google Drive files may require access according to their existing sharing settings."]}],["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","a",null,{"href":"https://docs.google.com/presentation/d/15vZkPLIlGd1VFRMUHKyeT8hp3aDaV_iunAxTSH8fXFo/edit","children":["White House Briefing student template"]}]]}],"\n",["$","li",null,{"children":[["$","a",null,{"href":"https://docs.google.com/presentation/d/1kqmilB6dBSDeYSCBwUosmyUjDUpW_C9ojbHNj2JtZ14/edit","children":["Constitutional Convention student template"]}]]}],"\n",["$","li",null,{"children":[["$","a",null,{"href":"https://docs.google.com/presentation/d/1fE5JPd202c2mDvGog5eLcQ_77aR5SqMw7B00hIaoK18/edit","children":["Election Night student template"]}]]}],"\n",["$","li",null,{"children":[["$","a",null,{"href":"https://drive.google.com/file/d/1JeOxRhlNtDhk0NDpLKG5VRPmKXw46jpT/view","children":["Original topic choices"]}]]}],"\n",["$","li",null,{"children":[["$","a",null,{"href":"https://drive.google.com/file/d/112-ITanuOoxk9IrvhH3iij8Lr95eASIL/view","children":["Original 100-point rubric"]}]]}],"\n",["$","li",null,{"children":[["$","a",null,{"href":"https://drive.google.com/file/d/1cs0QU6c9y8eirBBfYKrEe2MGrGmE4pe1/view","children":["Original speaking guide"]}]]}],"\n",["$","li",null,{"children":["CAST. (2024). ",["$","a",null,{"href":"https://udlguidelines.cast.org/","children":["Universal Design for Learning Guidelines, version 3.0"]}],"."]}]]}],"\n",["$","p",null,{"children":["The original slide themes include AI-generated decorative artwork, identified in their speaker notes. The public text version does not reproduce that artwork or any student submissions."]}]]}]]}],"\n",["$","nav",null,{"className":"page-pagination","children":[["$","a",null,{"href":"/standards/4-4/","children":["Return to Learning Designer"]}],["$","a",null,{"href":"/artifacts/standard-4-4/assessment-feedback/","children":["Assessment and feedback toolkit →"]}]]}],"\n\n"]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Coach Standards"]}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":["CSUF Educational Technology"]}]]}]]}]]}]
