,["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","aria-current":"page","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}],["$","main",null,{"id":"main-content","className":"standard44","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["Standard 4.4 · Educator resource"]}],"\n  ",["$","h1",null,{"children":["Digital Assessment and Feedback Toolkit"]}],"\n  ",["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["A short assessment sequence for the Executive Branch Debate: identify a gap, give useful feedback, and let students revise before presenting."]}]]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"toolkit-purpose","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"toolkit-purpose","children":["Purpose and use"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["This resource adds formative checkpoints to the existing senior government project. Pairs still research two distinct scholarly works, develop one position, explain two reasons, answer an objection, and present for five minutes followed by two minutes of questions. The original 100-point rubric remains the grading instrument; these checks carry no additional points."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Implementation stage:"]}]," Prepared in October 2026 for adaptation with educators. All practice responses are synthetic; educator implementation and outcomes have not yet been documented."]}],"\n    ",["$","p",null,{"children":["Use an approved private digital form or document to review individual responses, return comments, and retain revisions. A paper response or conference can serve the same goal when needed. Technology organizes the exchange; the teacher evaluates reasoning and source accuracy."]}],"\n    ",["$","h3",null,{"children":["Suggested schedule"]}],"\n    ",["$","ol",null,{"children":["\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["During drafting:"]}]," Reserve about 10 minutes for the individual checkpoint, with sources and draft slides open."]}],"\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["Before the next work period:"]}]," Review responses and return one priority comment per student. Identify any common misconception for a brief explanation."]}],"\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["Before presentations:"]}]," Allow about 10 minutes for revision and three minutes for the independent exit response. Check unresolved gaps before final assessment."]}],"\n    "]}],"\n    ",["$","p",null,{"children":["Adjust the pacing with the educator. If feedback arrives late, preserve revision time by adjusting the presentation schedule."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"student-check","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"student-check","children":["Student checkpoint: before the presentation"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Complete this check individually after your pair has drafted its evidence slides. Use your actual sources and slide references. Your teacher will identify one revision to complete before presenting."]}]]}],"\n    ",["$","ol",null,{"children":["\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["State the position."]}]," What does your pair recommend? Identify what would change or stay the same. In a separate sentence, explain the relevant current rule or power and cite the background source you checked."]}],"\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["Explain one piece of evidence."]}]," Give the author, year, page or section, and working link for the scholarly work you researched. Summarize one relevant argument, finding, or example. Explain how it supports your pair’s position."]}],"\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["Test the argument."]}]," State a reasonable objection. Explain your response using evidence from one of your sources. Identify one limitation or tradeoff your recommendation still needs to address."]}],"\n      ",["$","li",null,{"children":[["$","strong",null,{"children":["Choose a revision."]}]," Which slide or explanation most needs improvement? Name the exact change you will make and the help, if any, you need."]}],"\n    "]}],"\n    ",["$","p",null,{"children":["A sentence starter or an accessible recorded response with a text outline can support participation. Keep the reasoning, source information, and criteria consistent. Checkpoint accommodations do not automatically change the original presentation expectations."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"teacher-interpretation","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"teacher-interpretation","children":["Read the response, then choose the support"]}]]}],"\n  ",["$","div",null,{"className":"portfolio-table-wrap","children":["\n    ",["$","table",null,{"children":["\n      ",["$","caption",null,{"children":["Success criteria and instructional responses"]}],"\n      ",["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["Look for"]}],["$","th",null,{"scope":"col","children":["If it is missing"]}],["$","th",null,{"scope":"col","children":["Next teaching move"]}]]}]]}],"\n      ",["$","tbody",null,{"children":["\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["A specific recommendation separated from an accurate description of the current system."]}],["$","td",null,{"children":["The proposal is presented as an existing rule, or the claim is unclear."]}],["$","td",null,{"children":["Have the student compare the two sentences with an appropriate official background source. Revise the distinction before adding more argument."]}]]}],"\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["A traceable scholarly source, accurately summarized, with a clear connection to the claim."]}],["$","td",null,{"children":["The response names a source but gives no usable evidence or explanation."]}],["$","td",null,{"children":["Review the relevant passage together. Ask what it establishes, what it does not establish, and why it matters to this claim."]}]]}],"\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["A fair objection and an evidence-based response that recognizes a real tradeoff."]}],["$","td",null,{"children":["The opposing view is dismissed or the response repeats the original claim."]}],["$","td",null,{"children":["Ask the student to restate the objection fairly and identify what evidence would address it."]}]]}],"\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["A specific revision the student can explain independently."]}],["$","td",null,{"children":["The plan says only “add more detail” or depends entirely on the partner."]}],["$","td",null,{"children":["Ask the student to identify one sentence, slide, or source explanation to change and rehearse the revision."]}]]}],"\n      "]}],"\n    "]}],"\n  "]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["Prioritize the most consequential gap. A misconception about the current system comes before slide polish. Similar gaps can guide a short group explanation; different gaps call for different feedback. Check each student’s understanding even when the final deck receives shared scores."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"feedback-examples","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"feedback-examples","children":["Practice giving feedback"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["These first three examples illustrate reasoning about proposed limits on executive orders. Check source-dependent statements against students’ actual research."]}],"\n    ",["$","div",null,{"className":"artifact-preview","children":["\n      ",["$","h3",null,{"children":["1. A position without support"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Practice response:"]}]," “Congress should add limits because presidents have too much power.”"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Feedback:"]}]," “Name the limit you propose. Then identify one relevant argument or example in your source and explain how that evidence supports this particular limit.”"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Student action:"]}]," Make the claim specific and connect it to traceable evidence."]}],"\n    "]}],"\n    ",["$","div",null,{"className":"artifact-preview","children":["\n      ",["$","h3",null,{"children":["2. Evidence mentioned, reasoning incomplete"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Practice response:"]}]," “Our source discusses accountability. That proves our proposed limit is best.”"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Feedback:"]}]," “Explain the source’s actual argument. Why does it support your chosen limit? Replace ‘proves’ if the source does not compare your proposal with the alternatives.”"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Student action:"]}]," Revise the explanation to match what the source supports and acknowledge its limits."]}],"\n    "]}],"\n    ",["$","div",null,{"className":"artifact-preview","children":["\n      ",["$","h3",null,{"children":["3. A developed argument ready for challenge"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Practice response:"]}]," “Our source’s argument about accountability supports a review requirement. A review could also slow action, so our proposal needs a clear procedure for urgent situations.”"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Feedback:"]}]," “Explain how your proposed procedure addresses the objection. Identify what your source supports and what is your own recommendation.”"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Student action:"]}]," Strengthen the rebuttal and distinguish evidence from inference."]}],"\n    "]}],"\n    ",["$","div",null,{"className":"artifact-preview","children":["\n      ",["$","h3",null,{"children":["Full worked revision: checking a research plan"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Source for this practice:"]}]," The original project requires two distinct scholarly works, one researched by each partner. Its research guidance explains that inclusion in Google Scholar does not guarantee peer review."]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Before:"]}]," “We found a PDF and a website version of the same article on Google Scholar. That gives us two peer-reviewed sources, so our research is finished.”"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Teacher feedback:"]}]," “Count distinct works rather than links. What does the assignment require each partner to research? Explain what you still need to check about the publication.”"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["After:"]}]," “Our two links lead to one article, so we currently have only one scholarly work. One partner will research a different journal article, law-review article, or academic book chapter. We will inspect each work’s author, publication, relevant passage, and usefulness to our argument. We cannot call a source peer-reviewed simply because Google Scholar lists it.”"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Why this revision meets the criterion:"]}]," The student identifies the precise gap, uses the assignment to justify a next step, and corrects an unsupported assumption. The teacher would still review the selected second work before confirming that the research requirement is met."]}],"\n    "]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"revision-check","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"revision-check","children":["Close the feedback loop"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Copy this revision record into the student’s private working document. Replace the bracketed fields."]}]]}],"\n    ",["$","div",null,{"className":"portfolio-table-wrap","children":[["$","table",null,{"children":["\n      ",["$","caption",null,{"children":["Individual revision record"]}],"\n      ",["$","tbody",null,{"children":["\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Criterion and location"]}],["$","td",null,{"children":["[Learning criterion; slide or checkpoint question]"]}]]}],"\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Original response"]}],["$","td",null,{"children":["[Paste the original explanation]"]}]]}],"\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Feedback received"]}],["$","td",null,{"children":["[Copy the priority comment]"]}]]}],"\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Revised response"]}],["$","td",null,{"children":["[Write the improved explanation]"]}]]}],"\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Source checked"]}],["$","td",null,{"children":["[Author, page or section, link, and relevant passage]"]}]]}],"\n      "]}],"\n    "]}]]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Independent exit response:"]}]," “What changed in your reasoning, and why does the revision better meet the criterion? Explain without your partner answering for you.”"]}],"\n    ",["$","p",null,{"children":["Review the revision for substantive improvement. A resolved comment or completed submission does not establish understanding. If the gap remains, provide another example or a short conference, then ask for an independent explanation."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"educator-use","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"educator-use","children":["Adapt the toolkit with an educator"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Co-design:"]}]," Agree on the learning goal, select the most useful checkpoint, and decide when feedback and revision can occur. Keep the checkpoint aligned with the existing assignment and rubric."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Model and rehearse:"]}]," Explain how one practice response reveals a gap. Write one actionable comment, then ask the educator to assess a different response and explain their feedback choice. Compare judgments against the criteria."]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Transfer and review:"]}]," Have the educator adapt the sequence to another lesson. After use, retain the agreed goal, revised assessment prompt, anonymized feedback-and-revision example, and the educator’s account of what they changed. Ask whether the support improved their assessment decisions and what needs revision. These records would document impact; the toolkit alone does not."]}],"\n  "]}],"\n"]}],"\n\n",["$","nav",null,{"className":"page-pagination","children":[["$","a",null,{"href":"/standards/4-4/","children":["Return to Learning Designer"]}],["$","a",null,{"href":"/artifacts/standard-4-4/executive-branch-design/","children":["Executive Branch Digital Inquiry"]}]]}],"\n"]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Coach Standards"]}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":["CSUF Educational Technology"]}]]}]]}]]}]
