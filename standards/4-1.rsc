1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to main content"}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","$L6",null,{"className":"brand","href":"/","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":"TA"}],["$","span",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","small",null,{"children":"Secondary Social Science · Educational Technology"}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":"Menu"}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"page","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"$undefined","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"page","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"$undefined","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}],["$","main",null,{"id":"main-content","className":"standard41","children":[["$","link",null,{"rel":"stylesheet","href":"/assets/standard41.css"}],["$","div",null,{"className":"page-wrap","children":[["$","header",null,{"className":"page-intro","children":[["$","p",null,{"className":"eyebrow","children":"ISTE Coach Standard 4.1"}],["$","h1",null,{"children":"Change Agent"}],["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":"Coaches inspire educators and leaders to use technology to create equitable and ongoing access to high-quality learning."}],["$","a",null,{"className":"text-link","href":"https://iste.org/standards/coaches","children":"View the official ISTE Coach Standards"}]]}]]}],["$","section",null,{"className":"content-section artifact-section","aria-labelledby":"artifact-one","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Artifact One"}],["$","h2",null,{"id":"artifact-one","children":"Trona High School Technology Recognition Plan"}]]}],["$","div",null,{"className":"prose-card","children":[["$","h3",null,{"children":"Indicator"}],["$","p",null,{"children":[["$","strong",null,{"children":"4.1.d: Recognize High-Impact Teaching."}]," Coaches recognize educators across the organization who use technology effectively to enable high-impact teaching and learning."]}],["$","h3",null,{"children":"Description"}],["$","p",null,{"children":"I created the one-page Trona High School Technology Recognition Plan for my work as a first-year social sciences teacher in grades 7–12. I use it to notice and share effective technology use while making sure the educator approves what is shared. Its four stages are observe and listen, invite and confirm, celebrate and share, and look for high-impact practice. The plan focuses on inquiry, feedback, collaboration, student agency, equitable access, and ideas other teachers can use."}],["$","figure",null,{"className":"portfolio-evidence","children":[["$","a",null,{"href":"/artifacts/standard41-recognition-plan.png","children":["$","img",null,{"src":"/artifacts/standard41-recognition-plan.png","alt":"Four-step Technology Recognition Plan: observe and listen, invite and confirm, celebrate and share, and look for high-impact practice. One recognition cycle completed.","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Figure 1. Trona High School Technology Recognition Plan."}]]}],["$","a",null,{"className":"text-link","href":"/artifacts/technology-leadership-spotlights/","children":"View the complete Technology Recognition Plan"}],["$","h3",null,{"children":"Implementation"}],["$","p",null,{"children":"During the first week of September 2026, I completed one recognition cycle with a willing Trona colleague."}],["$","p",null,{"children":"I used the plan to recognize how a colleague organized directions, examples, feedback, and makeup work in Google Classroom. I asked how the routine supported students and wrote a short spotlight about access and independence."}],["$","p",null,{"children":"The educator checked and approved the spotlight before I shared it with two other Trona teachers. I removed names and student information from the portfolio evidence."}],["$","h3",null,{"children":"Impact"}],["$","p",null,{"children":"The spotlight gave teachers a quick way to learn from one another. One teacher asked how the materials were organized and used the same approach in an upcoming assignment with consistent headings, posted examples, and clearer directions."}],["$","p",null,{"children":"This shows emerging competence with 4.1.d because I found an effective practice, confirmed it with the educator, and shared it in a way that influenced another teacher."}],["$","p",null,{"children":[["$","strong",null,{"children":"Impact evidence (names removed):"}]," The educator reviewed and approved the spotlight. I shared it with two Trona teachers, and follow-up notes show that one teacher used consistent headings, posted examples, and clearer directions."]}]]}]]}],["$","section",null,{"className":"content-section artifact-section","aria-labelledby":"artifact-two","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Artifact Two"}],["$","h2",null,{"id":"artifact-two","children":"Digital Lesson Accessibility Quick Check"}]]}],["$","div",null,{"className":"prose-card","children":[["$","h3",null,{"children":"Indicators"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"4.1.b: Use of Digital Tools and Content."}]," Coaches facilitate equitable use of digital learning tools and content that meet the needs of each learner."]}],["$","li",null,{"children":[["$","strong",null,{"children":"4.1.c: Cultivate a Supportive Coaching Culture."}]," Coaches cultivate a supportive coaching culture that encourages educators and leaders to achieve a shared vision and meet individual goals."]}]]}],["$","h3",null,{"children":"Description"}],["$","p",null,{"children":"The Digital Lesson Accessibility Quick Check is a two-page resource for a 10–15-minute, non-evaluative review of one digital lesson or resource. It checks directions, readability, organization, selectable text, image descriptions, captions, access tools, links, and privacy. The educator and reviewer then choose one practical improvement and record the change, evidence, and feedback. I adapted it from my EDEL 518A Accessible Design Story Series."}],["$","p",null,{"children":["Related artifact: ",["$","a",null,{"href":"/artifacts/accessible-design-story-series/","children":"Accessible Design Story Series"}],"."]}],["$","div",null,{"className":"portfolio-evidence-grid","children":[["$","figure",null,{"className":"portfolio-evidence","children":[["$","a",null,{"href":"/artifacts/standard41-quick-check-page-1.png","children":["$","img",null,{"src":"/artifacts/standard41-quick-check-page-1.png","alt":"Completed accessibility checklist for a secondary English Google Slides lesson, identifying image-only directions and an image needing alt text. Full text is available on the linked artifact page.","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Figure 2. Completed Quick Check, page 1."}]]}],["$","figure",null,{"className":"portfolio-evidence","children":[["$","a",null,{"href":"/artifacts/standard41-quick-check-page-2.png","children":["$","img",null,{"src":"/artifacts/standard41-quick-check-page-2.png","alt":"Completed implementation record and educator feedback describing the change to selectable text, numbered steps, and an example. Full text is available on the linked artifact page.","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Figure 3. Implementation and evidence record, page 2."}]]}]]}],["$","div",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"text-link","href":"/artifacts/digital-lesson-accessibility-quick-check/","children":"Read the completed Quick Check"}],["$","a",null,{"className":"text-link","href":"/artifacts/digital-lesson-accessibility-quick-check.pdf","children":"Open the completed Quick Check (PDF)"}]]}],["$","h3",null,{"children":"Implementation"}],["$","p",null,{"children":"I completed one collaborative review with a Trona colleague."}],["$","p",null,{"children":"On September 3, 2026, I used the Quick Check with a secondary English teacher to review a Google Slides lesson. We found image-only directions that could not be selected or read aloud with Chromebook tools. We also found one image that needed alt text."}],["$","p",null,{"children":"We chose one priority: replace the image-only directions with selectable text, numbered steps, and a brief example. The educator made the change, and I saved the checklist, revised slide, before-and-after record, and educator feedback without identifying information."}],["$","h3",null,{"children":"Impact"}],["$","p",null,{"children":"The revised directions could be selected, enlarged, and read aloud with built-in tools. The numbered steps also made the task easier to follow. I did not collect student-performance data, so I am not claiming improved achievement. The revision still shows that the educator changed the resource and removed an access barrier."}],["$","p",null,{"children":"The educator said the short format fit easily into normal lesson planning and planned to use the Quick Check again."}],["$","p",null,{"children":["For ",["$","strong",null,{"children":"4.1.b"}],", I helped another educator identify an access barrier and revise the lesson so students could use selectable text and built-in reading support. This helped me move from applying accessibility principles in my own work to supporting someone else's practice. For ",["$","strong",null,{"children":"4.1.c"}],", I kept the review supportive and non-evaluative, with the educator choosing the resource, priority, and revision. Working toward a shared goal of clearer, more accessible directions while respecting the teacher's choices helped build trust. These are early steps toward an ongoing coaching culture."]}]]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"overall-reflection","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"overall-reflection","children":"Overall Reflection on Standard 4.1"}],["$","p",null,{"children":"One teacher adapted the Google Classroom organization strategy, and another revised image-only directions after the accessibility review. These artifacts show emerging competence in 4.1.b, 4.1.c, and 4.1.d. I still need more experience with 4.1.a and 4.1.e."}]]}],["$","div",null,{"className":"portfolio-reflections","children":[["$","article",null,{"children":[["$","h3",null,{"children":"4.1.a: Create a Shared Vision"}],["$","p",null,{"children":"These conversations showed that we shared several priorities, including student access, clear digital organization, and practical technology use. I have not yet helped educators and leaders create a shared vision. My next step is to gather their input and turn one common need into a shared goal."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"4.1.b: Use of Digital Tools and Content"}],["$","p",null,{"children":"The accessibility review is my strongest evidence for 4.1.b. I helped an educator replace image-only directions with selectable text that works with built-in reading support. I need to repeat this process and collect evidence of how the changes affect learners."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"4.1.c: Cultivate a Supportive Coaching Culture"}],["$","p",null,{"children":"The Quick Check led to a short, non-evaluative coaching conversation. The educator chose the resource, priority, and revision, which helped build trust. I need more follow-up before this becomes an ongoing coaching relationship."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"4.1.d: Recognize High-Impact Teaching"}],["$","p",null,{"children":"I completed one recognition cycle by finding an effective practice, discussing its purpose, getting approval, and sharing it. Another teacher adapted the idea, showing that recognition can support professional learning. I need to repeat the process before it becomes an established school practice."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"4.1.e: Maximize Potential of Technology"}],["$","p",null,{"children":"These artifacts connected a few colleagues around practical needs, but I have not yet brought educators, leaders, and instructional or technical support together around a shared challenge. My next step is to connect the right people and resources, follow up, and document the result."}]]}]]}]]}],["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/","children":"Previous: Introduction"}],["$","a",null,{"href":"/standards/4-2/","children":"Next: Connected Learner","aria-current":"$undefined"}]]}]]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":"ISTE Coach Standards"}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":"CSUF Educational Technology"}]]}]]}]]}]
