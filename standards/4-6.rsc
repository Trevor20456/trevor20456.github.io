,["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","aria-current":"page","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}],["$","main",null,{"id":"main-content","className":"standard44","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["ISTE Coach Standard 4.6"]}],"\n  ",["$","h1",null,{"children":["Data-Driven Decision-Maker"]}],"\n  ",["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["A student can choose the right quotation and still struggle to explain why it matters. Working with a colleague on that distinction taught me how much the question we ask about student work shapes the help we give next."]}],["$","a",null,{"className":"source-link","href":"https://iste.org/standards/coaches","children":["Read the official Data-Driven Decision-Maker standard ",["$","span",null,{"aria-hidden":"true","children":["↗"]}]]}]]}],"\n"]}],"\n",["$","nav",null,{"className":"section-jump","aria-label":"On this page","children":[["$","a",null,{"href":"#data-context","children":["Context and indicators"]}],["$","a",null,{"href":"#response-guide","children":["Writing response guide"]}],["$","a",null,{"href":"#student-goals","children":["Student goal-setting worksheet"]}],["$","a",null,{"href":"#reflection","children":["Reflection"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"data-context","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional context"]}],["$","h2",null,{"id":"data-context","children":["Who gets to interpret the evidence?"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["In October 2026, a colleague at Trona wanted to know where students got stuck when they wrote about a text. We used Google Forms to look at their claims, supporting details, and explanations separately. My colleague used those responses to decide what to teach next. In a resource I designed for senior Government, I give students a turn at making that decision about their own work."]}],"\n    ",["$","p",null,{"children":["These experiences address three parts of the standard. ",["$","strong",null,{"children":["4.6.a"]}]," asks me to model how to collect, protect, and examine student information responsibly. ",["$","strong",null,{"children":["4.6.b"]}]," asks me to help educators interpret numbers alongside words and observations to support individual learners and judge whether an instructional change helped. ",["$","strong",null,{"children":["4.6.c"]}]," asks me to work with educators so students can choose their own goals and use evidence to track progress."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"response-guide","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact one · 4.6.a and 4.6.b"]}],["$","h2",null,{"id":"response-guide","children":["Reading the reasoning behind a claim"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["I developed a response guide around a writing task my colleague chose. The three prompts in our Form separated the student’s claim, choice of evidence, and reasoning. Reading one question at a time helped us decide who needed help finding a detail, who needed practice explaining it, and who was ready for a new passage."]}],"\n    ",["$","figure",null,{"className":"response-map","id":"decision-guide","children":[["$","div",null,{"className":"portfolio-table-wrap","children":[["$","table",null,{"children":["\n      ",["$","caption",null,{"children":["Writing response guide · Choosing the next teaching move"]}],"\n      ",["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["What we saw"]}],["$","th",null,{"scope":"col","children":["What it told us"]}],["$","th",null,{"scope":"col","children":["What to do next"]}]]}]]}],"\n      ",["$","tbody",null,{"children":["\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Relevant detail with an explanation"]}],["$","td",null,{"data-label":"What it told us","children":["The writer connected the detail to the claim."]}],["$","td",null,{"data-label":"What to do next","children":["Offer a new passage and ask the writer to apply the skill again."]}]]}],"\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Relevant detail repeated in the explanation"]}],["$","td",null,{"data-label":"What it told us","children":["The writer could select evidence. The reasoning that linked it to the claim was still missing."]}],["$","td",null,{"data-label":"What to do next","children":["Model the connection in one paragraph. Ask the writer to revise the explanation."]}]]}],"\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["Unrelated detail or unclear claim"]}],["$","td",null,{"data-label":"What it told us","children":["The writer needed help matching an idea to a detail in the text."]}],["$","td",null,{"data-label":"What to do next","children":["Reread the passage with a small group and locate a detail that supports the claim."]}]]}],"\n        ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["No response"]}],["$","td",null,{"data-label":"What it told us","children":["A blank answer left the student’s understanding unknown."]}],["$","td",null,{"data-label":"What to do next","children":["Check access and participation before deciding what support the student needs."]}]]}],"\n      "]}],"\n    "]}]]}],"\n    ",["$","figcaption",null,{"children":["This public version of my October response guide pairs classroom patterns with teaching decisions. A missing answer calls for its own check before we interpret the student’s understanding."]}]]}],"\n    ",["$","h3",null,{"children":["How we used it"]}],"\n    ",["$","p",null,{"children":["In our first October meeting, my colleague built the Form and we previewed it on a Chromebook. At our next meeting, we read the answers to the explanation prompt together. Several students had already picked useful evidence. Reteaching how to find a quotation would have missed their difficulty. We planned a model paragraph and a prompt students could use to revise. The feedback acknowledged the student’s choice of evidence and asked them to explain why that particular detail mattered."]}],"\n    ",["$","h3",null,{"children":["What changed"]}],"\n    ",["$","p",null,{"children":["My colleague taught the model and gave students time to revise. At our third meeting, they brought responses to a new passage and led the review. Explanations were clearer, although some students still needed a prompt. My colleague selected a small-group follow-up for those students. Seeing the same skill in a new passage gave us a way to judge where the lesson had helped and where more practice was needed."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"student-goals","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact two · 4.6.a–c"]}],["$","h2",null,{"id":"student-goals","children":["A student chooses the goal and the measure"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["I created this two-page guide in EDEL 518A for 12th-grade Government. It introduces qualitative and quantitative evidence through a routine called ",["$","em",null,{"children":["Notice–Ask–Act"]}],". Students look for a pattern, ask what might explain it, and decide what to try."]}],"\n    ",["$","figure",null,{"className":"source-figure","children":[["$","img",null,{"src":"/artifacts/edel-518a-data-project-page-2.jpg","alt":"Goal-setting worksheet with spaces for a number, an observation, a personal goal, a strategy, a measure of success, and a check-in reflection","width":"1020","height":"1320","loading":"lazy"}],["$","figcaption",null,{"children":["On the second page, a student pairs a number from their work with an observation, chooses a goal, and decides how to check their progress."]}]]}],"\n    ",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/data-informed-goal-setting/","children":["View the original data guide, worksheet, and accessible text ",["$","span",null,{"aria-hidden":"true","children":["→"]}]]}]]}],"\n    ",["$","h3",null,{"children":["How I plan to share it"]}],"\n    ",["$","p",null,{"children":["The guide is complete and available for another teacher to adapt. Its impact on a colleague’s classroom is still an open question. The evidence I would look for is a student returning to the goal they chose and using their own work to explain why they kept or changed their strategy."]}],"\n    ",["$","p",null,{"children":["My next use for this resource is a planning conversation with a colleague. We could use the writing task above as a starting point. A student might count the claims they explained on a recent assignment, choose one sentence that shows where they got stuck, and select a strategy to try on the next passage. I want the student to decide what would count as progress. A check-in with the teacher could then show whether the measure captured the improvement the student cared about."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"reflection","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional reflection"]}],["$","h2",null,{"id":"reflection","children":["What I learned from reviewing student work with a colleague"]}]]}],"\n  ",["$","div",null,{"className":"prose-card portfolio-reflections","children":["\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.6.a · Collect and protect student information"]}],"\n      ",["$","p",null,{"children":["I can help an educator decide what information a learning question actually calls for. Three short prompts gave us enough to identify the writing difficulty, and checking access helped us interpret blank responses fairly. My next step is to make secure handling part of the planning conversation before we collect anything. With a colleague, I will review who can open the Form’s responses, where our working notes belong, and which identifying details to remove from examples we bring to a coaching meeting."]}],"\n    "]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.6.b · Use evidence to choose and evaluate instruction"]}],"\n      ",["$","p",null,{"children":["This is the part of the standard where I have the clearest evidence of my coaching. Asking my colleague to describe what a student still needed kept the conversation focused on teaching. By the third meeting my colleague could choose a follow-up and explain why it fit the writing. In another review, I would add a simple count of explanations that connect the evidence to the claim on each passage. Reading a few explanations together would help us interpret that count and decide whether to keep or change the modeling routine."]}],"\n    "]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.6.c · Give students a role in monitoring progress"]}],"\n      ",["$","p",null,{"children":["The worksheet gives students room to choose a goal and a way to measure it. My coaching experience so far shows a colleague using evidence to make a decision. The next step is to help a colleague put the decision in students’ hands. I would ask a colleague to try the worksheet with one class and bring back a goal and a later check-in with identifying details removed. Together we could see whether the student chose a meaningful measure or needed a better example to get started."]}],"\n    "]}],"\n  "]}],"\n  ",["$","p",null,{"className":"artifact-label","children":["Artifact sources"]}],["$","p",null,{"children":["The response guide draws on my October 2026 mentoring work. The original Government guide and worksheet were developed for EDEL 518A."]}],"\n"]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-5/","children":["← Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-7/","children":["Digital Citizen Advocate →"]}]]}],"\n"]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Coach Standards"]}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":["CSUF Educational Technology"]}]]}]]}]]}]
