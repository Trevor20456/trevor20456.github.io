,["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","aria-current":"page","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}],["$","main",null,{"id":"main-content","className":"standard44","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["ISTE Coach Standard 4.6"]}],"\n  ",["$","h1",null,{"children":["Data-Driven Decision-Maker"]}],"\n  ",["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["Standard 4.6 focuses on helping educators collect and protect student information, interpret qualitative and quantitative evidence, and support students in setting goals and measuring progress. My artifacts show how I have helped a colleague use writing responses to choose instruction and how I plan to support colleagues with student goal setting."]}],["$","a",null,{"className":"source-link","href":"https://iste.org/standards/coaches","children":["Read the official Data-Driven Decision-Maker standard ",["$","span",null,{"aria-hidden":"true","children":["↗"]}]]}]]}],"\n"]}],"\n",["$","nav",null,{"className":"section-jump","aria-label":"On this page","children":[["$","a",null,{"href":"#response-guide","children":["Artifact One"]}],["$","a",null,{"href":"#student-goals","children":["Artifact Two"]}],["$","a",null,{"href":"#reflection","children":["Reflection"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"response-guide","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact One"]}],["$","h2",null,{"id":"response-guide","children":["Google Forms Response-Analysis Guide"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Indicator alignment"]}]," This artifact supports 4.6.b through coaching a colleague to interpret qualitative evidence and select support for individual learners."]}],"\n    ",["$","h3",null,{"children":["Description"]}],"\n    ",["$","p",null,{"children":["I developed this guide during my October 2026 EDEL 590 mentoring project with a colleague at Trona. The colleague selected an existing writing lesson about supporting a claim with evidence. Three Google Forms prompts asked students to state a claim, select a detail from a text, and explain the connection. The guide helped us identify the particular skill a student needed to practice and choose a teaching response. The table below presents the guide and our procedure for checking missing responses."]}],"\n    ",["$","figure",null,{"className":"response-map","id":"decision-guide","children":[["$","div",null,{"className":"portfolio-table-wrap","children":[["$","table",null,{"role":"table","children":["\n      ",["$","caption",null,{"children":["Writing response guide · Choosing the next teaching move"]}],"\n      ",["$","thead",null,{"role":"rowgroup","children":[["$","tr",null,{"role":"row","children":[["$","th",null,{"role":"columnheader","scope":"col","children":["What we saw"]}],["$","th",null,{"role":"columnheader","scope":"col","children":["What it told us"]}],["$","th",null,{"role":"columnheader","scope":"col","children":["What to do next"]}]]}]]}],"\n      ",["$","tbody",null,{"role":"rowgroup","children":["\n        ",["$","tr",null,{"role":"row","children":[["$","th",null,{"role":"rowheader","scope":"row","children":["Relevant detail with an explanation"]}],["$","td",null,{"role":"cell","data-label":"What it told us","children":["The writer connected the detail to the claim."]}],["$","td",null,{"role":"cell","data-label":"What to do next","children":["Offer a new passage and ask the writer to apply the skill again."]}]]}],"\n        ",["$","tr",null,{"role":"row","children":[["$","th",null,{"role":"rowheader","scope":"row","children":["Relevant detail repeated in the explanation"]}],["$","td",null,{"role":"cell","data-label":"What it told us","children":["The writer could select evidence. The reasoning that linked it to the claim was still missing."]}],["$","td",null,{"role":"cell","data-label":"What to do next","children":["Model the connection in one paragraph. Ask the writer to revise the explanation."]}]]}],"\n        ",["$","tr",null,{"role":"row","children":[["$","th",null,{"role":"rowheader","scope":"row","children":["Unrelated detail or unclear claim"]}],["$","td",null,{"role":"cell","data-label":"What it told us","children":["The writer needed help matching an idea to a detail in the text."]}],["$","td",null,{"role":"cell","data-label":"What to do next","children":["Reread the passage with a small group and locate a detail that supports the claim."]}]]}],"\n        ",["$","tr",null,{"role":"row","children":[["$","th",null,{"role":"rowheader","scope":"row","children":["No response"]}],["$","td",null,{"role":"cell","data-label":"What it told us","children":["A blank answer left the student’s understanding unknown."]}],["$","td",null,{"role":"cell","data-label":"What to do next","children":["Check access and participation before deciding what support the student needs."]}]]}],"\n      "]}],"\n    "]}]]}],"\n    ",["$","figcaption",null,{"children":["This public version of my October response guide pairs classroom patterns with teaching decisions. A missing answer calls for its own check before we interpret the student’s understanding."]}]]}],"\n    ",["$","h3",null,{"children":["Implementation"]}],"\n    ",["$","p",null,{"children":["We met on October 7, 14, and 21, 2026. In the first meeting, I modeled the prompts, and my colleague adapted and tested the Form on a Chromebook. In the second meeting, we examined students’ answers by question. I asked the teacher to explain the pattern before offering my interpretation. We noticed that students often chose relevant evidence but repeated it when asked to explain the connection. We used the guide to plan a model paragraph, specific feedback, and a revision opportunity. My colleague used the adjustment before our October 16 check-in."]}],"\n    ",["$","p",null,{"children":["At the third meeting, my colleague led the review of responses to a new passage. We considered who could explain the connection independently and who still needed a prompt. The teacher chose a small-group follow-up and explained the reason before I offered feedback."]}],"\n    ",["$","h3",null,{"children":["Impact"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Observed impact on my colleague"]}]," My support helped the teacher become more independent in interpreting student work and choosing an instructional response. My October 14 record describes how grouping responses by the writing skill made the results more useful to the teacher. The teacher then used the model paragraph and revision activity we planned. My October 21 record documents the colleague leading the second review, choosing a small group, and explaining why those students needed support with fewer prompts from me."]}],"\n    ",["$","p",null,{"children":["Those decisions are evidence of a change in the colleague’s practice. The teacher could identify a specific learning need and use it to plan feedback and instruction. This supports the qualitative interpretation component of 4.6.b. To demonstrate the full indicator, I will help the colleague combine the written responses with counts of students showing each skill and use both forms of evidence to justify the next teaching decision."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"student-goals","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact Two"]}],["$","h2",null,{"id":"student-goals","children":["Government Data Guide and Goal-Setting Worksheet"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Indicator alignment"]}]," The planned coaching use supports 4.6.b by combining numbers and observations and 4.6.c by helping a colleague give students responsibility for their goals and progress checks."]}],"\n    ",["$","h3",null,{"children":["Description"]}],"\n    ",["$","p",null,{"children":["I created this two-page resource in January 2026 for EDEL 518A, with 12th-grade Government in mind. The first page explains qualitative and quantitative data and introduces the Notice–Ask–Act routine. The second asks students to choose one number and one observation, develop a SMART goal, identify a strategy and support, and reflect at a later check-in. It gives a colleague a concrete resource for guiding student conversations about evidence and progress."]}],"\n    ",["$","figure",null,{"className":"source-figure","children":[["$","img",null,{"src":"/artifacts/edel-518a-data-project-page-2.jpg","alt":"Goal-setting worksheet with spaces for a number, an observation, a personal goal, a strategy, a measure of success, and a check-in reflection","width":"1020","height":"1320","loading":"lazy"}],["$","figcaption",null,{"children":["On the second page, a student pairs a number from their work with an observation, chooses a goal, and decides how to check their progress."]}]]}],"\n    ",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/data-informed-goal-setting/","children":["View the original data guide, worksheet, and accessible text ",["$","span",null,{"aria-hidden":"true","children":["→"]}]]}]]}],"\n    ",["$","h3",null,{"children":["Implementation"]}],"\n    ",["$","p",null,{"children":["The resource is complete, and the coaching implementation described here is planned. At an upcoming planning meeting, I will work with a colleague to select a current assignment and adapt the worksheet’s examples to that learning goal. I will model how to ask a student to interpret a result, choose a goal, and decide what evidence would show improvement. The colleague will rehearse the questions and select when the first conference and follow-up will occur."]}],"\n    ",["$","p",null,{"children":["After the colleague tries the routine, we will review the adapted worksheet, a goal and follow-up with identifying details removed, and the teacher’s observations. We will discuss whether students could explain their goals and measures, then revise any questions that caused confusion. This gives our follow-up a specific focus on the colleague’s use of the resource."]}],"\n    ",["$","h3",null,{"children":["Impact"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["Anticipated impact on colleagues"]}]," I expect this coaching to help an educator use both a measurable result and a student’s explanation when deciding what support to provide. The teacher will have a routine for helping students choose a goal, select a strategy, and return to evidence at a check-in. This connects to 4.6.c because my role is to help the colleague support students’ ownership of goals and progress."]}],"\n    ",["$","p",null,{"children":["I will evaluate that impact through the colleague’s adapted conference questions, a deidentified goal and check-in, and the teacher’s explanation of a decision made from that evidence. For example, a teacher might notice that a student’s score increased while the student still struggles to explain a concept, then adjust the next conference accordingly. That example illustrates the kind of educator decision I will look for. Evidence of the teacher making and explaining such decisions will show whether my coaching is improving their practice."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"reflection","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional reflection"]}],["$","h2",null,{"id":"reflection","children":["My competence and next steps for Standard 4.6"]}]]}],"\n  ",["$","div",null,{"className":"prose-card portfolio-reflections","children":["\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.6.a · Facilitate Data Collection and Analysis"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["I am working toward full competence in 4.6.a."]}]," The October work shows that I can help a colleague collect information tied to a learning goal and interpret missing responses carefully. We also agreed to remove identifying details from examples used in future meetings. To demonstrate the secure collection and protection required by this indicator, I will model a review of the Form’s access settings with a colleague, agree on where working records belong, and prepare a deidentified example together. I will then ask the colleague to explain and repeat those steps so I can assess whether my modeling supports independent practice."]}],"\n    "]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.6.b · Help Educators Interpret Data"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["I have demonstrated competence in coaching qualitative interpretation and am working toward full competence in 4.6.b."]}]," My colleague’s independent review and small-group decision show that my support helped them connect students’ writing with instruction. The indicator also calls for quantitative evidence. In our next review, we will count responses in the guide’s categories and examine examples within each category. I will ask the teacher to explain how the counts and written responses together support a decision for an individual learner, then revisit that learner’s work after the adjustment."]}],"\n    "]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.6.c · Support Student Data Use"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["I am working toward full competence in 4.6.c."]}]," The Government worksheet provides a structure for student-selected goals and progress checks. My next step is to complete the planned coaching cycle with a colleague and examine how the teacher helps students use that structure. I will look for the colleague asking students to explain their evidence, choose their own goal, and decide whether a strategy helped. A deidentified goal, later check-in, and the colleague’s reflection will help me judge how effectively our partnership supports student ownership and what I need to change in my coaching."]}],"\n    "]}],"\n  "]}],"\n  ",["$","p",null,{"className":"artifact-label","children":["Artifact sources"]}],["$","p",null,{"children":["The response guide and account of colleague impact draw on my October 2026 EDEL 590 assessment materials and weekly mentoring record. The Government guide and worksheet were developed for EDEL 518A."]}],"\n"]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-5/","children":["← Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-7/","children":["Digital Citizen Advocate →"]}]]}],"\n"]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Coach Standards"]}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":["CSUF Educational Technology"]}]]}]]}]]}]

