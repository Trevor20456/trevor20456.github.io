1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to main content"}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","$L6",null,{"className":"brand","href":"/","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":"TA"}],["$","span",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","small",null,{"children":"Secondary Social Science · Educational Technology"}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":"Menu"}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}],["$","main",null,{"id":"main-content","className":"standard43","children":[["$","div",null,{"className":"page-wrap","children":[["$","header",null,{"className":"page-intro","children":[["$","p",null,{"className":"eyebrow","children":["ISTE Coach Standard 4.3"]}],["$","h1",null,{"children":["Collaborator"]}],["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["Coaches establish productive relationships with educators in order to improve instructional practice and learning outcomes."]}],["$","a",null,{"className":"source-link","href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["View the official ISTE Coach Standards ↗"]}]]}]]}],["$","aside",null,{"className":"review-note","aria-labelledby":"feedback-focus","children":[["$","h2",null,{"id":"feedback-focus","children":["Feedback focus"]}],["$","p",null,{"children":["Does my response to needs-analysis feedback show appropriate progress toward 4.3.a? Does the resource-review guide provide a clear next step for working with an educator on 4.3.b–d?"]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"artifact-one","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact One"]}],["$","h2",null,{"id":"artifact-one","children":["Listening to Educators: Needs-Analysis Revision Record"]}]]}],["$","div",null,{"className":"prose-card","children":[["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.3.a — Trust and professional relationships."]}]," Responding to feedback and inviting educators to explain their priorities support my development in this area. ",["$","strong",null,{"children":["4.3.d — Support shaped around the educator."]}]," The revised questions prepare me to plan assistance around individual needs; personalized modeling is a next step."]}],["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["This artifact connects feedback on my EDEL 590 needs-analysis discussion to a revised, six-question planning survey. It includes a revision record and explains how teachers’ responses would shape support with brief formative assessments."]}],["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-3/needs-analysis-revision/","children":["Open the revision record and revised survey →"]}]]}],["$","div",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Inside the artifact"]}],["$","ol",null,{"children":[["$","li",null,{"children":["Ask how educators already check understanding."]}],["$","li",null,{"children":["Identify one decision or barrier they want help with."]}],["$","li",null,{"children":["Let the educator choose a useful form of support."]}]]}]]}],["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["In my September 2026 EDEL 590 discussion, I proposed a short needs analysis focused on helping Trona teachers use formative assessment to identify student needs and adjust instruction. A classmate asked whether my first question would help determine which tools to feature and whether it would be open-ended or multiple-choice. My instructor also asked about the question format."]}],["$","p",null,{"children":["I used those questions to make the survey’s purpose and response options more specific. In the revised version, educators can select familiar assessment practices, add an option of their own, and briefly describe what they need. The revision also asks about access, student participation, privacy concerns, and preferred support. Each question has a planning purpose: a teacher who needs help interpreting responses may need different support from someone who needs help creating the assessment."]}],["$","p",null,{"children":["The completed work is the discussion contribution and the revised resource presented here. I have not included staff responses or a completed coaching session. My next step is to invite a willing colleague to identify one priority and use that response to agree on a manageable goal."]}],["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["The feedback helped me move from a broad list of questions to a clearer way of listening. Multiple-choice options reduce the effort needed to answer, while short written responses leave room for needs I did not anticipate. The artifact’s revision table makes the connection between the feedback and my design decisions visible."]}],["$","p",null,{"children":["This is early progress toward collaboration because I used another educator’s perspective to improve my preparation. Receiving feedback is only one part of a coaching relationship. To demonstrate stronger alignment with 4.3.a and 4.3.d, I need to show how a colleague’s input changes my support and whether that support helps the colleague make an instructional decision."]}]]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"artifact-two","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact Two"]}],["$","h2",null,{"id":"artifact-two","children":["Collaborative Digital Resource Review and Coaching Guide"]}]]}],["$","div",null,{"className":"prose-card","children":[["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.3.b — Content selected with educators."]}]," The guide asks about cultural relevance, readiness, and students’ interests and aspirations. ",["$","strong",null,{"children":["4.3.c — Evidence for tool and adoption decisions."]}]," It supports a joint comparison and a small trial before deciding whether to use or recommend a resource. ",["$","strong",null,{"children":["4.3.d — Personalized planning and modeling."]}]," The educator chooses a goal and the support that would help. These are intended uses to be documented through implementation."]}],["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["I developed this guide as a practical structure for reviewing a digital resource with a colleague. It moves from the educator’s goal to a comparison of options, a tailored support plan, and a follow-up conversation about evidence."]}],["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-3/collaborative-resource-review/","children":["Open the resource-review and coaching guide →"]}]]}],["$","div",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Inside the artifact"]}],["$","p",null,{"children":[["$","strong",null,{"children":["Listen → Review → Decide → Model together → Follow up"]}]]}],["$","p",null,{"children":["Record the educator’s reasoning, the planned change, and what evidence would show whether the change helped."]}]]}],["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["I prepared the guide for use with a willing colleague after identifying an instructional priority. Its questions keep the discussion focused on the lesson and learners. For a history source-analysis activity, for example, we could examine whose perspectives appear in the content, whether the reading demands fit the students, and how the material connects to questions students find meaningful."]}],["$","p",null,{"children":["The comparison includes the current approach so that adopting a new tool is a decision to justify. We would consider the quality of student thinking, accessibility, classroom usability, privacy, and any cost or approval requirements. The colleague could choose a short demonstration, joint planning, or time to practice while I offer feedback. The guide is complete as a planning resource; a colleague trial and follow-up have not yet been documented."]}],["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["Developing the guide helped me define what a useful coaching conversation needs to produce: an agreed goal, reasons for choosing an approach, and a plan for reviewing its effect. It also gives me a way to make my reasoning visible when modeling a strategy and to invite the educator to question or change it."]}],["$","p",null,{"children":["The present evidence is the design of that process. After using it, I would retain the completed comparison, a before-and-after task, and a brief educator reflection. Those records could show a change in planning or practice. Student work or other classroom evidence would be needed to examine the effect on learning."]}]]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"reflection","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional reflection"]}],["$","h2",null,{"id":"reflection","children":["Overall Reflection on Standard 4.3"]}]]}],["$","div",null,{"className":"prose-card portfolio-reflections","children":[["$","p",null,{"children":["As a first-year teacher managing five course preparations, I understand how much a colleague’s time matters. Support needs to begin with a problem the educator wants to address and fit the reality of the classroom. These artifacts help me put that principle into a process: listen, make a decision together, offer useful support, and return to the goal."]}],["$","p",null,{"children":["My current evidence shows responsiveness to feedback and preparation for collaboration. I have not yet demonstrated full competence across this standard. My next stage is to use these resources in a sustained exchange where an educator’s input changes both the lesson and the way I provide support."]}],["$","article",null,{"children":[["$","h3",null,{"children":["4.3.a — Building trust through listening"]}],["$","p",null,{"children":["The needs-analysis feedback reminded me that a question can invite a conversation or limit it. Including choices and room for explanation allows colleagues to describe their own practices. In a coaching conversation, I will summarize what I heard, check that I understood, and let the educator identify the priority. Trust will require follow-through and repeated opportunities to revise our plan."]}]]}],["$","article",null,{"children":[["$","h3",null,{"children":["4.3.b — Choosing content with the educator"]}],["$","p",null,{"children":["A resource that works in my history classroom may need substantial changes for another subject or group of learners. I need the educator’s knowledge of students’ cultural experiences, readiness, interests, and aspirations. Together, we can examine whose perspectives are represented, what background knowledge the content assumes, and whether students see a meaningful connection to their lives or goals. I will document how that discussion changes the content we select."]}]]}],["$","article",null,{"children":[["$","h3",null,{"children":["4.3.c — Making evidence part of adoption"]}],["$","p",null,{"children":["I need to move beyond describing a tool’s features to examining whether it helps students meet the learning goal. A small trial can compare the proposed resource with the current approach using student responses, accessibility observations, and the educator’s experience. We can then decide whether to keep, adapt, or stop using it. Any recommendation to purchase or adopt a resource should explain the evidence and remaining limitations and follow the school’s approval process."]}]]}],["$","article",null,{"children":[["$","h3",null,{"children":["4.3.d — Adapting my support"]}],["$","p",null,{"children":["Personalization applies to the support I provide as well as the lesson we design. One educator may want to watch a brief model; another may prefer to build the task together. I will ask which approach is useful, explain my decisions during modeling, and give the educator a chance to try and adapt the process. At follow-up, I will ask what helped and what I should change. The goal is for the educator to make informed decisions independently."]}]]}]]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"references","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"references","children":["Reference"]}]]}],["$","p",null,{"children":["International Society for Technology in Education. (n.d.). ",["$","a",null,{"href":"https://iste.org/standards/coaches","children":[["$","em",null,{"children":["ISTE Standards for Coaches."]}]]}]," Indicator explanations on this page are paraphrases."]}]]}],["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-2/","children":["Previous: Connected Learner"]}],["$","a",null,{"href":"/standards/4-4/","children":["Next: Learning Designer"]}]]}]]}]]}],"$Lc"]}]
c:["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":"ISTE Coach Standards"}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":"CSUF Educational Technology"}]]}]]}]
