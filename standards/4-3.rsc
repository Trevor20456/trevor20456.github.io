1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to main content"}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","$L6",null,{"className":"brand","href":"/","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":"TA"}],["$","span",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","small",null,{"children":"Secondary Social Science · Educational Technology"}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":"Menu"}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}],["$","main",null,{"id":"main-content","className":"standard43","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["ISTE Coach Standard 4.3"]}],["$","h1",null,{"children":["Collaborator"]}],"\n  ",["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["Coaches establish productive relationships with educators in order to improve instructional practice and learning outcomes."]}],["$","a",null,{"className":"source-link","href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["View the official ISTE Coach Standards ↗"]}]]}],"\n"]}],"\n",["$","nav",null,{"className":"section-jump","aria-label":"On this page","children":[["$","a",null,{"href":"#collaboration-focus","children":["Professional context"]}],["$","a",null,{"href":"#artifact-one","children":["Coaching cycle"]}],["$","a",null,{"href":"#artifact-two","children":["Shared decisions"]}],["$","a",null,{"href":"#reflection","children":["Reflection"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"collaboration-focus","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional practice"]}],["$","h2",null,{"id":"collaboration-focus","children":["Helping a Colleague Teach with Technology"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["As a first-year social sciences teacher at Trona High School, I use technology within the practical demands of teaching several grade levels and courses. A digital activity still has to fit the lesson, make students’ thinking visible, and be manageable for the teacher. Those priorities shape the kind of support I want to offer a colleague: a focused working partnership in which we select a learning goal, examine possible approaches, practice an instructional routine, and return to the evidence together."]}],"\n    ",["$","p",null,{"children":["My Standard 1 artifacts address recognizing effective practice and improving access to digital lessons. Standard 3 examines the work within an individual coaching relationship. The central question here is how I can help an educator make and explain instructional decisions, gain confidence through practice, and retain ownership of the lesson. That requires listening closely, making my own reasoning visible, and adjusting the support when the teacher’s needs or priorities change."]}],"\n    ",["$","p",null,{"children":["I developed two connected artifacts for that purpose. The ",["$","strong",null,{"children":["Collaborative Technology Coaching Cycle"]}]," structures the partnership and teacher learning. The ",["$","strong",null,{"children":["Shared Digital Resource Decision and Lesson Revision Record"]}]," makes the content selection and technology decisions visible. Both use an illustrative history lesson in which students examine historical perspectives, support a claim with evidence, receive focused feedback, and revise an explanation. Google Docs and Google Classroom provide the example setting; the learning and coaching decisions guide their use."]}],"\n  "]}],"\n  ",["$","div",null,{"className":"portfolio-table-wrap","children":[["$","table",null,{"children":["\n    ",["$","caption",null,{"children":["How the two artifacts support the collaboration"]}],"\n    ",["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["Coaching question"]}],["$","th",null,{"scope":"col","children":["Evidence within the artifacts"]}],["$","th",null,{"scope":"col","children":["Indicator"]}]]}]]}],"\n    ",["$","tbody",null,{"children":["\n      ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["How will we work together?"]}],["$","td",null,{"children":["A partnership agreement, educator choice, listening prompts, and a follow-up conversation."]}],["$","td",null,{"children":["4.3.a"]}]]}],"\n      ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["What content fits these learners?"]}],["$","td",null,{"children":["A worked source review that examines perspective, readiness, relevance, and missing voices."]}],["$","td",null,{"children":["4.3.b"]}]]}],"\n      ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["What would justify using this tool?"]}],["$","td",null,{"children":["A comparison of three approaches, a provisional choice, and evidence that could change the decision."]}],["$","td",null,{"children":["4.3.c"]}]]}],"\n      ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["What help does this educator need?"]}],["$","td",null,{"children":["Co-planning, instructional think-alouds, guided rehearsal, independent practice, and adjusted support."]}],["$","td",null,{"children":["4.3.d"]}]]}],"\n    "]}],"\n  "]}]]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-one","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact One"]}],["$","h2",null,{"id":"artifact-one","children":["Collaborative Technology Coaching Cycle"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","h3",null,{"children":["Indicators"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["4.3.a — Respectful coaching relationships:"]}]," Establish trust through shared expectations, genuine listening, and opportunities for the educator to try an unfamiliar strategy. ",["$","strong",null,{"children":["4.3.d — Support tailored to the educator:"]}]," Plan and model technology use around the teacher’s learning goals, experience, and preferred form of assistance."]}],"\n    ",["$","h3",null,{"children":["Description"]}],"\n    ",["$","p",null,{"children":["This resource provides a complete sequence for a coaching meeting and follow-up. It includes a partnership agreement, a jointly defined goal, a model of instructional decision-making, teacher rehearsal, and prompts for reviewing the classroom trial. The worked example focuses on helping an educator use digital comments and revision to strengthen students’ historical reasoning. Its purpose is to make both the teacher’s learning and the coach’s choices visible."]}],"\n    ",["$","p",null,{"children":["The resource contains an original simulated student response, a focused teacher comment, and a stronger revision for rehearsal. These examples give the educator something specific to examine and practice. They also make the difference between giving an answer and prompting a student’s reasoning easier to discuss."]}],"\n    ",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-3/technology-walkthrough/","children":["Read the complete coaching cycle and worked example →"]}]]}],"\n    ",["$","div",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Inside the coaching cycle"]}],["$","h3",null,{"children":["One instructional move, practiced together"]}],["$","p",null,{"children":[["$","strong",null,{"children":["Teacher goal:"]}]," Give a comment that helps a student explain how evidence supports a claim about perspective."]}],["$","p",null,{"children":[["$","strong",null,{"children":["Coach’s model:"]}]," Identify the gap in the reasoning, explain the purpose of the comment, and model a question that leaves the thinking with the student."]}],["$","p",null,{"children":[["$","strong",null,{"children":["Teacher rehearsal:"]}]," Write a comment on a second example, explain its purpose, and decide what a meaningful revision would show."]}]]}],"\n    ",["$","h3",null,{"children":["Implementation"]}],"\n    ",["$","p",null,{"children":["I organized the cycle around decisions that a coach and educator would make together. The opening agreement establishes the focus, the time available, how the teacher prefers to practice, and what will be retained from the conversation. Asking what already works gives the teacher a way to bring existing expertise into the meeting. Asking where a lesson becomes difficult helps keep the support connected to a real instructional concern."]}],"\n    ",["$","p",null,{"children":["The co-planning stage separates the student goal from the teacher goal. Students need to explain a relationship between a source, its perspective, and their claim. The educator needs to practice selecting a productive moment for feedback and writing a comment that prompts that explanation. This distinction gives the coach a precise skill to model and the teacher a way to judge whether the support is useful."]}],"\n    ",["$","p",null,{"children":["I built the demonstration around a think-aloud. The coach explains why a response needs further reasoning, why a particular phrase is selected for a comment, and what the question is intended to help the student reconsider. The educator then tries the same decision on a different response. A short cue can support the attempt, but the educator writes the comment and explains the choice. Independent rehearsal checks whether the teacher can transfer the routine beyond the original example."]}],"\n    ",["$","p",null,{"children":["Two support pathways make personalization concrete. A teacher unfamiliar with the platform can practice the comment-and-reply workflow before connecting it to the lesson. A teacher comfortable with the platform can spend that time evaluating feedback quality and anticipating student responses. Both pathways lead to the same instructional goal, with different amounts and types of assistance."]}],"\n    ",["$","p",null,{"children":["The follow-up begins with the educator’s interpretation of the lesson. The partners compare what they hoped students would do with what the work actually shows, then choose one revision and divide the next tasks. Including a return conversation makes the relationship part of an ongoing process rather than ending support after the demonstration."]}],"\n    ",["$","h3",null,{"children":["Impact"]}],"\n    ",["$","p",null,{"children":["Developing this artifact clarified what I need to contribute as a coach. A useful model includes the reasoning behind an instructional choice. The rehearsal examples required me to specify what helpful feedback should accomplish and how I would recognize the educator’s independent use of the strategy. The resulting resource gives those expectations a visible form."]}],"\n    ",["$","p",null,{"children":["It also helped me address the risk of doing too much for the teacher. When I prepare every step or immediately solve every difficulty, I have fewer opportunities to understand what the educator needs. The cycle deliberately returns control to the educator and includes questions that reveal their reasoning. Its contribution to my developing practice is a more deliberate way to plan, model, listen, and reduce support as the teacher becomes ready."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-two","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact Two"]}],["$","h2",null,{"id":"artifact-two","children":["Shared Digital Resource Decision and Lesson Revision Record"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","h3",null,{"children":["Indicators"]}],"\n    ",["$","p",null,{"children":[["$","strong",null,{"children":["4.3.b — Content selected with educators:"]}]," Consider cultural relevance, developmental readiness, and students’ interests and aspirations. ",["$","strong",null,{"children":["4.3.c — Shared evaluation of content and tools:"]}]," Examine usefulness and evidence before recommending continued use, adoption, or a purchase. The record also supports ",["$","strong",null,{"children":["4.3.d"]}]," by connecting the decision to the educator’s practice and support needs."]}],"\n    ",["$","h3",null,{"children":["Description"]}],"\n    ",["$","p",null,{"children":["This artifact is a completed illustrative decision record accompanied by a reusable review process. It shows how an educator and coach can connect a content choice, a technology choice, and a lesson revision. The history case includes linked primary-source material, questions about the perspectives the sources offer, and a comparison of an existing paper approach, a shared class document, and individual digital responses."]}],"\n    ",["$","p",null,{"children":["The decision record explains the benefits and limitations of each approach. It then identifies a provisional choice, the evidence needed during a small trial, and the conditions that would lead the partners to continue, adapt, or reconsider. This gives the educator a reasoned example to work from, rather than a worksheet consisting only of empty fields."]}],"\n    ",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-3/collaborative-resource-review/","children":["Read the source review, decision matrix, and lesson revision →"]}]]}],"\n    ",["$","div",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["A decision with a reason"]}],["$","h3",null,{"children":["Make individual reasoning visible"]}],["$","p",null,{"children":[["$","strong",null,{"children":["Provisional approach:"]}]," Individual digital responses with a targeted teacher comment and an opportunity to revise."]}],["$","p",null,{"children":[["$","strong",null,{"children":["Reason:"]}]," The educator needs to examine each student’s explanation and respond to a specific gap in reasoning."]}],["$","p",null,{"children":[["$","strong",null,{"children":["Question for the trial:"]}]," Do revisions strengthen the explanation, and can the teacher sustain the feedback routine within the available time?"]}]]}],"\n    ",["$","h3",null,{"children":["Implementation"]}],"\n    ",["$","p",null,{"children":["I developed the record around the educator’s instructional judgment. A technology choice begins with the thinking the teacher wants students to demonstrate. In the example, completion alone is insufficient: students must use details to explain a perspective. That goal becomes the basis for comparing the approaches and deciding what evidence matters."]}],"\n    ",["$","p",null,{"children":["The content review asks what the selected sources can reasonably support. An image, a caption, and a written account may present different kinds of evidence, and none should be treated as a complete account of industrialization. The partners examine who created the material, its intended purpose, whose experience is represented, and whose voice remains absent. They also consider how much historical context students need before drawing a conclusion. These questions make content selection a shared instructional responsibility."]}],"\n    ",["$","p",null,{"children":["I included relevance as something to investigate with the educator. Questions about work, education, community change, and future occupations can offer possible connections, but the teacher’s knowledge of the class must guide which connections are appropriate. Students should be able to choose a meaningful angle without being asked to disclose family circumstances or represent an entire group. The source review therefore connects relevance with respectful choices and careful interpretation."]}],"\n    ",["$","p",null,{"children":["The comparison makes tradeoffs explicit. A shared document may support discussion of different interpretations, while an individual response gives the teacher a clearer view of each student’s initial reasoning. A paper approach can also support the learning goal. The provisional digital choice rests on the usefulness of a focused comment-and-revision exchange. Its value depends on the resulting work and the teacher’s ability to manage that exchange."]}],"\n    ",["$","p",null,{"children":["I paired the choice with a revised prompt and a trial review. The partners look for a claim, relevant evidence, an explanation connecting the two, and a substantive response to feedback. They also consider preparation and feedback time. If the work contains copied summaries or unsupported opinions, the record directs attention to the source context, prompt, and model before attributing the problem to the platform."]}],"\n    ",["$","p",null,{"children":["Finally, I included adoption and procurement as separate decisions. An educator may choose to continue a useful routine with existing approved tools. A request for an additional product would require an unmet need, evidence that the proposed option addresses it, realistic costs and support demands, and the school’s review. The example does not assume that a successful single lesson justifies a broader purchase."]}],"\n    ",["$","h3",null,{"children":["Impact"]}],"\n    ",["$","p",null,{"children":["Creating this record strengthened my ability to explain a technology recommendation in terms another educator can question and revise. The completed comparison required me to acknowledge what each approach supports and what it makes harder. That helps keep my own familiarity with a tool from becoming the only reason for recommending it."]}],"\n    ",["$","p",null,{"children":["The artifact also connects evaluation with a practical next step. A decision is accompanied by a reason, a question to investigate, and evidence that could change the recommendation. Together with the coaching cycle, it gives me a way to support both teacher learning and shared judgment: one artifact organizes how we work and practice; the other records why we select and revise the instructional approach."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"reflection","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional reflection"]}],["$","h2",null,{"id":"reflection","children":["Overall Reflection on Standard 4.3"]}]]}],"\n  ",["$","div",null,{"className":"prose-card portfolio-reflections","children":["\n    ",["$","p",null,{"children":["My experience using technology in my own classroom provides examples I can bring to a coaching conversation. Supporting another educator requires me to examine those examples from the teacher’s perspective. Their familiarity with a tool, students’ needs, available time, and instructional priorities may lead to a different choice. These artifacts helped me work through how to offer useful expertise while preserving the educator’s authority over the lesson."]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.a — Building trust through the work"]}],["$","p",null,{"children":["Trust is demonstrated in the way a coach responds to uncertainty, disagreement, and a lesson that does not go as expected. I included an opening agreement and educator-led reflection so the teacher can explain what matters before I offer solutions. I also need to follow through on the specific assistance I offer. A respectful conversation loses value if the educator is left without the promised model, resource, or follow-up."]}],["$","p",null,{"children":["A central challenge for me is listening long enough to understand a concern before moving into problem-solving. If an educator rejects a shared document, for example, I need to understand whether the concern involves classroom management, preparation time, or the learning task. Each concern calls for a different response. Respecting that reasoning can make it safer for the teacher to try a manageable change."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.b — Bringing different expertise to content selection"]}],["$","p",null,{"children":["As a history teacher, I pay attention to authorship, context, evidence, and perspective. A colleague contributes knowledge of the particular learners and what they are prepared to interpret. Selecting content together combines those forms of expertise. It also helps avoid assuming that a resource is appropriate simply because it is visually engaging or comes from a credible collection."]}],["$","p",null,{"children":["I need to consider both what a source includes and what it leaves out. A short source set may support a focused question while still requiring an explicit acknowledgment of missing perspectives. Student interests and aspirations can help shape the question, but those connections should emerge through the educator’s knowledge and student choice. The content review gives this conversation a concrete place in the planning process."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.c — Being willing to revise a recommendation"]}],["$","p",null,{"children":["My familiarity with Google tools can help me model their use, but it can also make them feel like the obvious choice. The comparison record requires a stronger explanation: what does this option contribute to the agreed goal, what does it demand from the teacher, and what would convince us to choose differently? The existing approach remains a legitimate option in that discussion."]}],["$","p",null,{"children":["I also need to distinguish evidence of participation from evidence of learning. A submitted document shows completion; a stronger explanation after feedback may show progress on the intended task. Even that improvement needs careful interpretation because the prompt, model, and teacher assistance also influence the result. Several uses, educator feedback, and practical constraints would provide a firmer basis for sustained adoption than one successful trial."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.d — Supporting transfer and independence"]}],["$","p",null,{"children":["Personalization involves adjusting the substance of the support as well as its pace. A teacher learning the comment feature may need a short technical rehearsal. A teacher who already uses comments may need to examine whether the questions lead students to reconsider their reasoning. The two pathways allow the same instructional goal to be approached from different starting points."]}],["$","p",null,{"children":["I want the educator to be able to use the strategy with another lesson and explain the decisions independently. The rehearsal therefore asks the teacher to work with a new response, while the follow-up examines what happened in the classroom. My own coaching would need revision if I dominated the model, gave too many prompts, or did not leave enough time for the teacher to practice."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["Current evidence and continued growth"]}],["$","p",null,{"children":["The linked artifacts are complete educator resources, and the worked cases are illustrative. They document my preparation, design decisions, and developing understanding of collaboration; they do not establish a completed coaching cycle with a colleague or measured gains in student learning. My next evidence of growth needs to come from using the cycle with an educator and retaining the agreed goal, the teacher’s revised task, and their feedback on the support."]}],["$","p",null,{"children":["I would evaluate that experience with the educator by asking whether the support addressed the chosen concern, what the teacher can now do independently, and what student work reveals about the lesson. We would then select a next step together. That follow-through connects these resources to the continuing professional relationship at the center of Standard 4.3."]}]]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"references","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"references","children":["References"]}]]}],"\n  ",["$","p",null,{"children":["International Society for Technology in Education. (n.d.). ",["$","a",null,{"href":"https://iste.org/standards/coaches","children":[["$","em",null,{"children":["ISTE Standards for Coaches."]}]]}]," Indicator explanations are paraphrased; the opening standard description is quoted."]}],"\n  ",["$","p",null,{"children":["Google. (n.d.). ",["$","a",null,{"href":"https://support.google.com/docs/answer/65129?co=GENIE.Platform%3DDesktop&hl=en","children":[["$","em",null,{"children":["Use comments, action items, & emoji reactions."]}]]}]," Google Docs Editors Help."]}],"\n  ",["$","p",null,{"children":["Google. (n.d.). ",["$","a",null,{"href":"https://support.google.com/edu/classroom/answer/6020265?co=GENIE.Platform%3DDesktop&hl=en","children":[["$","em",null,{"children":["Create an assignment."]}]]}]," Google Classroom Help."]}],"\n  ",["$","p",null,{"children":["Historical source links and selection notes appear in the ",["$","a",null,{"href":"/artifacts/standard-4-3/collaborative-resource-review/","children":["Shared Digital Resource Decision and Lesson Revision Record"]}],"."]}],"\n"]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-2/","children":["Previous: Connected Learner"]}],["$","a",null,{"href":"/standards/4-4/","children":["Next: Learning Designer"]}]]}],"\n"]}]]}],"$Lc"]}]
