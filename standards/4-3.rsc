0:{"__route":"route:/standards/4-3/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","layout:/":[[[["$","link","css:/assets/index-D_4IDysc.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-D_4IDysc.css","data-rsc-css-href":"/assets/index-D_4IDysc.css"}],"$undefined"],["$","html",null,{"lang":"en","children":["$","body",null,{"children":["$","$L2",null,{}]}]}]],null],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1rm153ghdic6n","deploymentVersion":"5f1be360-f267-47da-80ee-f7b4a1117ae1","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null},"page:/standards/4-3/":"$L1","route:/standards/4-3/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Collaborator | Trevor Arcadipane"}],["$","meta","1",{"name":"description","content":"ISTE Coach Standard 4.3: helping educators use classroom technology through modeling, practice, and collaborative resource decisions."}],["$","link","2",{"rel":"shortcut icon","href":"/favicon.svg"}],["$","link","3",{"rel":"icon","href":"/favicon.svg"}],["$","meta","4",{"name":"codex-preview","content":"development"}],["$","link","standard43-css",{"rel":"stylesheet","href":"/assets/standard43.css?v=20260926-expanded"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L3",null,{"segmentMap":{"children":["standards","4-3"]},"children":["$","$L4",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L5",null,{"children":["$","$L3",null,{"segmentMap":{"children":[]},"children":["$","$L4",null,{"id":"page:/standards/4-3/"}]}]}]}]}]]}
