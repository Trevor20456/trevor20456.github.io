1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to main content"}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","$L6",null,{"className":"brand","href":"/","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":"TA"}],["$","span",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","small",null,{"children":"Secondary Social Science · Educational Technology"}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":"Menu"}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}],["$","main",null,{"id":"main-content","className":"standard43","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":[["$","p",null,{"className":"eyebrow","children":["ISTE Coach Standard 4.3"]}],["$","h1",null,{"children":["Collaborator"]}],["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["Coaches establish productive relationships with educators in order to improve instructional practice and learning outcomes."]}],["$","a",null,{"className":"source-link","href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["View the official ISTE Coach Standards ↗"]}]]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"collaboration-focus","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional practice"]}],["$","h2",null,{"id":"collaboration-focus","children":["Helping Educators Use Classroom Technology"]}]]}],["$","div",null,{"className":"prose-card","children":[["$","p",null,{"children":["My focus for Standard 4.3 is helping another educator use classroom technology in a way that supports a clear learning goal. As a first-year social sciences teacher, I understand the value of practical assistance that fits an existing lesson and gives the teacher time to learn. Effective support combines a respectful working relationship, clear modeling, and opportunities for the educator to practice and make decisions independently."]}],["$","p",null,{"children":["I developed two complementary resources for this work: a technology walkthrough that moves from demonstration to teacher practice, and a guide for selecting digital tools and content together. Both keep the educator’s goals and knowledge of students at the center of the process."]}]]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-one","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact One"]}],["$","h2",null,{"id":"artifact-one","children":["Classroom Technology Walkthrough and Teacher Practice Guide"]}]]}],["$","div",null,{"className":"prose-card","children":["\n",["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.3.a — Trust and professional relationships."]}]," The guide begins with the educator’s goal, respects existing knowledge, and makes room for questions and practice. ",["$","strong",null,{"children":["4.3.d — Personalized planning and modeling."]}]," It provides a sequence for explaining a technology routine, modeling instructional decisions, and adapting support to the educator’s needs."]}],"\n",["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["This guide supports a focused session in which an educator learns one classroom technology routine. It includes a worked assignment example, a model-and-practice sequence, and a rehearsal check. Google Classroom serves as an illustrative platform for showing how the process can work."]}],"\n",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-3/technology-walkthrough/","children":["View the technology walkthrough and teacher practice guide →"]}]]}],"\n",["$","div",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Support sequence"]}],["$","p",null,{"children":[["$","strong",null,{"children":["Choose a goal → Watch a model → Try it together → Practice independently → Reflect"]}]]}],["$","p",null,{"children":["The educator practices the routine and explains the instructional choices behind it."]}]]}],"\n",["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["I designed the guide around one manageable task: preparing a digital assignment that students can understand, access, and complete. The opening conversation establishes what the educator already knows and which part of the process needs support. This allows the model to focus on a relevant difficulty instead of covering every feature of an application."]}],"\n",["$","p",null,{"children":["The example connects the technology steps to their instructional purpose. A clear title identifies the task, directions explain the thinking students need to do, and the response format makes their understanding visible. During the model, the coach explains these decisions and invites the educator to suggest changes. The teacher then practices with support and repeats the routine with a task of their own."]}],"\n",["$","p",null,{"children":["I included prompts for adjusting the pace, deciding how much guidance is useful, and identifying what the educator can do independently. The example is a teaching model within the resource, rather than a record of a particular colleague’s lesson or a completed coaching session."]}],"\n",["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["Creating the walkthrough helped me distinguish explaining a tool from supporting another teacher’s learning. A successful demonstration needs a clear purpose, a manageable sequence, and a chance for the educator to apply it. The completed resource makes those elements explicit and gives me a structure for providing consistent support."]}],"\n",["$","p",null,{"children":["The guide also makes teacher independence a visible goal. The rehearsal check asks whether the educator can carry out the routine and explain why it fits the lesson. This provides a more useful basis for follow-up than simply asking whether the demonstration was clear."]}],"\n"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-two","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact Two"]}],["$","h2",null,{"id":"artifact-two","children":["Collaborative Digital Resource Review and Coaching Guide"]}]]}],["$","div",null,{"className":"prose-card","children":["\n",["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.3.b — Relevant content selected with educators."]}]," The review addresses cultural representation, developmental appropriateness, and students’ interests and aspirations. ",["$","strong",null,{"children":["4.3.c — Evidence for tool and adoption decisions."]}]," It compares options against the learning goal and identifies evidence for continued use or a purchase recommendation. ",["$","strong",null,{"children":["4.3.d — Personalized support."]}]," The educator chooses the type of planning, modeling, or practice that will be most useful."]}],"\n",["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["This five-step guide helps an educator and coach choose a digital resource, plan its use, and review its usefulness. It includes a comparison worksheet, a support plan, follow-up prompts, and an illustrative history example."]}],"\n",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-3/collaborative-resource-review/","children":["View the collaborative resource-review and coaching guide →"]}]]}],"\n",["$","div",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Shared decisions"]}],["$","p",null,{"children":[["$","strong",null,{"children":["Learning goal · Content and access · Resource choice · Support · Evidence"]}]]}],["$","p",null,{"children":["Compare each option with the existing approach and explain the reason for the choice."]}]]}],"\n",["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["I organized this resource around the decisions that accompany classroom technology use. The educator first identifies a learning goal and a difficulty in the current task. The comparison then examines the quality of the content, what students will think and do, access requirements, preparation time, and any cost or school approval requirements."]}],"\n",["$","p",null,{"children":["I included cultural relevance and student interests because selecting a digital resource also means selecting what learners encounter. The guide asks whose perspectives appear, what background knowledge the material assumes, and how the task connects to students’ experiences or aspirations. These judgments depend on the educator’s knowledge of the class."]}],"\n",["$","p",null,{"children":["The final sections connect the resource choice to a support plan and evidence of usefulness. The educator can choose a short model, joint planning, or rehearsal with feedback. The worked history example demonstrates this decision process and identifies evidence to collect during a trial without presenting hypothetical results as actual findings."]}],"\n",["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["Developing the review guide strengthened my understanding of technology support as a shared instructional decision. It gives both participants a way to explain why a resource fits the goal, identify concerns, and decide what would justify keeping or changing the approach. Including the current method in the comparison also makes it possible to recognize when an existing routine remains the better choice."]}],"\n",["$","p",null,{"children":["The two artifacts serve different purposes. The walkthrough explains how to help an educator learn a routine; this guide examines whether the routine and its content are appropriate for the lesson. Together, they connect the technical steps with the instructional reasoning that makes the technology useful."]}],"\n"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"reflection","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional reflection"]}],["$","h2",null,{"id":"reflection","children":["Overall Reflection on Standard 4.3"]}]]}],["$","div",null,{"className":"prose-card portfolio-reflections","children":["\n",["$","p",null,{"children":["My classroom use of digital assignments gives me a practical starting point for supporting other educators. It also reminds me that knowing how to use a tool is only one part of coaching. Another teacher needs space to explain a concern, question a suggestion, and practice in a way that fits their experience. These resources helped me organize that support around purposeful technology use."]}],"\n",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.a — Establishing a respectful partnership"]}],["$","p",null,{"children":["I built choice and listening into the walkthrough because an educator should feel comfortable asking questions and trying an unfamiliar routine. Beginning with what already works recognizes the teacher’s expertise. Agreeing on one goal and checking the pace keeps the support manageable. Trust also depends on responding respectfully when the educator prefers a different approach and following through on the assistance offered."]}]]}],"\n",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.b — Selecting content with the educator"]}],["$","p",null,{"children":["The resource-review guide makes the educator’s knowledge of students part of content selection. A useful resource needs to fit learners’ readiness, represent people and perspectives respectfully, and connect with interests or aspirations that matter to them. I can contribute questions about the design and technology, while the educator contributes knowledge of the class. That shared judgment is central to this indicator."]}]]}],"\n",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.c — Evaluating usefulness and adoption"]}],["$","p",null,{"children":["I designed the comparison to examine what the technology adds to the learning task and what evidence would demonstrate that contribution. Access, clarity, student reasoning, and the teacher’s preparation demands all affect usefulness. A trial can inform a decision to continue, adapt, or stop using a resource. A purchase or wider adoption recommendation also needs a clear rationale, consideration of cost, and the appropriate school approval."]}]]}],"\n",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.d — Matching support to the teacher"]}],["$","p",null,{"children":["The walkthrough makes planning, modeling, and teacher practice distinct parts of support. An educator who is unfamiliar with a routine may benefit from a short demonstration and guided practice. An educator who already knows the platform may need help refining the learning task. Explaining my choices, inviting the teacher to adapt them, and checking independent practice helps keep the support responsive to the individual."]}]]}],"\n",["$","p",null,{"children":["These artifacts demonstrate the design of teacher-support resources and the reasoning behind them. They do not establish measured changes in another educator’s practice or student achievement. My continued growth involves applying the resources with a colleague, retaining the agreed goal and revised task, and using the educator’s reflection and classroom evidence to evaluate the support. This connects my preparation to the ongoing relationships and learning outcomes emphasized by Standard 4.3."]}],"\n"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"references","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"references","children":["References"]}]]}],["$","p",null,{"children":["International Society for Technology in Education. (n.d.). ",["$","a",null,{"href":"https://iste.org/standards/coaches","children":[["$","em",null,{"children":["ISTE Standards for Coaches."]}]]}]," Indicator explanations on this page are paraphrases."]}],["$","p",null,{"children":["Google. (n.d.). ",["$","a",null,{"href":"https://support.google.com/edu/classroom/answer/6020265?co=GENIE.Platform%3DDesktop&hl=en","children":[["$","em",null,{"children":["Create an assignment."]}]]}]," Google Classroom Help. Platform reference for the illustrative walkthrough."]}]]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-2/","children":["Previous: Connected Learner"]}],["$","a",null,{"href":"/standards/4-4/","children":["Next: Learning Designer"]}]]}],"\n"]}]]}],"$Lc"]}]
c:["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":"ISTE Coach Standards"}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":"CSUF Educational Technology"}]]}]]}]
