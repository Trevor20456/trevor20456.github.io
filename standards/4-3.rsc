1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to main content"}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","$L6",null,{"className":"brand","href":"/","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":"TA"}],["$","span",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","small",null,{"children":"Secondary Social Science · Educational Technology"}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":"Menu"}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"$undefined","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"page","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}],["$","main",null,{"id":"main-content","className":"standard43","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":[["$","p",null,{"className":"eyebrow","children":["ISTE Coach Standard 4.3"]}],["$","h1",null,{"children":["Collaborator"]}],["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["Coaches establish productive relationships with educators in order to improve instructional practice and learning outcomes."]}],["$","a",null,{"className":"source-link","href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["View the official ISTE Coach Standards ↗"]}]]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"collaboration-focus","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional practice"]}],["$","h2",null,{"id":"collaboration-focus","children":["Beginning with the Educator’s Priorities"]}]]}],["$","div",null,{"className":"prose-card","children":[["$","p",null,{"children":["Collaboration begins with understanding what another educator wants students to learn and what makes that work challenging. As a first-year social sciences teacher at Trona High School, I value support that respects teachers’ experience, time, and knowledge of their students. My work for this standard connects a professional discussion with an educator resource: the exchange helped clarify how I listen and respond, and the coaching guide applies that reasoning to decisions about digital resources and instructional support."]}]]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-one","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact One"]}],["$","h2",null,{"id":"artifact-one","children":["Professional Dialogue: EDEL 590 Discussion 5.1"]}]]}],["$","div",null,{"className":"prose-card","children":["\n",["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.3.a — Trust and professional relationships."]}]," The discussion illustrates my development through listening to another educator’s questions, considering a different perspective, and explaining my reasoning. ",["$","strong",null,{"children":["Connection to 4.3.d — Personalized support."]}]," My response explains how educators’ existing practices and needs should influence the support offered to them."]}],"\n",["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["This artifact is a portfolio account of my EDEL 590 Discussion 5.1 contribution, the questions raised by a classmate and my instructor, and my response and reflection. The needs-analysis assignment provided the topic for the exchange; the professional dialogue is the focus of this Standard 4.3 artifact."]}],"\n",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-3/professional-dialogue/","children":["View the discussion exchange and reflection →"]}]]}],"\n",["$","div",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Discussion evidence"]}],["$","ol",null,{"children":[["$","li",null,{"children":["My explanation of a formative-assessment focus."]}],["$","li",null,{"children":["Questions about response format and tailoring support."]}],["$","li",null,{"children":["My reasoning about educator choice and instructional needs."]}]]}]]}],"\n",["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["In the discussion, I described a focus on helping Trona teachers use brief formative assessments to identify student needs and adjust instruction. A classmate asked whether my first question about checking understanding would help determine which tools to feature and whether it would use an open response or multiple-choice format. My instructor also asked about the format and noted the value of keeping the survey short."]}],"\n",["$","p",null,{"children":["My response rationale addresses both the format and its purpose. Select-all options with an additional response choice identify familiar practices, while short written responses give educators room to describe their circumstances. I connect those choices to tailoring examples and support around what colleagues already do. This reasoning makes the relationship between listening and planning more specific."]}],"\n",["$","p",null,{"children":["I approached the questions as an opportunity to examine my reasoning. Identifying a familiar tool can help make an example practical, but the instructional need still determines what the support should accomplish. A colleague who needs help interpreting responses has a different priority from one who needs help designing a useful question. The discussion helped me express that distinction and consider how to confirm my understanding with the educator."]}],"\n",["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["The exchange sharpened my explanation of how educator input should guide professional support. The classmate’s question connected the format of a question to the decisions made afterward, while my instructor’s comment reinforced the importance of keeping participation manageable. Considering those ideas together clarified how brief choices and written responses serve different purposes."]}],"\n",["$","p",null,{"children":["For Standard 4.3, this artifact shows my responsiveness within a professional conversation and my developing reasoning about personalized support. The documented effect is on the clarity of my own approach. The exchange also informs the coaching guide below, which turns the same principles into prompts for listening, shared decisions, and follow-up."]}],"\n"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-two","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact Two"]}],["$","h2",null,{"id":"artifact-two","children":["Collaborative Digital Resource Review and Coaching Guide"]}]]}],["$","div",null,{"className":"prose-card","children":["\n",["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.3.b — Content selected with educators."]}]," The guide addresses cultural relevance, developmental appropriateness, and students’ interests and aspirations. ",["$","strong",null,{"children":["4.3.c — Evidence for tool and adoption decisions."]}]," It structures a joint comparison of resources and the evidence needed to justify their use. ",["$","strong",null,{"children":["4.3.d — Personalized planning and modeling."]}]," It connects an educator’s goal to a chosen form of support and a follow-up reflection."]}],"\n",["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["I created this five-step guide to apply the discussion’s emphasis on educator priorities to a collaborative review of a digital resource. It includes a comparison worksheet, a support plan, a follow-up record, and an illustrative history example showing how the process can be applied."]}],"\n",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-3/collaborative-resource-review/","children":["View the collaborative resource-review and coaching guide →"]}]]}],"\n",["$","div",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Artifact contents"]}],["$","p",null,{"children":[["$","strong",null,{"children":["Listen → Review → Decide → Personalize support → Follow up"]}]]}],["$","p",null,{"children":["A shared goal, evidence for the resource choice, a practical support plan, and a record of what changes."]}]]}],"\n",["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["I organized the guide so that the educator’s goal comes before the resource comparison. The opening prompts ask about the existing lesson, what works, the obstacle the educator wants to address, and what successful learning would look like. These questions make the educator’s knowledge central to the review."]}],"\n",["$","p",null,{"children":["The comparison examines learning demands, content quality, cultural representation, accessibility, and practical requirements. I included the current approach alongside two candidate resources so that the decision has a meaningful point of comparison. The guide asks for evidence and unresolved questions, including whether the content reflects students’ interests and aspirations. Cost, account requirements, and school approval are included because those factors affect whether a resource is practical to adopt."]}],"\n",["$","p",null,{"children":["The support section offers modeling, joint planning, and rehearsal with feedback. I added a worked history example to make the process concrete while clearly identifying it as illustrative. The final section distinguishes changes in an educator’s planning or instruction from evidence about student learning. This gives the review a clear purpose beyond selecting a tool."]}],"\n",["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["Developing the guide helped me translate collaboration into specific decisions and responsibilities. A discussion needs to identify the goal, explain the resource choice, establish what support is useful, and determine what evidence will be reviewed. The completed guide provides a consistent structure for those decisions while allowing the educator to shape the content and pace of the conversation."]}],"\n",["$","p",null,{"children":["The worked example also makes my instructional reasoning visible: resource selection depends on the learning task, the students, and the evidence needed to judge usefulness. The artifact demonstrates my ability to design a collaborative process that connects relevance, resource evaluation, and personalized support. Its value as a professional resource is the clear connection between an educator’s priority and each decision that follows."]}],"\n"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"reflection","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional reflection"]}],["$","h2",null,{"id":"reflection","children":["Overall Reflection on Standard 4.3"]}]]}],["$","div",null,{"className":"prose-card portfolio-reflections","children":["\n",["$","p",null,{"children":["Managing five course preparations has made me aware of how quickly a useful idea can become another demand on a teacher’s time. Collaboration needs to make instructional work more manageable and purposeful. These artifacts helped me develop a process that begins with the educator’s priorities, makes the reasoning behind a recommendation clear, and leaves room for the educator to adapt the approach."]}],"\n",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.a — Building trust through listening"]}],["$","p",null,{"children":["The professional discussion showed me the value of taking a colleague’s question seriously and using it to reconsider my own decisions. Explaining why I selected a particular format required me to connect the choice to an educator’s needs. That response matters because respectful collaboration includes making my reasoning available for others to question, listening to their concerns, and being willing to adjust my approach. Receiving feedback through coursework is one part of my development; a sustained coaching relationship also requires listening, follow-through, and responsiveness over time."]}]]}],"\n",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.b — Choosing relevant content together"]}],["$","p",null,{"children":["The resource-review guide reflects my understanding that relevance involves more than an interesting topic or an appealing presentation. The content needs to fit the students’ readiness, represent people and perspectives respectfully, and connect with interests or aspirations that matter to them. An educator’s knowledge of the class is essential to those judgments. Including these questions in the guide helps make cultural relevance and developmental fit part of the selection process."]}]]}],"\n",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.c — Justifying resource decisions with evidence"]}],["$","p",null,{"children":["I built the comparison around the learning goal and the current instructional approach. This helps distinguish a useful resource from one that simply adds features or requires a new routine. The guide asks what students will think and do, what barriers may arise, and what evidence would support continued use. Including the option to adapt, retain the existing approach, or stop a trial makes the decision responsive to evidence. The same reasoning is necessary when recommending adoption or a purchase."]}]]}],"\n",["$","article",null,{"children":[["$","h3",null,{"children":["4.3.d — Personalizing instructional support"]}],["$","p",null,{"children":["The two artifacts connect my reasoning about educator needs to a practical support process. My reflection on the discussion explains why colleagues’ existing practices should influence the examples and assistance offered. The coaching guide applies that principle through a shared goal and a choice of demonstration, planning session, or rehearsal. Modeling is most useful when the reasoning behind an instructional choice is explained and the educator has an opportunity to question and adapt it. I designed the follow-up prompts to examine both the lesson and the usefulness of the support itself."]}]]}],"\n",["$","p",null,{"children":["My strongest evidence for this standard is participation in professional dialogue, reflection on the questions raised, and the design of a resource that applies that learning. These artifacts do not establish the effects of a completed coaching cycle or changes in student achievement. My continuing professional goal is to document that application through an agreed instructional goal, a jointly reviewed resource, a revised task, and the educator’s reflection. That evidence will help me evaluate how effectively my support strengthens another educator’s practice."]}],"\n",["$","p",null,{"children":["Standard 4.3 has sharpened my understanding of the coach’s role. The quality of a recommendation depends on how well I understand the educator’s goal, how clearly we examine the options, and how thoughtfully I respond to what the educator needs. These principles guide the resources I have created and the collaborative practice I am developing."]}],"\n"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"references","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"references","children":["References and Artifact Source"]}]]}],["$","p",null,{"children":["Arcadipane, T. (2026, September). ",["$","em",null,{"children":["Discussion 5.1: Needs analysis"]}]," [Course discussion and portfolio reflection]. EDEL 590, California State University, Fullerton. The linked portfolio account paraphrases the discussion points."]}],["$","p",null,{"children":["International Society for Technology in Education. (n.d.). ",["$","a",null,{"href":"https://iste.org/standards/coaches","children":[["$","em",null,{"children":["ISTE Standards for Coaches."]}]]}]," Indicator explanations on this page are paraphrases."]}]]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-2/","children":["Previous: Connected Learner"]}],["$","a",null,{"href":"/standards/4-4/","children":["Next: Learning Designer"]}]]}],"\n"]}]]}],"$Lc"]}]
c:["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":"ISTE Coach Standards"}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":"CSUF Educational Technology"}]]}]]}]
