1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to main content"}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","$L6",null,{"className":"brand","href":"/","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":"TA"}],["$","span",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","small",null,{"children":"Secondary Social Science · Educational Technology"}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":"Menu"}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"page","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"$undefined","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"page","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"$undefined","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}],["$","main",null,{"id":"main-content","className":"standard42","children":[["$","link",null,{"rel":"stylesheet","href":"/assets/standard42.css"}],["$","div",null,{"className":"page-wrap","children":[["$","header",null,{"className":"page-intro","children":[["$","p",null,{"className":"eyebrow","children":"ISTE Coach Standard 4.2"}],["$","h1",null,{"children":"Connected Learner"}],["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":"Coaches model the ISTE Standards for Students and Educators, deepen their expertise through professional learning, and improve their coaching through networks and shared reflection."}],["$","a",null,{"href":"https://iste.org/standards/coaches","className":"text-link","children":"View the official ISTE Coach Standards"}]]}]]}],["$","section",null,{"className":"content-section artifact-section","aria-labelledby":"artifact-one","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Artifact One"}],["$","h2",null,{"id":"artifact-one","children":"National Archives Informal PD Reflection"}]]}],["$","div",null,{"className":"prose-card","children":[["$","h3",null,{"children":"Indicator"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"4.2.a — Deepen Expertise Through Professional Learning."}]," This artifact documents learning and preparation to model the ISTE Standards with educators."]}]]}],["$","h3",null,{"children":"Description"}],["$","p",null,{"children":"I created this seven-slide reflection for EDEL 522 in summer 2026 after completing three recorded National Archives educator webinars. It documents my learning about teaching the Constitution with political cartoons, comparing sources about Vietnam, and using DocsTeach to support historical inquiry."}],["$","div",null,{"className":"portfolio-file-links","children":[["$","a",null,{"href":"/artifacts/standard-4-2/national-archives-reflection.pptx","className":"text-link","download":"","children":"Download the complete reflection (PowerPoint)"}]]}],["$","div",null,{"className":"portfolio-evidence-grid","children":[["$","figure",null,{"className":"portfolio-evidence","children":[["$","a",null,{"href":"/artifacts/standard-4-2/pd-webinars.png","children":["$","img",null,{"src":"/artifacts/standard-4-2/pd-webinars.png","alt":"Webinar selections: Teaching the Constitution with Political Cartoons, Remembering Vietnam: The Road to War, and Remembering Vietnam: The Road Through War. Total viewing time: 2 hours, 9 minutes, 22 seconds.","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Figure 1. Webinar selections and viewing time from my EDEL 522 reflection."}]]}],["$","figure",null,{"className":"portfolio-evidence","children":[["$","a",null,{"href":"/artifacts/standard-4-2/pd-participation.png","children":["$","img",null,{"src":"/artifacts/standard-4-2/pd-participation.png","alt":"Reflection slide describing independent participation: pausing recorded webinars, answering prompts, comparing private memos with public statements, and exploring DocsTeach activities.","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Figure 2. My participation in the recorded learning activities."}]]}]]}],["$","h3",null,{"children":"Implementation"}],["$","p",null,{"children":"I originally planned to complete Code.org’s AI 101, then chose the National Archives webinars because they fit the history and government courses I would teach at Trona High School. The three sessions listed in Figure 1 totaled 2 hours, 9 minutes, and 22 seconds."}],["$","p",null,{"children":"I paused the recordings to answer the presenters’ questions, compared private memos with public statements, and explored DocsTeach activities. I used the document-analysis process of meeting a source, observing it, making sense of it, and using it as evidence. This was completed independent learning from recorded expert instruction; there was no live interaction with the presenters."}],["$","h3",null,{"children":"Impact"}],["$","p",null,{"children":"The experience helped me plan digital activities around historical reasoning. Political cartoons can support interpretation of constitutional principles, while comparing private and public documents helps students examine audience and purpose. I connect these applications to the ISTE Student role of Knowledge Constructor and the Educator role of Designer."}],["$","p",null,{"children":"This shows progress toward 4.2.a through professional learning and instructional planning. To extend that learning to colleagues, I plan to model one source-analysis routine and explain why I chose its sources and prompts. The artifact does not yet document this modeling or its effect on another educator’s practice."}]]}]]}],["$","section",null,{"className":"content-section artifact-section","aria-labelledby":"artifact-two","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Artifact Two"}],["$","h2",null,{"id":"artifact-two","children":"Supporting Our iMakers Handout"}]]}],["$","div",null,{"className":"prose-card","children":[["$","h3",null,{"children":"Indicators"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"4.2.a — Deepen Expertise Through Professional Learning."}]," The handout applies course learning to guidance for educators."]}],["$","li",null,{"children":[["$","strong",null,{"children":"4.2.b and 4.2.c"}]," — Areas for further development through professional exchange, a shared goal, and reflection."]}]]}],["$","h3",null,{"children":"Description"}],["$","p",null,{"children":"I created this visual handout for EDEL 590 in fall 2026 after studying the iMaker profile and instructional practices in Green et al. (2020). It introduces student creation, Universal Design for Learning, and instructional choice through the example of a digital history museum exhibit."}],["$","h3",null,{"children":"Implementation"}],["$","p",null,{"children":"The completed stage is the design of a resource for course peers and colleagues. I organized the handout around a history example: students investigate a question, analyze sources, create explanations, and revise after peer feedback. Its invitation to bring an existing lesson to a PD session is a proposed next step; a facilitated session and educator feedback are not documented here."}],["$","p",null,{"children":"For an initial conversation, I will ask one educator which part could improve a lesson they already teach and what their students would need to participate. We can then select one manageable change together."}],["$","h3",null,{"children":"Impact"}],["$","p",null,{"children":"Creating the handout helped me explain purposeful technology use through a concrete example. Source analysis and student-created explanations connect to the ISTE Student roles of Knowledge Constructor and Creative Communicator, while planning the experience and supporting revision connect to the Educator roles of Designer and Facilitator. The handout supports progress toward 4.2.a and provides a starting point for a coaching conversation. Its impact on another educator’s practice still needs to be documented."}],["$","figure",null,{"className":"portfolio-evidence portfolio-handout","children":[["$","a",null,{"href":"/artifacts/standard-4-2/supporting-our-imakers.png","children":["$","img",null,{"src":"/artifacts/standard-4-2/supporting-our-imakers.png","alt":"More Than Screen Time: Supporting Our iMakers. A handout connecting student creation, Universal Design for Learning, instructional choice, and the ISTE Standards through a digital history museum project. The proposed PD invitation is a next step.","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Figure 3. More Than Screen Time: Supporting Our iMakers, prepared for discussion with educators."}]]}],["$","div",null,{"className":"portfolio-file-links","children":[["$","a",null,{"href":"/artifacts/standard-4-2/supporting-our-imakers.png","className":"text-link","children":"View the full-size handout"}],["$","a",null,{"href":"/artifacts/standard-4-2/supporting-our-imakers.png","className":"text-link","download":"","children":"Download the handout (PNG)"}]]}]]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"overall-reflection","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"overall-reflection","children":"Overall Reflection on Standard 4.2"}],["$","p",null,{"children":"These artifacts show progress, but I have not yet met full competence in this standard."}],["$","p",null,{"children":"As a first-year teacher managing five course preparations, I value learning that fits an actual instructional need. Choosing the National Archives webinars reinforced the importance of relevance and choice when asking colleagues to learn something new. Developing the iMakers handout helped me focus on what students would think, create, and revise. Both experiences inform the kind of practical support I want to offer educators."}]]}],["$","div",null,{"className":"portfolio-reflections","children":[["$","article",null,{"children":[["$","h3",null,{"children":"4.2.a — Deepen Expertise Through Professional Learning"}],["$","p",null,{"children":"I am making progress toward this indicator. My strongest evidence is selecting relevant learning and connecting it to the ISTE Standards for Students and Educators. I need to carry that preparation into modeling with a colleague. I will explain one source-analysis activity, ask the educator to examine its instructional choices, and record what their response helps me improve."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"4.2.b — Participate in Professional Learning Networks"}],["$","p",null,{"children":"I am working toward this indicator. Recorded webinars supported my learning but provided no reciprocal professional exchange. Through my CSUF learning community, I plan to share the handout, ask how peers would adapt its example, and discuss the tools, research, or classroom experiences behind their suggestions. I will respond and revise the resource, retaining the exchange as evidence. Continuing these conversations will help me stay current with changes in technology and teaching."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"4.2.c — Commit to Continuous Improvement"}],["$","p",null,{"children":"I am working toward this indicator. With a willing educator, I will agree on a lesson goal and what success would look like. A possible focus is helping students support an interpretation with evidence while providing reading supports. We will choose the goal together, review the revised task, and reflect on what I should change in my coaching. I will save the agreed goal, the revision, and our reflection, distinguishing feedback on the design from any later classroom results."}]]}]]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"references","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"references","children":"References"}]]}],["$","div",null,{"className":"portfolio-references","children":[["$","p",null,{"children":["Green, T. D., Donovan, L. C., & Green, J. P. (2020). ",["$","em",null,{"children":"Making technology work in schools: How PK-12 educators can foster digital-age learning."}]," Routledge."]}],["$","p",null,{"children":["International Society for Technology in Education. (n.d.). ",["$","a",null,{"href":"https://iste.org/standards/coaches","children":["$","em",null,{"children":"ISTE Standards for Coaches"}]}],"."]}]]}]]}],["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-1/","children":"Previous: Change Agent"}],["$","a",null,{"href":"/standards/4-3/","children":"Next: Collaborator"}]]}]]}]]}],"$Lb"]}]
b:["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":"ISTE Coach Standards"}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":"CSUF Educational Technology"}]]}]]}]
