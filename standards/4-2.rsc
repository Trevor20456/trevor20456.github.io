1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"Skip to main content"}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":"↗"}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","$L6",null,{"className":"brand","href":"/","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":"TA"}],["$","span",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","small",null,{"children":"Secondary Social Science · Educational Technology"}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":"Menu"}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"page","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"$undefined","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","$L6",null,{"href":"/","aria-current":"$undefined","children":"Introduction"}],[["$","$L6","4-1",{"href":"/standards/4-1","aria-current":"$undefined","title":"4.1 Change Agent","children":"Change Agent"}],["$","$L6","4-2",{"href":"/standards/4-2","aria-current":"page","title":"4.2 Connected Learner","children":"Connected Learner"}],["$","$L6","4-3",{"href":"/standards/4-3","aria-current":"$undefined","title":"4.3 Collaborator","children":"Collaborator"}],["$","$L6","4-4",{"href":"/standards/4-4","aria-current":"$undefined","title":"4.4 Learning Designer","children":"Learning Designer"}],["$","$L6","4-5",{"href":"/standards/4-5","aria-current":"$undefined","title":"4.5 Professional Learning Facilitator","children":"Professional Learning Facilitator"}],["$","$L6","4-6",{"href":"/standards/4-6","aria-current":"$undefined","title":"4.6 Data-Driven Decision-Maker","children":"Data-Driven Decision-Maker"}],["$","$L6","4-7",{"href":"/standards/4-7","aria-current":"$undefined","title":"4.7 Digital Citizen Advocate","children":"Digital Citizen Advocate"}]],["$","$L6",null,{"href":"/professional-development","aria-current":"$undefined","children":"PD Plan"}],["$","$L6",null,{"href":"/goals","aria-current":"$undefined","children":"Goals"}]]}]]}],["$","main",null,{"id":"main-content","className":"standard42","children":[["$","link",null,{"rel":"stylesheet","href":"/assets/standard42.css"}],["$","div",null,{"className":"page-wrap","children":[["$","header",null,{"className":"page-intro","children":[["$","p",null,{"className":"eyebrow","children":"ISTE Coach Standard 4.2"}],["$","h1",null,{"children":"Connected Learner"}],["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":"Coaches model the ISTE Standards for Students and Educators, deepen their expertise through professional learning, and improve their coaching through networks and shared reflection."}],["$","a",null,{"href":"https://iste.org/standards/coaches","className":"text-link","children":"View the official ISTE Coach Standards"}]]}]]}],["$","section",null,{"className":"content-section artifact-section","aria-labelledby":"artifact-one","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Artifact One"}],["$","h2",null,{"id":"artifact-one","children":"National Archives Informal PD Reflection"}]]}],["$","div",null,{"className":"prose-card","children":[["$","h3",null,{"children":"Indicator"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"4.2.a — Deepen Expertise Through Professional Learning."}]," This artifact documents learning and preparation to model the ISTE Standards with educators."]}]]}],["$","h3",null,{"children":"Description"}],["$","p",null,{"children":"I created this seven-slide reflection for EDEL 522 in summer 2026 after completing three recorded National Archives educator webinars. It documents my learning about teaching the Constitution with political cartoons, comparing sources about Vietnam, and using DocsTeach to support historical inquiry."}],["$","div",null,{"className":"portfolio-file-links","children":[["$","a",null,{"href":"/artifacts/standard-4-2/national-archives-reflection.pptx","className":"text-link","download":"","children":"Download the complete reflection (PowerPoint)"}]]}],["$","div",null,{"className":"portfolio-evidence-grid","children":[["$","figure",null,{"className":"portfolio-evidence","children":[["$","a",null,{"href":"/artifacts/standard-4-2/pd-webinars.png","children":["$","img",null,{"src":"/artifacts/standard-4-2/pd-webinars.png","alt":"Webinar selections: Teaching the Constitution with Political Cartoons, Remembering Vietnam: The Road to War, and Remembering Vietnam: The Road Through War. Total viewing time: 2 hours, 9 minutes, 22 seconds.","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Figure 1. Webinar selections and viewing time from my EDEL 522 reflection."}]]}],["$","figure",null,{"className":"portfolio-evidence","children":[["$","a",null,{"href":"/artifacts/standard-4-2/pd-participation.png","children":["$","img",null,{"src":"/artifacts/standard-4-2/pd-participation.png","alt":"Reflection slide describing independent participation: pausing recorded webinars, answering prompts, comparing private memos with public statements, and exploring DocsTeach activities.","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Figure 2. My participation in the recorded learning activities."}]]}]]}],["$","h3",null,{"children":"Implementation"}],["$","p",null,{"children":"I originally planned to complete Code.org’s AI 101, then chose the National Archives webinars because they fit the history and government courses I would teach at Trona High School. The three sessions listed in Figure 1 totaled 2 hours, 9 minutes, and 22 seconds. Selecting learning connected to my teaching responsibilities made it easier to identify practical applications."}],["$","p",null,{"children":"I paused the recordings to answer the presenters’ questions, compared private memos with public statements, and explored DocsTeach activities. I used the document-analysis process of meeting a source, observing it, making sense of it, and using it as evidence. This was completed independent learning from recorded expert instruction; there was no live interaction with the presenters."}],["$","h3",null,{"children":"Impact"}],["$","p",null,{"children":"The experience helped me plan digital activities around historical reasoning. Political cartoons can support interpretation of constitutional principles, while comparing private and public documents helps students examine audience and purpose. These applications connect to the ISTE Student role of Knowledge Constructor and the Educator role of Designer. The instructional value comes from the questions students investigate and the evidence they use."}],["$","p",null,{"children":"This learning also strengthened my preparation to support other educators. The four-step analysis routine gives me a concrete process to explain and model, while the webinar examples help me explain decisions about sources and prompts. My decision to select relevant professional learning reinforced the importance of offering colleagues support that fits their own instructional needs. The artifact demonstrates progress toward 4.2.a through completed learning, reflection, and preparation for educator modeling."}]]}]]}],["$","section",null,{"className":"content-section artifact-section","aria-labelledby":"artifact-two","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"Artifact Two"}],["$","h2",null,{"id":"artifact-two","children":"Supporting Our iMakers Handout"}]]}],["$","div",null,{"className":"prose-card","children":[["$","h3",null,{"children":"Indicators"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"4.2.a — Deepen Expertise Through Professional Learning."}]," The handout applies course learning to guidance for educators."]}],["$","li",null,{"children":[["$","strong",null,{"children":"4.2.b and 4.2.c"}]," — Areas for further development through professional exchange, a shared goal, and reflection."]}]]}],["$","h3",null,{"children":"Description"}],["$","p",null,{"children":"I created this visual handout for EDEL 590 in fall 2026 after studying the iMaker profile and instructional practices in Green et al. (2020). It introduces student creation, Universal Design for Learning, and instructional choice through the example of a digital history museum exhibit."}],["$","h3",null,{"children":"Implementation"}],["$","p",null,{"children":"I designed the handout as a resource for course peers and colleagues. I organized the handout around a digital history museum: students investigate a question, analyze sources, create explanations, and revise after peer feedback. This example makes the iMaker concepts visible in an instructional sequence that educators can discuss and adapt."}],["$","p",null,{"children":"I included Universal Design for Learning and instructional choice because students need accessible ways to engage with sources and communicate their thinking. Connecting these ideas to an existing lesson provides a practical starting point for professional learning. The handout’s invitation to bring a lesson to a PD session describes a proposed use of the resource; it does not document a facilitated session."}],["$","h3",null,{"children":"Impact"}],["$","p",null,{"children":"Creating the handout helped me translate course concepts into guidance for educators. Source analysis and student-created explanations connect to the ISTE Student roles of Knowledge Constructor and Creative Communicator. Planning the experience and supporting revision connect to the Educator roles of Designer and Facilitator. Developing one concrete example helped me explain how technology, student choice, feedback, and revision can work together within a lesson."}],["$","p",null,{"children":"The resource also helped me think more carefully about my role as a coach. A colleague needs room to question the example, identify barriers, and decide which ideas fit their students. I see the handout as a starting point for that conversation. Its present contribution is a resource for discussing instructional choices and a stronger foundation for my coaching; changes in another educator’s practice would need to be examined through its use with that educator."}],["$","figure",null,{"className":"portfolio-evidence portfolio-handout","children":[["$","a",null,{"href":"/artifacts/standard-4-2/supporting-our-imakers.png","children":["$","img",null,{"src":"/artifacts/standard-4-2/supporting-our-imakers.png","alt":"More Than Screen Time: Supporting Our iMakers. A handout connecting student creation, Universal Design for Learning, instructional choice, and the ISTE Standards through a digital history museum project. The proposed PD invitation is a next step.","loading":"lazy","decoding":"async"}]}],["$","figcaption",null,{"children":"Figure 3. More Than Screen Time: Supporting Our iMakers, prepared for discussion with educators."}]]}],["$","div",null,{"className":"portfolio-file-links","children":[["$","a",null,{"href":"/artifacts/standard-4-2/supporting-our-imakers.png","className":"text-link","children":"View the full-size handout"}],["$","a",null,{"href":"/artifacts/standard-4-2/supporting-our-imakers.png","className":"text-link","download":"","children":"Download the handout (PNG)"}]]}]]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"overall-reflection","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"overall-reflection","children":"Overall Reflection on Standard 4.2"}],["$","p",null,{"children":"Managing five course preparations has reinforced my preference for professional learning that addresses an actual instructional need. These artifacts show two parts of my development as a connected learner: seeking relevant expertise and translating that learning into a resource for other educators. Together, they have helped me connect my own learning to the decisions I would need to explain and support through coaching."}],["$","p",null,{"children":"These artifacts document completed professional learning and the design of educator resources. Sustained reciprocal exchange and shared-goal coaching remain areas for continued professional growth. The next steps below explain how I would extend this work through a professional learning network and a coaching partnership."}]]}],["$","div",null,{"className":"portfolio-reflections","children":[["$","article",null,{"children":[["$","h3",null,{"children":"4.2.a — Deepen Expertise Through Professional Learning"}],["$","p",null,{"children":"The National Archives experience reinforced the importance of relevance and choice in professional learning. Moving from a planned AI course to subject-specific learning helped me focus on strategies I could connect to history and government. The iMakers handout extended that process by asking me to organize ideas from course reading into a usable example. Both artifacts support 4.2.a by connecting professional learning to the ISTE Standards for Students and Educators."}],["$","p",null,{"children":"For coaching, I need to make my instructional reasoning visible. When modeling source analysis, I would explain why a source fits the question, how a prompt asks students to use evidence, and how reading supports can preserve the thinking required. I would then invite the educator to adapt the activity for their own students. This would extend my professional learning into modeling that supports an educator’s understanding and decision-making."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"4.2.b — Participate in Professional Learning Networks"}],["$","p",null,{"children":"A professional learning network should help me test my instructional assumptions against the experience of other educators. Contributing the iMakers handout would allow me to explain my design choices, learn how colleagues would adapt the lesson, and reconsider choices that do not serve their learners."}],["$","p",null,{"children":"The recorded webinars gave me access to expert ideas, but they did not provide the reciprocal exchange expected of an active professional learning network. Through my CSUF learning community, I can use the iMakers resource to begin a more focused discussion: Does the museum example give students meaningful decisions? Which reading support would improve access? What needs clarification before another educator could adapt it?"}],["$","p",null,{"children":"My next step is to discuss peers’ reasoning, consider the tools, research, or classroom experiences behind their suggestions, and explain which feedback informs a revision. Returning the revised resource to the discussion would allow peers to respond again. This continuing exchange can improve my coaching choices and help me remain current with technology, pedagogy, and how students learn."}]]}],["$","article",null,{"children":[["$","h3",null,{"children":"4.2.c — Commit to Continuous Improvement"}],["$","p",null,{"children":"A shared goal needs to begin with the educator’s instructional priority. My interest in source analysis can offer a starting point, while the educator’s knowledge of their students should shape the focus. A possible goal is to revise one task so students select relevant evidence and explain how it supports an interpretation, with reading supports chosen for that class. We would agree on the goal and the evidence of success together."}],["$","p",null,{"children":"A manageable coaching cycle would involve reviewing the existing task, modeling or discussing one change, revising it together, and returning to the agreed goal during a follow-up conversation. I would ask what helped the educator make the change, what my support overlooked, and what should be adjusted next. Their responses would guide changes to my questions, modeling, pacing, or support. This makes reflection part of the coaching process."}],["$","p",null,{"children":"I would examine impact at both the educator and student levels. Comparing the original and revised task, alongside the educator’s explanation of the change, would show how our work influenced instructional decisions. After classroom use, reviewing student work for relevant evidence and a clear connection to the claim could help us assess the learning goal. Keeping the agreed goal, revisions, and brief reflection notes would allow me to connect feedback to specific improvements in my coaching. This is the next stage of my development under 4.2.c."}]]}]]}]]}],["$","section",null,{"className":"content-section","aria-labelledby":"references","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"references","children":"References"}]]}],["$","div",null,{"className":"portfolio-references","children":[["$","p",null,{"children":["Green, T. D., Donovan, L. C., & Green, J. P. (2020). ",["$","em",null,{"children":"Making technology work in schools: How PK-12 educators can foster digital-age learning."}]," Routledge."]}],["$","p",null,{"children":["International Society for Technology in Education. (n.d.). ",["$","a",null,{"href":"https://iste.org/standards/coaches","children":["$","em",null,{"children":"ISTE Standards for Coaches"}]}],"."]}]]}]]}],["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-1/","children":"Previous: Change Agent"}],["$","a",null,{"href":"/standards/4-3/","children":"Next: Collaborator"}]]}]]}]]}],"$Lb"]}]
b:["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Trevor Arcadipane"}],["$","span",null,{"children":"ISTE Coach Standards Professional Portfolio"}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":"ISTE Coach Standards"}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":"CSUF Educational Technology"}]]}]]}]
