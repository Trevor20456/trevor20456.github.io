1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":["Skip to main content"]}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":["↗"]}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","a",null,{"href":"/","className":"brand","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":["TA"]}],["$","span",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","small",null,{"children":["Secondary Social Science · Educational Technology"]}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":["Menu"]}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","aria-current":"page","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","aria-current":"page","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}],["$","main",null,{"id":"main-content","className":"standard44","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["ISTE Coach Standard 4.5"]}],"\n  ",["$","h1",null,{"children":["Professional Learning Facilitator"]}],"\n  ",["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["I caught myself explaining too many features of Google Forms and handed my colleague the keyboard. By our third meeting, that same teacher was leading our review of student writing. This standard asks me to plan professional learning around what educators need, give them room to practice, and check what they can do with that experience."]}],["$","a",null,{"className":"source-link","href":"https://iste.org/standards/coaches","children":["Read the official Professional Learning Facilitator standard ",["$","span",null,{"aria-hidden":"true","children":["↗"]}]]}]]}],"\n"]}],"\n",["$","nav",null,{"className":"section-jump","aria-label":"On this page","children":[["$","a",null,{"href":"#mentoring","children":["October mentoring cycle"]}],["$","a",null,{"href":"#pd-design","children":["Professional learning plan"]}],["$","a",null,{"href":"#reflection","children":["Reflection by indicator"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"mentoring","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact one · 4.5.b and 4.5.c"]}],["$","h2",null,{"id":"mentoring","children":["From modeling a Google Form to handing over the review"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["In October 2026, I met three times with a colleague for my EDEL 590 mentoring project. They brought a writing assignment they already taught. Their students could submit answers online, but the teacher wanted to understand where the reasoning broke down. We chose one question to guide our work. Could students explain ",["$","em",null,{"children":["why"]}]," a detail they selected supported their claim?"]}],"\n    ",["$","figure",null,{"className":"coaching-cycle","id":"coaching-timeline","aria-labelledby":"cycle-title","children":["\n      ",["$","h3",null,{"id":"cycle-title","children":["October coaching timeline"]}],"\n      ",["$","ol",null,{"children":["\n        ",["$","li",null,{"children":[["$","strong",null,{"children":["Week 1 · Design"]}],["$","span",null,{"children":[["$","b",null,{"children":["I modeled"]}]," a question that reveals reasoning."]}],["$","span",null,{"children":[["$","b",null,{"children":["My colleague"]}]," chose the lesson, adapted the prompts, and tested the Form."]}]]}],"\n        ",["$","li",null,{"children":[["$","strong",null,{"children":["Week 2 · Interpret"]}],["$","span",null,{"children":[["$","b",null,{"children":["I asked"]}]," what stood out in the writing."]}],["$","span",null,{"children":[["$","b",null,{"children":["My colleague"]}]," identified the gap and helped choose a model paragraph."]}]]}],"\n        ",["$","li",null,{"children":[["$","strong",null,{"children":["Week 3 · Follow up"]}],["$","span",null,{"children":[["$","b",null,{"children":["I listened"]}]," for the reason behind the teaching decision."]}],["$","span",null,{"children":[["$","b",null,{"children":["My colleague"]}]," led the review and chose a small-group follow-up."]}]]}],"\n      "]}],["$","figcaption",null,{"children":["This timeline summarizes the changing roles documented in my mentoring presentation. It shows what the teacher was able to do as I stepped back."]}],"\n    "]}],"\n    ",["$","h3",null,{"children":["How we used the three meetings"]}],"\n    ",["$","p",null,{"children":["At our first meeting, I modeled three prompts asking students to make a claim, choose a detail, and explain the connection. My colleague adapted the prompts and tested the Form on a Chromebook. Our check-in later that week helped us decide where to spend our second meeting. My colleague reported feeling more confident after practicing with one learning target. We agreed to focus our next meeting on reading the answers."]}],"\n    ",["$","p",null,{"children":["At our second meeting, I asked my colleague what stood out before offering my own interpretation. Students could pick a useful detail, but many repeated it when we asked why it mattered. We co-planned a model paragraph and a chance for students to revise. My colleague tried the adjustment before our Friday check-in. That sequence put the ISTE Educator Analyst standard into practice. My colleague used evidence from a digital assessment to choose feedback students could act on."]}],"\n    ",["$","h3",null,{"children":["What changed for my colleague"]}],"\n    ",["$","p",null,{"children":["At our third meeting, my colleague brought a new passage, led the review, and chose a small-group follow-up for students who still needed a prompt. I waited to give feedback until I heard the teacher explain ",["$","em",null,{"children":["why"]}]," that group needed support. At our final check-in, they told me the review still took too long. We agreed to use shorter follow-ups to develop a reusable sorting routine. That request changed what I planned to offer next."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"pd-design","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact two · 4.5.a and 4.5.c"]}],["$","h2",null,{"id":"pd-design","children":["Designing professional learning around teachers’ next instructional decision"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","p",null,{"children":["In fall 2026, I developed goals, learning objectives, and assessments for a separate project, my yearlong Technology Professional Development Plan (TPDP) for Trona’s secondary teachers. I sent a needs survey to ten colleagues and eight responded. Six of eight felt confident using basic digital tools. Six wanted support interpreting student responses and deciding what to teach next. Seven identified limited time, and six asked for collaborative planning."]}],"\n    ",["$","figure",null,{"className":"form-review","id":"workshop-criteria","aria-labelledby":"check-title","children":["\n      ",["$","h3",null,{"id":"check-title","children":["Peer review for a three-to-five-item formative check"]}],"\n      ",["$","p",null,{"children":["Bring one assessment and the objective for the lesson where you will use it. With a partner, check each feature you can point to in the assessment."]}],"\n      ",["$","fieldset",null,{"children":[["$","legend",null,{"children":["What can we see in the assessment?"]}],"\n        ",["$","label",null,{"children":[["$","input",null,{"type":"checkbox"}],["$","span",null,{"children":["Each question helps us see whether students are meeting the lesson objective."]}]]}],"\n        ",["$","label",null,{"children":[["$","input",null,{"type":"checkbox"}],["$","span",null,{"children":["At least one question asks students to show their reasoning."]}]]}],"\n        ",["$","label",null,{"children":[["$","input",null,{"type":"checkbox"}],["$","span",null,{"children":["Students have a way to say where they are confused or need help."]}]]}],"\n        ",["$","label",null,{"children":[["$","input",null,{"type":"checkbox"}],["$","span",null,{"children":["The directions and questions are clear and readable."]}]]}],"\n        ",["$","label",null,{"children":[["$","input",null,{"type":"checkbox"}],["$","span",null,{"children":["An accommodation or another response option gives learners access to the task."]}]]}],"\n      "]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Partner prompt"]}]," Which question would you revise first, and what would the revision help you learn about a student?"]}],"\n      ",["$","p",null,{"children":[["$","strong",null,{"children":["Example revision"]}]," In a government lesson, “Which branch can veto a bill?” checks recall. Adding “What can Congress do next, and why does that matter?” gives the teacher a way to see whether students understand checks and balances. Partners can then decide which answer would call for reteaching."]}],"\n      ",["$","figcaption",null,{"children":["This web version of the first design objective in my TPDP gives partners five criteria to use before a classroom trial."]}],"\n    "]}],"\n    ",["$","h3",null,{"children":["What colleagues’ input changed"]}],"\n    ",["$","p",null,{"children":["I built the workshop around a lesson each teacher is about to teach. After a short model, teachers will work with a partner to design a three-to-five-item check. One item must reveal a student’s reasoning, and another part of the check must give students a way to communicate confusion or ask for support. Teachers will also review the reading demands and include an accommodation or alternative way to respond. A teacher who wants help getting started can use a template. A colleague who already uses Forms can use that time to improve a question."]}],"\n    ",["$","h3",null,{"children":["How I will evaluate the plan"]}],"\n    ",["$","p",null,{"children":["Colleagues’ survey responses shaped the checklist. The evidence so far shows what teachers asked for and how that changed my design. I have yet to document a teacher using the checklist or completing the two classroom trials. Each teacher will begin with an existing assessment and a personal goal. After two classroom cycles, I will compare those starting points with the teacher’s revised checks, anonymized response examples, and decisions about feedback or reteaching. If teachers can build a check but still struggle to interpret it, I will use the next meeting to practice interpreting responses together. That decision is one way to judge whether the plan supports Trona’s goal of developing independent thinkers who can explain their reasoning."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"reflection","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional reflection"]}],["$","h2",null,{"id":"reflection","children":["What I learned about facilitating professional learning"]}]]}],"\n  ",["$","div",null,{"className":"prose-card portfolio-reflections","children":["\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.5.a · Design professional learning around adult learners"]}],["$","p",null,{"children":["I can use a needs assessment to make specific choices about time, pacing, and practice. My colleague chose the writing lesson. In the yearlong plan, teachers bring a current lesson and choose a goal that fits their subject. These choices draw on two adult learning principles. Teachers direct part of their learning and apply their experience to an immediate classroom problem. I have more to learn about what makes it comfortable for different colleagues to ask for help. A private opening check-in about examples, language, and participation preferences would help me adapt the session to the people in the room."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.5.b · Build educator capacity through practice and feedback"]}],["$","p",null,{"children":["When I slowed down and let my colleague work through one question, they had time to practice a decision they would make again on their own. I saw the effect of that change in the third meeting, when the teacher could explain which students needed a follow-up and why. In a group session, I want every participant to have that turn. I can ask each teacher to interpret one response, choose a teaching move, and explain the choice before I offer feedback."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.5.c · Evaluate impact and improve the next session"]}],["$","p",null,{"children":["I have used evidence to adjust my coaching with one colleague. The Friday check-ins helped us move from building a Form to reading the responses, and my colleague’s final reflection gave us a reason to shorten the review. Evaluating the schoolwide plan is my next step. I want to see whether teachers can return to the same learning target, explain what changed after their adjustment, and decide what students still need. Those classroom decisions will help me choose which parts of the next cycle deserve more time."]}]]}],"\n  "]}],"\n"]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-4/","children":["← Learning Designer"]}],["$","a",null,{"href":"/standards/4-6/","children":["Data-Driven Decision-Maker →"]}]]}],"\n"]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Coach Standards"]}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":["CSUF Educational Technology"]}]]}]]}]]}]
