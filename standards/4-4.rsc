0:{"__route":"route:/standards/4-4/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/standards/4-4/":"$L1","layout:/":[[[["$","link","css:/assets/index-D_4IDysc.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-D_4IDysc.css","data-rsc-css-href":"/assets/index-D_4IDysc.css"}],"$undefined"],["$","html",null,{"lang":"en","children":["$","body",null,{"children":["$","$L2",null,{}]}]}]],null],"route:/standards/4-4/":[[[["$","meta",null,{"charSet":"utf-8"}],["$","title",null,{"children":"Learning Designer | Trevor Arcadipane"}],["$","meta",null,{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","link",null,{"rel":"stylesheet","href":"/assets/standard44.css?v=20261020"}]],[["$","title","0",{"children":"Trevor Arcadipane | ISTE Coach Portfolio"}],["$","meta","1",{"name":"description","content":"Trevor Arcadipane's professional portfolio demonstrating growth and proficiency across the ISTE Standards for Coaches."}],["$","link","2",{"rel":"shortcut icon","href":"/favicon.svg"}],["$","link","3",{"rel":"icon","href":"/favicon.svg"}],["$","meta","4",{"name":"codex-preview","content":"development"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L3",null,{"segmentMap":{"children":["standards","4-4"]},"children":["$","$L4",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L5",null,{"children":["$","$L3",null,{"segmentMap":{"children":[]},"children":["$","$L4",null,{"id":"page:/standards/4-4/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:vw54ulcwn57j","deploymentVersion":"5f1be360-f267-47da-80ee-f7b4a1117ae1","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":["Skip to main content"]}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":["↗"]}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","a",null,{"href":"/","className":"brand","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":["TA"]}],["$","span",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","small",null,{"children":["Secondary Social Science · Educational Technology"]}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":["Menu"]}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","aria-current":"page","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","aria-current":"page","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}],["$","main",null,{"id":"main-content","className":"standard44","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["ISTE Coach Standard 4.4"]}],["$","h1",null,{"children":["Learning Designer"]}],"\n  ",["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["I design resources to help educators plan purposeful digital learning by connecting student choice, accessible materials, assessment, and feedback to a clear learning goal."]}],["$","a",null,{"className":"source-link","href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Read the official Learning Designer standard ↗"]}]]}],"\n"]}],"\n",["$","nav",null,{"className":"section-jump","aria-label":"On this page","children":[["$","a",null,{"href":"#design-context","children":["Context and indicators"]}],["$","a",null,{"href":"#artifact-one","children":["Digital inquiry"]}],["$","a",null,{"href":"#artifact-two","children":["Assessment and feedback"]}],["$","a",null,{"href":"#reflection","children":["Reflection"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"design-context","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional context"]}],["$","h2",null,{"id":"design-context","children":["Designing for the thinking students need to do"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":[["$","p",null,{"children":["Teaching history and government requires students to do more than locate information. They need to examine a source, explain how evidence supports a position, and respond to a reasonable challenge. My executive-branch project provides a concrete example of that work: partners investigate a question about presidential power or selection and build an argument using scholarly sources. The digital presentation gives their reasoning a visible structure."]}],"\n  ",["$","p",null,{"children":["For Standard 4.4, I use that classroom project as the starting point for supporting another educator’s planning. The first artifact combines the existing assignment with an educator design guide. The second adds a separate formative assessment and feedback toolkit. Together, they connect the learning goal to what students produce, identify barriers to participation, and provide a response when the work shows a misunderstanding. These are completed educator resources developed from my October 2026 classroom materials. My evidence is strongest in resource design; a documented coaching cycle is the next step for demonstrating their effect on another educator’s practice."]}]]}],"\n  ",["$","div",null,{"className":"portfolio-table-wrap","children":[["$","table",null,{"children":[["$","caption",null,{"children":["How the artifacts address Learning Designer"]}],["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["Indicator"]}],["$","th",null,{"scope":"col","children":["Design focus"]}],["$","th",null,{"scope":"col","children":["Evidence to examine"]}]]}]]}],["$","tbody",null,{"children":["\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.a"]}],["$","td",null,{"children":["Co-design meaningful work with student ownership."]}],["$","td",null,{"children":["Topic and position choices, a civic argument, and a common standard for demonstrating learning."]}]]}],"\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.b"]}],["$","td",null,{"children":["Use digital assessment to guide feedback and next steps."]}],["$","td",null,{"children":["A four-question checkpoint, worked responses, feedback, and a student revision check."]}]]}],"\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.c"]}],["$","td",null,{"children":["Plan participation around differences among learners."]}],["$","td",null,{"children":["Reading supports, clear task structure, accessible response options, and an educator walkthrough."]}]]}],"\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.d"]}],["$","td",null,{"children":["Make instructional design decisions visible to educators."]}],["$","td",null,{"children":["Goal–evidence–activity alignment and a model of how assessment changes the next instructional move."]}]]}],"\n  "]}]]}]]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-one","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact One"]}],["$","h2",null,{"id":"artifact-one","children":["Executive Branch Digital Inquiry and Educator Design Guide"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.4.a, 4.4.c, and 4.4.d:"]}]," authentic learning with student choice, planning for learner variability, and modeling the reasoning behind a digital lesson design."]}],"\n    ",["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["This artifact brings together my October 2026 executive-branch debate materials and a new guide for adapting their design with another educator. The original materials include three presentation themes, a topic menu, a speaking guide, and a 100-point rubric. Students work in pairs, select a question and position, use two different scholarly sources, and deliver a five-minute presentation followed by two minutes of questions."]}],"\n    ",["$","p",null,{"children":["The educator guide explains why those components belong together. It includes an alignment table, an accessible text version of the student task, and decisions a colleague would make about sources, scaffolds, pacing, and participation. A public scoring table preserves the original assignment expectations, and a worked prompt revision makes the design process visible. Suggested adaptations are labeled separately from the original materials."]}],"\n    ",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-4/executive-branch-design/","children":["Open the project and educator design guide →"]}]]}],"\n    ",["$","figure",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Inside the original slide template"]}],["$","img",null,{"className":"template-image","src":"/artifacts/standard-4-4/executive-branch-design/source-template.webp","width":"1600","height":"900","loading":"lazy","alt":"Original Reason 1 slide, with separate spaces for a reason, scholarly evidence, an explanation connecting it to the position, and source attribution."}],["$","h3",null,{"children":["Reason 1"]}],["$","dl",null,{"className":"design-example","children":[["$","dt",null,{"children":["Our reason"]}],["$","dd",null,{"children":["State one reason for your position."]}],["$","dt",null,{"children":["Evidence from Source 1"]}],["$","dd",null,{"children":["Summarize a useful finding, example, or scholarly argument."]}],["$","dt",null,{"children":["Why this supports our position"]}],["$","dd",null,{"children":["Explain the connection between the evidence and the claim."]}]]}],["$","figcaption",null,{"children":["Original White House Briefing template, with a text explanation below the image. The separate reasoning prompt makes the explanation visible. Decorative artwork in the original is AI-generated."]}]]}],"\n    ",["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["I developed the original materials for my senior government class at Trona High School in October 2026. The source files are dated October 12. In preparing this portfolio section on October 20, I added the educator guide to make the instructional decisions behind the project explicit. The original project supplies the classroom context; the educator guide is a completed resource prepared for a future co-design conversation."]}],"\n    ",["$","p",null,{"children":["The guide organizes that conversation around the colleague’s content goal and the evidence students should produce. Its alignment table connects the project’s civic reasoning goal to the final presentation, rubric, and learning activities. The educator chooses which elements transfer to their learners and which need adjustment. The worked revision shows how a broad direction to add evidence becomes a prompt to identify a specific source detail, explain its connection to the position, and acknowledge what it does not establish."]}],"\n    ",["$","p",null,{"children":["The access review separates the demands of scholarly reading, shared slide work, and public speaking. It pairs each demand with a support, such as a vocabulary preview, a short passage with access to its full source, rehearsal, or an appropriate response option. This gives the educator specific decisions to make while preserving the reasoning goal and each partner’s responsibility."]}],"\n    ",["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["The artifact makes a complete design available for another educator to examine and adapt. Its clearest contribution is the connection between student choice and common expectations: students can select a topic, position, and visual approach while still explaining evidence and addressing a counterargument. The guide also identifies where the original task needs deliberate support instead of assuming that access to a Chromebook is enough."]}],"\n    ",["$","p",null,{"children":["For an educator, the intended benefit is a planning process they can apply beyond this project. The clearest evidence of that benefit would be an adapted lesson and the colleague’s explanation of how our work changed a choice about the task, access, or assessment. That evidence would establish the collaborative impact associated with 4.4.a, 4.4.c, and 4.4.d."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-two","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact Two"]}],["$","h2",null,{"id":"artifact-two","children":["Digital Assessment and Feedback Toolkit"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.4.b and 4.4.d:"]}]," designing a digital check that leads to timely, targeted feedback and demonstrating how the assessment, learning goal, and next instructional step fit together."]}],"\n    ",["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["This toolkit is a new formative assessment resource for the executive-branch inquiry. It contains a checkpoint students can complete before presenting, criteria for interpreting responses, invented examples for educator practice, and feedback that asks students to make a specific revision. A worked revision illustrates the reasoning expected after feedback. An individual revision record helps the teacher examine each partner’s understanding."]}],"\n    ",["$","p",null,{"children":["The original rubric evaluates the finished presentation. This toolkit serves a different purpose within the lesson: it gives the teacher information while students still have time to use feedback. The prompts can be copied into an approved digital form or document. The linked page is a public resource containing the questions and examples; it does not collect student information."]}],"\n    ",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-4/assessment-feedback/","children":["Open the checkpoint, worked examples, and feedback toolkit →"]}]]}],"\n    ",["$","div",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["A check that leads to a decision"]}],["$","h3",null,{"children":["Evidence needs an explanation"]}],["$","p",null,{"children":[["$","strong",null,{"children":["Look for:"]}]," a specific source detail and an explanation of how it supports the proposed position."]}],["$","p",null,{"children":[["$","strong",null,{"children":["Feedback move:"]}]," ask the student to explain the missing connection and revise that part of the argument."]}],["$","p",null,{"children":[["$","strong",null,{"children":["Follow-up:"]}]," compare the original explanation with the revision before deciding whether the student needs another model or is ready to examine a counterargument."]}]]}],"\n    ",["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["I prepared the toolkit on October 20, 2026, as an addition to the existing project. It is a completed assessment design and educator practice resource, prepared for a classroom trial and coaching conversation. The worked responses are invented examples rather than student work."]}],"\n    ",["$","p",null,{"children":["The educator practice sequence starts with a model: examine a response, identify what it reveals, and explain why one revision deserves attention. The colleague then evaluates another example and writes a feedback comment. Comparing the interpretations provides a way to check whether the prompt reveals the intended understanding and whether the comment gives the learner an actionable next step."]}],"\n    ",["$","p",null,{"children":["The suggested schedule reserves time to respond to feedback before the presentation. An approved digital form can place responses together for review; a private document can keep a comment beside the passage it addresses. The teacher evaluates the accuracy and relevance of evidence, selects a targeted support, and checks the revision before moving the learner forward."]}],"\n    ",["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["The toolkit adds an explicit connection between an assessment response and the support that follows. Instead of a general reminder to add detail, it models how feedback can identify a gap in reasoning and give the learner a manageable action. The independent follow-up also addresses a limitation of a shared presentation: a strong group product does not establish that both partners understand the argument."]}],"\n    ",["$","p",null,{"children":["For the educator, the intended benefit is a more precise connection between evidence of learning and the next teaching decision. A revised checkpoint, an independently written feedback comment, and a brief account of the resulting instructional adjustment would help establish that impact. An anonymized original response and revision would then show whether the feedback addressed the intended learning need."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"reflection","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional reflection"]}],["$","h2",null,{"id":"reflection","children":["Overall Reflection on Standard 4.4"]}]]}],"\n  ",["$","div",null,{"className":"prose-card portfolio-reflections","children":[["$","p",null,{"children":["These artifacts helped me examine a familiar classroom project from the perspective of a coach. I can explain why I chose a task or template, but another educator needs room to question those choices and adapt them. My responsibility is to make the design understandable enough that the teacher can use the reasoning in a different lesson."]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.a — Meaningful choices and clear expectations"]}],["$","p",null,{"children":["My evidence demonstrates purposeful student choice in the learning design; I am developing the collaborative coaching component of 4.4.a. The executive-branch project gives students a question worth debating and several decisions to make. They select a position, decide which evidence matters, and explain a recommendation to classmates. I see the strongest evidence of my design skill in how those choices connect to a shared expectation for reasoning. Choosing a slide theme adds ownership, but the more important decisions concern the argument itself."]}],["$","p",null,{"children":["My next step is to co-design an adaptation with an educator, asking them to identify one consequential student decision and one expectation all students must meet. I also want to consider choices in how students demonstrate learning when the goal allows them. The current project offers topic, position, and visual choices within a common presentation format; it leaves room to expand agency in the final product."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.b — Feedback students can use"]}],["$","p",null,{"children":["I demonstrate competence in designing a formative assessment and feedback sequence; supporting an educator through its use remains my next step for 4.4.b. A final score arrives too late to guide the presentation that has already happened. Planning a checkpoint earlier gives feedback a purpose within the learning sequence. The toolkit shows that I can connect a question to an interpretation and a next step. It also requires students to revisit their reasoning, making it possible to examine more than task completion."]}],["$","p",null,{"children":["In a classroom trial with a colleague, I will examine whether the prompts distinguish a missing fact from a weak explanation and whether the feedback produces a useful revision. The teacher’s independent decision about the next support will be a central measure of my coaching. If responses are too vague to interpret, the prompt or model needs revision before adding more assessment items."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.c — Access to the thinking, as well as the materials"]}],["$","p",null,{"children":["My current strength in 4.4.c is anticipating barriers and designing options; I am still developing evidence of testing those options with an educator and their learners. My approach includes clear directions, manageable sections, and support for reading and speaking. Those choices reflect the variability I need to consider across my classes. A student may understand the civic issue but need help accessing an academic passage or organizing an oral explanation. The educator guide separates those barriers so support can target the difficulty."]}],["$","p",null,{"children":["My next step is an accessibility walkthrough of the adapted lesson with the educator: open the materials as a student, navigate the task, examine reading and response demands, and identify places where support is needed. Learner feedback will help us check the assumptions in the design. A useful revision preserves the content goal while making participation more practical."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.d — Explaining why the lesson is organized this way"]}],["$","p",null,{"children":["My evidence for 4.4.d shows a clear design rationale and a prepared model; my next level of competence is helping a colleague apply that reasoning independently. I use McTighe and Wiggins’s (2012) backward-design sequence: establish the learning goal, select evidence that demonstrates it, and plan the learning experiences. The original slide prompts make components of an argument visible. The new checkpoint creates an opportunity to improve those components before the final performance."]}],["$","p",null,{"children":["The worked prompt revision and assessment example make the reasoning available for an educator to examine and question. Next, I will ask a colleague to apply the planning sequence to a different lesson and explain how the intended evidence shaped the activities. Their independent adaptation will help me judge whether my modeling supported transferable design skills."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["Next evidence to collect"]}],["$","p",null,{"children":["A focused coaching cycle will connect these resources to educator practice. I plan to retain the agreed learning goal, an educator’s adapted task and checkpoint, one anonymized feedback-and-revision example, and a short reflection on the decision my support helped them make. Together, those records will let me evaluate the effect of the coaching and identify what to change in my approach."]}]]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"references","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"references","children":["References and artifact sources"]}]]}],"\n  ",["$","p",null,{"children":["International Society for Technology in Education. (n.d.). ",["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Standards for Coaches"]}],". Indicator summaries on this page are paraphrased."]}],"\n  ",["$","p",null,{"children":["CAST. (2024). ",["$","a",null,{"href":"https://udlguidelines.cast.org/","children":["Universal Design for Learning Guidelines, version 3.0"]}],". The educator guide applies options for engagement, access to information, and expression to this project."]}],"\n  ",["$","p",null,{"children":["McTighe, J., & Wiggins, G. (2012). ",["$","a",null,{"href":"https://ascd.org/ASCD/pdf/siteASCD/publications/UbD_WhitePaper0312.pdf","children":[["$","em",null,{"children":["Understanding by Design framework"]}]]}],". ASCD. The guide’s goal–evidence–activity sequence applies this planning approach."]}],"\n  ",["$","p",null,{"children":["Original classroom materials: Trevor Arcadipane, ",["$","em",null,{"children":["Executive Branch Debate"]}]," student templates, topic choices, speaking guide, and rubric (October 2026). The ",["$","a",null,{"href":"/artifacts/standard-4-4/executive-branch-design/#original-materials","children":["artifact page"]}]," identifies the original files and separates them from the new educator adaptations."]}],"\n"]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-3/","children":["Previous: Collaborator"]}],["$","a",null,{"href":"/standards/4-5/","children":["Next: Professional Learning Facilitator"]}]]}],"\n\n"]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Coach Standards"]}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":["CSUF Educational Technology"]}]]}]]}]]}]
