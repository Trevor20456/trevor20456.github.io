0:{"__route":"route:/standards/4-4/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/standards/4-4/":"$L1","layout:/":[[[["$","link","css:/assets/index-D_4IDysc.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-D_4IDysc.css","data-rsc-css-href":"/assets/index-D_4IDysc.css"}],"$undefined"],["$","html",null,{"lang":"en","children":["$","body",null,{"children":["$","$L2",null,{}]}]}]],null],"route:/standards/4-4/":[[[["$","meta",null,{"charSet":"utf-8"}],["$","title",null,{"children":"Learning Designer | Trevor Arcadipane"}],["$","meta",null,{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","link",null,{"rel":"stylesheet","href":"/assets/standard44.css?v=20261020"}]],[["$","title","0",{"children":"Trevor Arcadipane | ISTE Coach Portfolio"}],["$","meta","1",{"name":"description","content":"Trevor Arcadipane's professional portfolio demonstrating growth and proficiency across the ISTE Standards for Coaches."}],["$","link","2",{"rel":"shortcut icon","href":"/favicon.svg"}],["$","link","3",{"rel":"icon","href":"/favicon.svg"}],["$","meta","4",{"name":"codex-preview","content":"development"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L3",null,{"segmentMap":{"children":["standards","4-4"]},"children":["$","$L4",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L5",null,{"children":["$","$L3",null,{"segmentMap":{"children":[]},"children":["$","$L4",null,{"id":"page:/standards/4-4/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:vw54ulcwn57j","deploymentVersion":"5f1be360-f267-47da-80ee-f7b4a1117ae1","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":["Skip to main content"]}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":["↗"]}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","a",null,{"href":"/","className":"brand","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":["TA"]}],["$","span",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","small",null,{"children":["Secondary Social Science · Educational Technology"]}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":["Menu"]}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","aria-current":"page","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","aria-current":"page","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}],["$","main",null,{"id":"main-content","className":"standard44","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["ISTE Coach Standard 4.4"]}],["$","h1",null,{"children":["Learning Designer"]}],"\n  ",["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["I design resources to help educators plan purposeful digital learning by connecting student choice, accessible materials, assessment, and feedback to a clear learning goal."]}],["$","a",null,{"className":"source-link","href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Read the official Learning Designer standard ↗"]}]]}],"\n"]}],"\n",["$","nav",null,{"className":"section-jump","aria-label":"On this page","children":[["$","a",null,{"href":"#design-context","children":["Context and indicators"]}],["$","a",null,{"href":"#artifact-one","children":["Digital inquiry"]}],["$","a",null,{"href":"#artifact-two","children":["Assessment and feedback"]}],["$","a",null,{"href":"#reflection","children":["Reflection"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"design-context","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional context"]}],["$","h2",null,{"id":"design-context","children":["Designing for the thinking students need to do"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":[["$","p",null,{"children":["Teaching history and government requires students to do more than locate information. They need to examine a source, explain how evidence supports a position, and respond to a reasonable challenge. My executive-branch project provides a concrete example of that work: partners investigate a question about presidential power or selection and build an argument using scholarly sources. The digital presentation gives their reasoning a visible structure."]}],"\n  ",["$","p",null,{"children":["For Standard 4.4, I use that classroom project as the starting point for supporting another educator’s planning. The first artifact combines the existing assignment with an educator design guide. The second adds a separate formative assessment and feedback toolkit. Together, they show how I would help a colleague connect the learning goal to what students produce, identify barriers, and plan a response when the work shows a misunderstanding."]}]]}],"\n  ",["$","div",null,{"className":"portfolio-table-wrap","children":[["$","table",null,{"children":[["$","caption",null,{"children":["How the artifacts address Learning Designer"]}],["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["Indicator"]}],["$","th",null,{"scope":"col","children":["Design focus"]}],["$","th",null,{"scope":"col","children":["Evidence to examine"]}]]}]]}],["$","tbody",null,{"children":["\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.a"]}],["$","td",null,{"children":["Co-design meaningful work with student ownership."]}],["$","td",null,{"children":["Topic and position choices, a civic argument, and a common standard for demonstrating learning."]}]]}],"\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.b"]}],["$","td",null,{"children":["Use digital assessment to guide feedback and next steps."]}],["$","td",null,{"children":["A four-question checkpoint, worked responses, feedback, and a student revision check."]}]]}],"\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.c"]}],["$","td",null,{"children":["Plan participation around differences among learners."]}],["$","td",null,{"children":["Reading supports, clear task structure, accessible response options, and an educator walkthrough."]}]]}],"\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.d"]}],["$","td",null,{"children":["Make instructional design decisions visible to educators."]}],["$","td",null,{"children":["Goal–evidence–activity alignment and a model of how assessment changes the next instructional move."]}]]}],"\n  "]}]]}]]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-one","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact One"]}],["$","h2",null,{"id":"artifact-one","children":["Executive Branch Digital Inquiry and Educator Design Guide"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.4.a, 4.4.c, and 4.4.d:"]}]," authentic learning with student choice, planning for learner variability, and modeling the reasoning behind a digital lesson design."]}],"\n    ",["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["This artifact brings together my October 2026 executive-branch debate materials and a new guide for adapting their design with another educator. The original materials include three presentation themes, a topic menu, a speaking guide, and a 100-point rubric. Students work in pairs, select a question and position, use two different scholarly sources, and deliver a five-minute presentation followed by two minutes of questions."]}],"\n    ",["$","p",null,{"children":["The educator guide explains why those components belong together. It includes an alignment table, an accessible text version of the student task, and decisions a colleague would make about sources, scaffolds, pacing, and participation. The guide keeps the original assignment expectations visible while labeling suggested adaptations separately."]}],"\n    ",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-4/executive-branch-design/","children":["Open the project and educator design guide →"]}]]}],"\n    ",["$","figure",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Inside the original slide template"]}],["$","img",null,{"className":"template-image","src":"/artifacts/standard-4-4/executive-branch-design/source-template.webp","width":"1600","height":"900","loading":"lazy","alt":"Original Reason 1 slide, with separate spaces for a reason, scholarly evidence, an explanation connecting it to the position, and source attribution."}],["$","h3",null,{"children":["Reason 1"]}],["$","dl",null,{"className":"design-example","children":[["$","dt",null,{"children":["Our reason"]}],["$","dd",null,{"children":["State one reason for your position."]}],["$","dt",null,{"children":["Evidence from Source 1"]}],["$","dd",null,{"children":["Summarize a useful finding, example, or scholarly argument."]}],["$","dt",null,{"children":["Why this supports our position"]}],["$","dd",null,{"children":["Explain the connection between the evidence and the claim."]}]]}],["$","figcaption",null,{"children":["Original White House Briefing template, with a text explanation below the image. The separate reasoning prompt makes the explanation visible. Decorative artwork in the original is AI-generated."]}]]}],"\n    ",["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["I developed the original materials for my senior government class at Trona High School in October 2026. The source files are dated October 12. In preparing this portfolio section on October 20, I added the educator guide to make the instructional decisions behind the project explicit. The completed stage is the classroom resource and its coaching companion; a co-design meeting or implementation of this guide with another educator is not documented here."]}],"\n    ",["$","p",null,{"children":["In a planning conversation, I would begin with the colleague’s content goal and the evidence students should produce. We would compare those goals with the project’s requirement to distinguish the current system from a proposed change, explain two reasons, and answer an objection. The colleague would decide which elements transfer to their learners and which need adjustment. For another subject, the question and sources would change while the requirement to explain evidence could remain."]}],"\n    ",["$","p",null,{"children":["The next decision concerns access. Scholarly reading, shared slide work, and public speaking create different demands. The guide asks us to plan support for each demand, such as a vocabulary preview, a short relevant passage with access to its full source, a rehearsal, or a response method consistent with the student’s learning plan. We would check that these supports preserve the reasoning goal and that each partner has a meaningful contribution."]}],"\n    ",["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["The artifact makes a complete design available for another educator to examine and adapt. Its clearest contribution is the connection between student choice and common expectations: students can select a topic, position, and visual approach while still explaining evidence and addressing a counterargument. The guide also identifies where the original task needs deliberate support instead of assuming that access to a Chromebook is enough."]}],"\n    ",["$","p",null,{"children":["These features demonstrate my ability to organize a learning design and explain its instructional purpose. They support the design aspects of 4.4.a, 4.4.c, and 4.4.d. Evidence that I have successfully collaborated or modeled with another educator requires a further step. I would retain the colleague’s adapted lesson, their explanation of one design change, and feedback on whether my support helped them make that change. No colleague outcome or student learning gain is claimed from the guide’s creation alone."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-two","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact Two"]}],["$","h2",null,{"id":"artifact-two","children":["Digital Assessment and Feedback Toolkit"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.4.b and 4.4.d:"]}]," designing a digital check that leads to timely, targeted feedback and demonstrating how the assessment, learning goal, and next instructional step fit together."]}],"\n    ",["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["This toolkit is a new formative assessment resource for the executive-branch inquiry. It contains a checkpoint students can complete before presenting, criteria for interpreting responses, invented examples for educator practice, and feedback that asks students to make a specific revision. An individual follow-up helps the teacher examine each partner’s understanding."]}],"\n    ",["$","p",null,{"children":["The original rubric evaluates the finished presentation. This toolkit serves a different purpose within the lesson: it gives the teacher information while students still have time to use feedback. The prompts can be copied into an approved digital form or document. The linked page is a public resource containing the questions and examples; it does not collect student information."]}],"\n    ",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-4/assessment-feedback/","children":["Open the checkpoint, worked examples, and feedback toolkit →"]}]]}],"\n    ",["$","div",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["A check that leads to a decision"]}],["$","h3",null,{"children":["Evidence needs an explanation"]}],["$","p",null,{"children":[["$","strong",null,{"children":["Look for:"]}]," a specific source detail and an explanation of how it supports the proposed position."]}],["$","p",null,{"children":[["$","strong",null,{"children":["Feedback move:"]}]," ask the student to explain the missing connection and revise that part of the argument."]}],["$","p",null,{"children":[["$","strong",null,{"children":["Follow-up:"]}]," compare the original explanation with the revision before deciding whether the student needs another model or is ready to examine a counterargument."]}]]}],"\n    ",["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["I prepared the toolkit on October 20, 2026, as an addition to the existing project. Its current stage is a completed assessment design and educator practice resource. The worked responses are invented examples, and the feedback sequence has not been documented as implemented with a colleague or class."]}],"\n    ",["$","p",null,{"children":["To model the design with an educator, I would work through one example and explain what the response reveals, what remains unclear, and why the feedback focuses on one revision. The educator would then evaluate another example and write their own response. Comparing our interpretations would help us identify whether the question actually reveals the understanding we intended to assess."]}],"\n    ",["$","p",null,{"children":["The educator would select a checkpoint time that allows students to revise before presenting. A digital form can place responses together for review; a shared document can keep a comment beside the passage it addresses. The teacher still needs to judge the accuracy and relevance of the evidence. An automatic score or a submitted response cannot make that decision on its own."]}],"\n    ",["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["The toolkit adds an explicit connection between an assessment response and the support that follows. Instead of a general reminder to add detail, it models how feedback can identify a gap in reasoning and give the learner a manageable action. The independent follow-up also addresses a limitation of a shared presentation: a strong group product does not establish that both partners understand the argument."]}],"\n    ",["$","p",null,{"children":["This is evidence of assessment design aligned to 4.4.b and of planning the instructional sequence associated with 4.4.d. Its effect on another educator remains to be established. The relevant evidence would include the colleague’s revised checkpoint, a feedback example they created independently, and their account of how a response changed their next instructional decision. An anonymized response and revision could then show whether the feedback addressed the intended learning need."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"reflection","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional reflection"]}],["$","h2",null,{"id":"reflection","children":["Overall Reflection on Standard 4.4"]}]]}],"\n  ",["$","div",null,{"className":"prose-card portfolio-reflections","children":[["$","p",null,{"children":["These artifacts helped me examine a familiar classroom project from the perspective of a coach. I can explain why I chose a task or template, but another educator needs room to question those choices and adapt them. My responsibility is to make the design understandable enough that the teacher can use the reasoning in a different lesson."]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.a — Meaningful choices and clear expectations"]}],["$","p",null,{"children":["The executive-branch project gives students a question worth debating and several decisions to make. They select a position, decide which evidence matters, and explain a recommendation to classmates. I see the strongest evidence of my design skill in how those choices connect to a shared expectation for reasoning. Choosing a slide theme adds ownership, but the more important decisions concern the argument itself."]}],["$","p",null,{"children":["The collaborative part of this indicator still requires evidence from work with an educator. I would ask the colleague to identify one place where students can make a consequential decision and one expectation that all students must meet. Their adapted task and explanation would show whether our conversation improved the design."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.b — Feedback students can use"]}],["$","p",null,{"children":["A final score arrives too late to guide the presentation that has already happened. Planning a checkpoint earlier gives feedback a purpose within the learning sequence. The toolkit shows that I can connect a question to an interpretation and a next step. It also requires students to revisit their reasoning, making it possible to examine more than task completion."]}],["$","p",null,{"children":["I need evidence of helping an educator use that process independently. During a classroom trial, we would look at whether the prompts distinguish a missing fact from a weak explanation and whether the feedback gives students a useful action. If responses are too vague to interpret, the question or model needs revision before adding more assessment items."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.c — Access to the thinking, as well as the materials"]}],["$","p",null,{"children":["My design approach includes clear directions, manageable sections, and support for reading and speaking. Those choices reflect the variability I need to consider across my classes. A student may understand the civic issue but need help accessing an academic passage or organizing an oral explanation. The educator guide separates those barriers so support can target the difficulty."]}],["$","p",null,{"children":["The guide demonstrates my ability to anticipate barriers; it does not establish that every learner can use the materials successfully. I would review an adapted lesson with the educator, test the actual student workflow, and use learner feedback to find where participation breaks down. A useful revision should preserve the content goal while making the task more usable."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.d — Explaining why the lesson is organized this way"]}],["$","p",null,{"children":["I use backward design in these resources by identifying the intended learning, deciding what evidence would show it, and planning activities that prepare students to produce that evidence. The original slide prompts make components of an argument visible. The new checkpoint creates an opportunity to improve those components before the final performance."]}],["$","p",null,{"children":["My current evidence establishes a reasoned design and a model prepared for educators. Demonstrating this indicator through coaching also requires observing what a colleague can do with that model. I would ask the educator to apply the same planning sequence to another lesson and explain how the assessment influenced their choices. Their independent adaptation would be stronger evidence than agreement that the original resource looks useful."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["What the current evidence establishes"]}],["$","p",null,{"children":["The original project materials and the two completed portfolio resources show concrete learning and assessment designs. The educator guides are ready to use in a planning conversation. Documented co-design, educator feedback, and changes in colleague practice remain the next evidence needed across these indicators. Keeping that distinction clear helps me evaluate my coaching through what educators can do with the support."]}]]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"references","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"references","children":["References and artifact sources"]}]]}],"\n  ",["$","p",null,{"children":["International Society for Technology in Education. (n.d.). ",["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Standards for Coaches"]}],". Indicator summaries on this page are paraphrased."]}],"\n  ",["$","p",null,{"children":["CAST. (2024). ",["$","a",null,{"href":"https://udlguidelines.cast.org/","children":["Universal Design for Learning Guidelines, version 3.0"]}],". The educator guide applies options for engagement, access to information, and expression to this project."]}],"\n  ",["$","p",null,{"children":["Original classroom materials: Trevor Arcadipane, ",["$","em",null,{"children":["Executive Branch Debate"]}]," student templates, topic choices, speaking guide, and rubric (October 2026). The ",["$","a",null,{"href":"/artifacts/standard-4-4/executive-branch-design/#original-materials","children":["artifact page"]}]," identifies the original files and separates them from the new educator adaptations."]}],"\n"]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-3/","children":["Previous: Collaborator"]}],["$","a",null,{"href":"/standards/4-5/","children":["Next: Professional Learning Facilitator"]}]]}],"\n\n"]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Coach Standards"]}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":["CSUF Educational Technology"]}]]}]]}]]}]
