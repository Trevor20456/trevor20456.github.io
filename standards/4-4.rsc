0:{"__route":"route:/standards/4-4/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/standards/4-4/":"$L1","layout:/":[[[["$","link","css:/assets/index-D_4IDysc.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-D_4IDysc.css","data-rsc-css-href":"/assets/index-D_4IDysc.css"}],"$undefined"],["$","html",null,{"lang":"en","children":["$","body",null,{"children":["$","$L2",null,{}]}]}]],null],"route:/standards/4-4/":[[[["$","meta",null,{"charSet":"utf-8"}],["$","title",null,{"children":"Learning Designer | Trevor Arcadipane"}],["$","meta",null,{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","link",null,{"rel":"stylesheet","href":"/assets/standard44.css?v=20261020-rubric"}]],[["$","title","0",{"children":"Trevor Arcadipane | ISTE Coach Portfolio"}],["$","meta","1",{"name":"description","content":"Trevor Arcadipane's professional portfolio demonstrating growth and proficiency across the ISTE Standards for Coaches."}],["$","link","2",{"rel":"shortcut icon","href":"/favicon.svg"}],["$","link","3",{"rel":"icon","href":"/favicon.svg"}],["$","meta","4",{"name":"codex-preview","content":"development"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L3",null,{"segmentMap":{"children":["standards","4-4"]},"children":["$","$L4",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L5",null,{"children":["$","$L3",null,{"segmentMap":{"children":[]},"children":["$","$L4",null,{"id":"page:/standards/4-4/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:vw54ulcwn57j","deploymentVersion":"5f1be360-f267-47da-80ee-f7b4a1117ae1","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
1:["$","div",null,{"className":"site-frame","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":["Skip to main content"]}],["$","header",null,{"className":"site-header","children":[["$","div",null,{"className":"utility-bar","children":[["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}],["$","a",null,{"href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Official ISTE standards ",["$","span",null,{"aria-hidden":"true","children":["↗"]}]]}]]}],["$","div",null,{"className":"brand-row","children":[["$","a",null,{"href":"/","className":"brand","aria-label":"Trevor Arcadipane portfolio home","children":[["$","span",null,{"className":"brand-mark","aria-hidden":"true","children":["TA"]}],["$","span",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","small",null,{"children":["Secondary Social Science · Educational Technology"]}]]}]]}],["$","details",null,{"className":"mobile-navigation","children":[["$","summary",null,{"children":["Menu"]}],["$","nav",null,{"aria-label":"Mobile navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","aria-current":"page","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}]]}],["$","nav",null,{"className":"primary-navigation","aria-label":"Primary navigation","children":[["$","a",null,{"href":"/","children":["Introduction"]}],["$","a",null,{"href":"/standards/4-1","title":"4.1 Change Agent","children":["Change Agent"]}],["$","a",null,{"href":"/standards/4-2","title":"4.2 Connected Learner","children":["Connected Learner"]}],["$","a",null,{"href":"/standards/4-3","title":"4.3 Collaborator","children":["Collaborator"]}],["$","a",null,{"href":"/standards/4-4","aria-current":"page","title":"4.4 Learning Designer","children":["Learning Designer"]}],["$","a",null,{"href":"/standards/4-5","title":"4.5 Professional Learning Facilitator","children":["Professional Learning Facilitator"]}],["$","a",null,{"href":"/standards/4-6","title":"4.6 Data-Driven Decision-Maker","children":["Data-Driven Decision-Maker"]}],["$","a",null,{"href":"/standards/4-7","title":"4.7 Digital Citizen Advocate","children":["Digital Citizen Advocate"]}],["$","a",null,{"href":"/professional-development","children":["PD Plan"]}],["$","a",null,{"href":"/goals","children":["Goals"]}]]}]]}],["$","main",null,{"id":"main-content","className":"standard44","children":[["$","div",null,{"className":"page-wrap","children":["\n",["$","header",null,{"className":"page-intro","children":["\n  ",["$","p",null,{"className":"eyebrow","children":["ISTE Coach Standard 4.4"]}],["$","h1",null,{"children":["Learning Designer"]}],"\n  ",["$","div",null,{"className":"page-lede","children":[["$","p",null,{"children":["Learning Designer focuses on helping educators create learning experiences and digital environments that respond to students’ needs and interests. My work connects a clear learning goal with student choice, accessible materials, assessment, and feedback."]}],["$","a",null,{"className":"source-link","href":"https://iste.org/standards/coaches","target":"_blank","rel":"noreferrer","children":["Read the official Learning Designer standard ↗"]}]]}],"\n"]}],"\n",["$","nav",null,{"className":"section-jump","aria-label":"On this page","children":[["$","a",null,{"href":"#design-context","children":["Context and indicators"]}],["$","a",null,{"href":"#artifact-one","children":["Digital inquiry"]}],["$","a",null,{"href":"#artifact-two","children":["Assessment and feedback"]}],["$","a",null,{"href":"#reflection","children":["Reflection"]}]]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"design-context","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional context"]}],["$","h2",null,{"id":"design-context","children":["Designing for the thinking students need to do"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":[["$","p",null,{"children":["In my senior government class at Trona High School, students need to explain how evidence supports a position and respond to a reasonable challenge. The executive-branch project gives them that work: partners investigate a question about presidential power or selection and develop a civic argument. With access to Chromebooks, they can research, organize a shared presentation, and revise their explanations."]}],"\n  ",["$","p",null,{"children":["For this standard, I developed two educator resources from that project. The design guide explains the choices behind the learning experience. The assessment toolkit adds a way to check individual understanding before the presentation. I have successfully shared the original executive-branch materials with another educator. The design guide and assessment toolkit extend that work by making the planning process, access options, and feedback sequence available for further collaboration."]}]]}],"\n  ",["$","div",null,{"className":"portfolio-table-wrap","children":[["$","table",null,{"children":[["$","caption",null,{"children":["How the artifacts address Learning Designer"]}],["$","thead",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"col","children":["Indicator"]}],["$","th",null,{"scope":"col","children":["Design focus"]}],["$","th",null,{"scope":"col","children":["Evidence to examine"]}]]}]]}],["$","tbody",null,{"children":["\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.a"]}],["$","td",null,{"children":["Design active, authentic learning with student agency and evidence of understanding."]}],["$","td",null,{"children":[["$","a",null,{"href":"/artifacts/standard-4-4/executive-branch-design/#student-task","children":["Civic inquiry task:"]}]," topic and position choices, source-based explanations, and a defended recommendation."]}]]}],"\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.b"]}],["$","td",null,{"children":["Help educators assess learning and provide timely, individualized feedback."]}],["$","td",null,{"children":[["$","a",null,{"href":"/artifacts/standard-4-4/assessment-feedback/#teacher-interpretation","children":["Assessment decisions:"]}]," identify the gap, select feedback, and check the individual revision."]}]]}],"\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.c"]}],["$","td",null,{"children":["Collaborate on accessible digital environments that support active participation."]}],["$","td",null,{"children":[["$","a",null,{"href":"/artifacts/standard-4-4/executive-branch-design/#access","children":["Access review:"]}]," reading, navigation, response options, and meaningful work for each partner."]}]]}],"\n    ",["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":["4.4.d"]}],["$","td",null,{"children":["Model instructional design decisions with educators."]}],["$","td",null,{"children":[["$","a",null,{"href":"/artifacts/standard-4-4/executive-branch-design/#design-alignment","children":["Design model:"]}]," backward planning and a worked prompt revision, followed by educator practice."]}]]}],"\n  "]}]]}]]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-one","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact One"]}],["$","h2",null,{"id":"artifact-one","children":["Executive Branch Digital Inquiry and Educator Design Guide"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.4.a, 4.4.c, and 4.4.d:"]}]," authentic learning with student choice, planning for learner variability, and modeling the reasoning behind a digital lesson design."]}],"\n    ",["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["This artifact brings together my October 2026 executive-branch debate materials and a new guide for adapting their design with another educator. The original materials include three presentation themes, a topic menu, a speaking guide, and a 100-point rubric. Students work in pairs, select a question and position, use two different scholarly sources, and deliver a five-minute presentation followed by two minutes of questions."]}],"\n    ",["$","p",null,{"children":["The educator guide explains why those components belong together. It includes an alignment table, an accessible text version of the student task, and decisions a colleague would make about sources, scaffolds, pacing, and participation. A public scoring table preserves the original assignment expectations, and a worked prompt revision makes the design process visible. Suggested adaptations are labeled separately from the original materials."]}],"\n    ",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-4/executive-branch-design/","children":["Open the project and educator design guide →"]}]]}],"\n    ",["$","figure",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Inside the original slide template"]}],["$","img",null,{"className":"template-image","src":"/artifacts/standard-4-4/executive-branch-design/source-template.webp","width":"1600","height":"900","loading":"lazy","alt":"Original Reason 1 slide, with separate spaces for a reason, scholarly evidence, an explanation connecting it to the position, and source attribution."}],["$","figcaption",null,{"children":["Original White House Briefing template. The slide separates the reason, source evidence, and explanation of why that evidence supports the position. The original template identifies its decorative artwork as AI-generated."]}]]}],"\n    ",["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["I developed the original materials for my senior government class in October 2026; the source files are dated October 12. I have shared the executive-branch materials with another educator, and I consider that sharing experience successful. The project provides a concrete example of student choice, scholarly research, a shared digital product, and common assessment expectations. On October 20, I added the educator guide to explain these design choices more fully and support continued work with colleagues."]}],"\n    ",["$","p",null,{"children":["The guide provides a structure for building on the initial sharing. Start with the colleague’s learning goal, identify the evidence students should produce, and adapt the task to their class. Then review the digital workflow and participation demands. The colleague selects a support or revises a prompt and explains the reason for that decision. This gives the next conversation a practical focus: making an instructional choice together."]}],"\n    ",["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":["Sharing the project made it available as a professional resource beyond my own classroom. Another educator had access to a concrete example of how a digital assignment can connect student choice with clear academic expectations. The value of the shared materials is that the task, presentation structure, and scoring criteria can be examined together. This makes the relationship between what students do and what they are expected to learn visible."]}],"\n    ",["$","p",null,{"children":["This experience provides an initial connection to ",["$","strong",null,{"children":["4.4.a"]}]," by sharing an authentic learning design that gives students responsibility for a position and its supporting evidence. The project also provides a foundation for ",["$","strong",null,{"children":["4.4.d"]}],": its prompts and rubric make the intended learning visible. The new guide extends those materials with an explicit design model and access options for ",["$","strong",null,{"children":["4.4.c"]}],". My account establishes successful sharing. A colleague’s adaptation or feedback will provide more specific evidence of how the resources influence their practice."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"artifact-two","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Artifact Two"]}],["$","h2",null,{"id":"artifact-two","children":["Digital Assessment and Feedback Toolkit"]}]]}],"\n  ",["$","div",null,{"className":"prose-card","children":["\n    ",["$","h3",null,{"children":["Indicators"]}],["$","p",null,{"children":[["$","strong",null,{"children":["4.4.b and 4.4.d:"]}]," designing a digital check that leads to timely, targeted feedback and demonstrating how the assessment, learning goal, and next instructional step fit together."]}],"\n    ",["$","h3",null,{"children":["Description"]}],["$","p",null,{"children":["This toolkit is a new formative assessment resource for the executive-branch inquiry. It contains a checkpoint students can complete before presenting, criteria for interpreting responses, invented examples for educator practice, and feedback that asks students to make a specific revision. A worked revision illustrates the reasoning expected after feedback. An individual revision record helps the teacher examine each partner’s understanding."]}],"\n    ",["$","p",null,{"children":["The original rubric evaluates the finished presentation. This toolkit serves a different purpose within the lesson: it gives the teacher information while students still have time to use feedback. The questions, feedback criteria, and revision record are publicly available. They can be copied into an approved private digital form or document for classroom use."]}],"\n    ",["$","p",null,{"className":"portfolio-file-links","children":[["$","a",null,{"className":"artifact-link","href":"/artifacts/standard-4-4/assessment-feedback/","children":["Open the checkpoint, worked examples, and feedback toolkit →"]}]]}],"\n    ",["$","figure",null,{"className":"artifact-preview","children":[["$","p",null,{"className":"eyebrow","children":["Inside the assessment toolkit"]}],["$","img",null,{"className":"toolkit-preview","src":"/artifacts/standard-4-4/assessment-feedback/toolkit-preview.svg","width":"840","height":"680","loading":"lazy","alt":"Modeled feedback sequence: a learner counts two links to the same article as two sources. Feedback asks them to count distinct works. The revision recognizes there is one work and identifies the need for a different scholarly source."}],["$","figcaption",null,{"children":["A visual excerpt of the toolkit’s invented practice example. It shows the original response, a targeted comment, and revised reasoning. This is an instructional model, not student work. ",["$","a",null,{"href":"/artifacts/standard-4-4/assessment-feedback/toolkit-preview.svg","children":["Open the full-size preview."]}]]}]]}],"\n    ",["$","h3",null,{"children":["Implementation"]}],["$","p",null,{"children":["I prepared the toolkit on October 20, 2026, to address a design problem in a shared presentation: the finished deck can hide differences in the partners’ understanding, and a final score leaves no opportunity to improve that presentation. The completed resource includes the individual checkpoint, criteria, feedback examples, a suggested schedule, and a revision record. It has not yet been documented in use with an educator or class."]}],"\n    ",["$","p",null,{"children":["In the planned educator session, I model how to interpret one response and choose a priority comment. The colleague practices with a different response and explains their decision. We then choose where the checkpoint fits in their lesson and reserve time for revision. A digital form can organize individual responses for review; document comments can keep feedback beside the relevant explanation. The educator checks the revised reasoning before selecting further support."]}],"\n    ",["$","h3",null,{"children":["Impact"]}],["$","p",null,{"children":[["$","strong",null,{"children":["Educator impact has not yet been documented for this toolkit."]}]," Its contribution to ",["$","strong",null,{"children":["4.4.b"]}]," is a complete assessment-to-feedback sequence with different responses to different learning needs. A factual misunderstanding calls for a source check; an unsupported claim calls for an evidence explanation; a developed argument calls for a stronger rebuttal. The model and educator practice sequence also support my preparation for ",["$","strong",null,{"children":["4.4.d"]}],"."]}],"\n    ",["$","p",null,{"children":["The intended effect is more precise assessment and feedback decisions. I will look for an educator’s revised checkpoint, an independently written feedback comment, and an explanation of the support they selected. An anonymized response and revision can help us examine whether the feedback addressed the learning need. That evidence would connect the resource to a change in educator practice and help me judge the effectiveness of my modeling."]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"reflection","children":["\n  ",["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":["Professional reflection"]}],["$","h2",null,{"id":"reflection","children":["Overall Reflection on Standard 4.4"]}]]}],"\n  ",["$","div",null,{"className":"prose-card portfolio-reflections","children":[["$","p",null,{"children":["Preparing these resources made me look more closely at the difference between designing a useful assignment and helping another teacher design one. A clear template is a starting point. Coaching also requires listening to the educator’s goals, explaining my choices, and checking whether the educator can apply that reasoning. Sharing the original materials gave this work a purpose beyond my own classroom. I see that as a useful first step in supporting another educator. The next step is to build on the exchange through joint adaptation and feedback about how the resources work in practice."]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.a — Meaningful choices and clear expectations"]}],["$","p",null,{"children":["I can design an active task that gives students decisions to make while keeping the content expectations clear. In this project, students select a civic question and position, decide which evidence matters, and defend a recommendation. Accuracy about presidential power and the Constitution remains part of the rubric regardless of the position they choose. That combination gives student choice an academic purpose."]}],["$","p",null,{"children":["Sharing the project is an initial step toward the collaborative work in this indicator. My next step is to adapt the task with a colleague and examine where students have meaningful control over their work. The current project offers choices within a common presentation format. Depending on the colleague’s learning goal, we could consider another product that still requires an accurate explanation, evidence, and a response to a challenge."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.b — Feedback students can use"]}],["$","p",null,{"children":["My strongest evidence here is the connection between a response and the support that follows. The toolkit makes the checkpoint useful by placing it before the presentation and requiring students to revisit their reasoning. It also checks each partner individually. I can explain why these choices improve the assessment design, although I have not yet demonstrated their effectiveness through educator use."]}],["$","p",null,{"children":["My next step is to help a colleague use the sequence in a lesson and review whether the prompt reveals the intended understanding. I will examine the feedback they write and the instructional decision they make. If a response is too vague to interpret, the question needs revision. If a student understands the content but cannot access the response format, the support needs adjustment. The assessment should help the educator distinguish those needs."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.c — Access and active participation"]}],["$","p",null,{"children":["I can identify several barriers in this task and plan specific options for addressing them. A student may understand the civic issue but struggle with a dense article, an unclear sequence of directions, or an oral presentation. The guide separates those demands. Each partner also researches a source, explains a contribution, and completes an individual check, making participation part of the design."]}],["$","p",null,{"children":["My current evidence is strongest in anticipating learner variability. The next step is to review an adapted digital lesson with an educator and test its student workflow: finding directions, opening sources, navigating the materials, receiving feedback, and submitting a response. The educator’s knowledge of the class and learner feedback should guide the revisions. Access options need to work in the actual environment while preserving the learning goal."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["4.4.d — Making design decisions visible"]}],["$","p",null,{"children":["I can explain the instructional design principles behind these resources. Using McTighe and Wiggins’s (2012) backward-design sequence, I begin with the learning goal, identify the evidence students should produce, and plan experiences that prepare them. The slide prompts make parts of the argument visible. The checkpoint then creates an opportunity to improve those parts before the final performance."]}],["$","p",null,{"children":["The shared project provides a concrete example of the relationship between the task and assessment. The new worked prompt revision makes the design reasoning more explicit, and the toolkit adds practice in selecting feedback. Building on that exchange, my next step is to model these decisions with a colleague and ask them to apply the same reasoning to another lesson. Their explanation of how the learning goal shaped the assessment and activities will help me determine whether my modeling was useful."]}]]}],"\n    ",["$","article",null,{"children":[["$","h3",null,{"children":["How I will evaluate the coaching"]}],["$","p",null,{"children":["The sharing experience provides a starting point for follow-up. I plan to retain the agreed goal, the educator’s adapted task or assessment, and a brief account of what changed through our work. Where available, an anonymized feedback-and-revision example will add evidence of how the change functioned in a lesson. These records will help me assess both the educator’s decisions and what I need to improve in my support."]}]]}],"\n  "]}],"\n"]}],"\n",["$","section",null,{"className":"content-section","aria-labelledby":"references","children":[["$","div",null,{"className":"section-heading","children":[["$","h2",null,{"id":"references","children":["References and artifact sources"]}]]}],"\n  ",["$","p",null,{"children":["International Society for Technology in Education. (n.d.). ",["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Standards for Coaches"]}],". Indicator summaries on this page are paraphrased."]}],"\n  ",["$","p",null,{"children":["CAST. (2024). ",["$","a",null,{"href":"https://udlguidelines.cast.org/","children":["Universal Design for Learning Guidelines, version 3.0"]}],". The educator guide applies options for engagement, access to information, and expression to this project."]}],"\n  ",["$","p",null,{"children":["McTighe, J., & Wiggins, G. (2012). ",["$","a",null,{"href":"https://ascd.org/ASCD/pdf/siteASCD/publications/UbD_WhitePaper0312.pdf","children":[["$","em",null,{"children":["Understanding by Design framework"]}]]}],". ASCD. The guide’s goal–evidence–activity sequence applies this planning approach."]}],"\n  ",["$","p",null,{"children":["Original classroom materials: Trevor Arcadipane, ",["$","em",null,{"children":["Executive Branch Debate"]}]," student templates, topic choices, speaking guide, and rubric (October 2026). The ",["$","a",null,{"href":"/artifacts/standard-4-4/executive-branch-design/#original-materials","children":["artifact page"]}]," identifies the original files and separates them from the new educator adaptations."]}],"\n"]}],"\n",["$","nav",null,{"className":"page-pagination","aria-label":"Standard pages","children":[["$","a",null,{"href":"/standards/4-3/","children":["Previous: Collaborator"]}],["$","a",null,{"href":"/standards/4-5/","children":["Next: Professional Learning Facilitator"]}]]}],"\n\n"]}]]}],["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"children":[["$","strong",null,{"children":["Trevor Arcadipane"]}],["$","span",null,{"children":["ISTE Coach Standards Professional Portfolio"]}]]}],["$","div",null,{"className":"footer-links","children":[["$","a",null,{"href":"https://iste.org/standards/coaches","children":["ISTE Coach Standards"]}],["$","a",null,{"href":"https://ed.fullerton.edu/edtech/overview/","children":["CSUF Educational Technology"]}]]}]]}]]}]
